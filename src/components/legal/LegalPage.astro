---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { LegalDocument } from '../../lib/legal';
import { legalLangsOf } from '../../data/apps';
import { t } from '../../lib/i18n';
import { alternatesFor, appPath, legalPath } from '../../lib/routes';
import { absolute, ogImage } from '../../lib/seo';
import { SITE } from '../../data/site';

interface Props {
  doc: LegalDocument;
}

const { doc } = Astro.props;
const { app, kind, lang, entry } = doc;
const { Content } = await render(entry);
const other = kind === 'privacy' ? 'terms' : 'privacy';
const path = legalPath(app, kind, lang);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${absolute(path)}#page`,
  url: absolute(path),
  name: `${app.name} — ${entry.data.title}`,
  description: entry.data.description,
  inLanguage: lang,
  isPartOf: { '@id': `${SITE.origin}/#website` },
  about: { '@id': `${absolute(app.route)}#app` },
};
---

<BaseLayout
  lang={lang}
  title={`${entry.data.title} — ${app.name}`}
  description={entry.data.description}
  path={path}
  alternates={alternatesFor((l) => legalPath(app, kind, l), legalLangsOf(app))}
  ogImage={ogImage(`${app.slug}-${kind}`)}
  ogType="article"
  jsonLd={jsonLd}
  nav={[
    { href: appPath(app, lang), label: app.name },
    {
      href: legalPath(app, 'privacy', lang),
      label: t(lang, 'legal.privacy'),
      current: kind === 'privacy',
    },
    {
      href: legalPath(app, 'terms', lang),
      label: t(lang, 'legal.terms'),
      current: kind === 'terms',
    },
  ]}
  compactFooter
>
  <article class="legal container">
    <a class="legal__back" href={appPath(app, lang)}>
      <ArrowLeft size={16} aria-hidden="true" />
      <Image src={app.icon} alt="" width={28} height={28} densities={[1, 2]} />
      {t(lang, 'legal.backToApp')} {app.name}
    </a>
    <header>
      <h1>{entry.data.title}</h1>
      <p>
        {t(lang, 'legal.updated')}: <time>{entry.data.updated}</time>
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="legal__other">
      <a class="text-link" href={legalPath(app, other, lang)}>
        {t(lang, other === 'privacy' ? 'legal.privacy' : 'legal.terms')}
      </a>
    </p>
  </article>
</BaseLayout>

<style>
  .legal {
    max-width: 760px;
    padding-top: clamp(32px, 5vw, 64px);
  }

  .legal__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 15px;
    font-weight: 600;
  }

  .legal__back:hover {
    color: var(--ink);
  }

  .legal__back img {
    width: 28px;
    height: 28px;
    border-radius: var(--r-icon);
  }

  header {
    margin-top: 32px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }

  h1 {
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  header p {
    margin-top: 12px;
    color: var(--muted);
  }

  .prose {
    font-size: 17px;
    line-height: 1.75;
  }

  .prose :global(h2) {
    margin-top: 40px;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .prose :global(h3) {
    margin-top: 28px;
    font-size: 18px;
    font-weight: 600;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 14px;
    color: color-mix(in srgb, var(--ink) 82%, var(--muted));
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
  }

  .prose :global(li + li) {
    margin-top: 8px;
  }

  .prose :global(strong) {
    color: var(--ink);
  }

  .prose :global(a) {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal__other {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
</style>
