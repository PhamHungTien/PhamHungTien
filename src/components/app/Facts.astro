---
import type { App } from '../../data/types';
import type { Locale } from '../../i18n/locales';
import { getAppCopy } from '../../lib/app-copy';

interface Props {
  app: App;
  lang: Locale;
}

const { app, lang } = Astro.props;
const { facts } = getAppCopy(app, lang);
---

<dl class="facts container" style={`--fact-count: ${facts.length}`}>
  {facts.map((fact) => (
    <div>
      <dt>{fact.label}</dt>
      <dd>{fact.value}</dd>
    </div>
  ))}
</dl>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(18px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--line);
    overflow: hidden;
  }

  div {
    padding: clamp(11px, 1.5vw, 16px) clamp(12px, 1.7vw, 20px);
    background: var(--surface);
  }

  div:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  dt {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.4;
  }

  dd {
    margin-top: 4px;
    font-size: clamp(15px, 1.4vw, 16px);
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  @media (min-width: 760px) {
    .facts {
      grid-template-columns: repeat(var(--fact-count), minmax(0, 1fr));
    }

    div:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }
</style>
