---
import { ExternalLink, Mail } from '@lucide/astro';
import type { App } from '../../data/types';
import type { Locale } from '../../i18n/locales';
import { getAppCopy } from '../../lib/app-copy';
import { SITE } from '../../data/site';
import { t } from '../../lib/i18n';
import { legalPath } from '../../lib/routes';

interface Props {
  app: App;
  lang: Locale;
}

const { app, lang } = Astro.props;
const { features, support } = getAppCopy(app, lang);
---

<section class="features container section" id="features" aria-labelledby="features-heading">
  <div class="section-head">
    <div>
      <h2 id="features-heading">{t(lang, 'app.features')}</h2>
    </div>
  </div>
  <div class="features__layout">
    <ul class="feature-grid" role="list">
      {features.map((feature) => (
        <li class="glass-card">
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </li>
      ))}
    </ul>

    <aside class="support glass glass-panel" aria-labelledby="support-heading">
      <h3 id="support-heading">{t(lang, 'app.support')}</h3>
      <p>{support}</p>
      <div class="support__actions">
        <a
          class="button button--primary"
          href={`mailto:${SITE.email}?subject=${encodeURIComponent(app.name)}`}
        >
          <Mail size={17} aria-hidden="true" />
          {t(lang, 'app.supportCta')}
        </a>
        {app.links.community && (
          <a
            class="button button--secondary"
            href={app.links.community}
            target="_blank"
            rel="noopener noreferrer"
          >
            <ExternalLink size={17} aria-hidden="true" />
            {t(lang, 'app.community')}
          </a>
        )}
      </div>
      <p class="support__legal">
        <a href={legalPath(app, 'privacy', lang)}>{t(lang, 'app.privacy')}</a>
        <a href={legalPath(app, 'terms', lang)}>{t(lang, 'app.terms')}</a>
      </p>
    </aside>
  </div>
</section>

<style>
  .features__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: clamp(14px, 2.4vw, 24px);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(10px, 1.7vw, 16px);
  }

  .feature-grid li {
    padding: clamp(14px, 1.8vw, 22px);
    border: 1px solid var(--glass-edge);
    border-radius: var(--r-card);
  }

  .feature-grid li:first-child {
    --glass-card-highlight: color-mix(
      in srgb,
      var(--app, var(--brand)) 9%,
      var(--glass-card-light)
    );
    grid-column: 1 / -1;
  }
  .feature-grid li:first-child h3 {
    font-size: clamp(17px, 2vw, 20px);
  }
  /* The first feature spans the row; a last one left alone on its row does too. */
  .feature-grid li:last-child:nth-child(even) {
    grid-column: 1 / -1;
  }
  .feature-grid h3 {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
  }

  .feature-grid p {
    margin-top: 5px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }

  .support {
    display: grid;
    gap: 10px;
    padding: clamp(16px, 2.2vw, 26px);
    border: 1px solid var(--glass-edge);
    border-radius: var(--r-card);
  }

  .support h3 {
    font-size: 20px;
    font-weight: 600;
  }

  .support > p {
    color: var(--muted);
    font-size: 15px;
  }

  .support__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .support__actions .button {
    flex: 1 1 170px;
  }

  .support__legal {
    display: flex;
    gap: 12px 20px;
    flex-wrap: wrap;
    margin-top: 2px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }

  .support__legal a {
    color: var(--muted);
  }

  .support__legal a:hover {
    color: var(--ink);
  }

  @media (min-width: 480px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .features__layout {
      grid-template-columns: minmax(0, 1fr) clamp(238px, 25vw, 308px);
    }
  }

  @media (min-width: 960px) and (min-height: 680px) {
    .support {
      position: sticky;
      top: calc(var(--header-height) + 20px);
    }
  }
</style>
