---
/**
 * Top of every app page: the App Store product page header art, then the app's icon,
 * name, promise and download actions. Art comes from src/assets/apps/<slug>/store.
 */
import { Image } from 'astro:assets';
import { ChevronRight, Download, Heart } from '@lucide/astro';
import BrandIcon from '../ui/BrandIcon.astro';
import StoreDownloads from '../ui/StoreDownloads.astro';
import type { App, Lang } from '../../data/types';
import { t } from '../../lib/i18n';
import { homePath, legalPath } from '../../lib/routes';
import { platformGroupsOf } from '../../data/platforms';
import { storeMedia } from '../../lib/store-media';

interface Props {
  app: App;
  lang: Lang | 'zh';
  /** Copy for pages in a language the app data does not carry (Chinese LunarV). */
  copy?: { title: string; subtitle: string; category: string; privacy: string };
}

const { app, lang, copy } = Astro.props;
/** App data is written in English and Vietnamese; other pages pass their own copy. */
const dataLang: Lang = lang === 'zh' ? 'en' : lang;
const title = copy?.title ?? app.title[dataLang];
const subtitle = copy?.subtitle ?? app.subtitle[dataLang];
const category = copy?.category ?? app.category[dataLang];
const header = storeMedia(app.slug, lang).header;

const secondary = app.links.source
  ? { href: app.links.source, label: t(lang, 'app.source'), external: true }
  : {
      href: copy?.privacy ?? legalPath(app, 'privacy', dataLang),
      label: t(lang, 'app.privacy'),
      external: false,
    };
const platforms = platformGroupsOf(app.platforms)
  .map((group) => group.label)
  .join(' · ');
---

<section class="app-hero container" aria-labelledby="app-title">
  <div class="app-hero__bar">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol role="list">
        <li>
          <a href={homePath(lang)}>{t(lang, 'nav.home')}</a>
        </li>
        <li aria-hidden="true">
          <ChevronRight size={14} />
        </li>
        <li>
          <a href={`${homePath(lang)}#apps`}>{t(lang, 'nav.apps')}</a>
        </li>
        <li aria-hidden="true">
          <ChevronRight size={14} />
        </li>
        <li>
          <span aria-current="page">{app.name}</span>
        </li>
      </ol>
    </nav>
  </div>

  {header && (
    <div class="app-hero__banner" style={`--art-ratio: ${header.width} / ${header.height}`}>
      <Image
        src={header}
        alt={`${app.name} — ${title}`}
        format="webp"
        width={Math.min(header.width, 2560)}
        widths={[720, 1200, 1800, 2560].filter((w) => w <= header.width)}
        sizes="(max-width: 1248px) 92vw, 1200px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  )}

  <div class="app-hero__main">
    <Image
      class="app-hero__icon"
      src={app.icon}
      alt={`${app.name} ${t(lang, 'app.icon')}`}
      width={96}
      height={96}
      densities={[1, 2]}
      loading="eager"
      style={`view-transition-name: app-${app.slug}`}
    />
    <div class="app-hero__copy">
      <p class="app-hero__name">
        {app.name}
        <span>{category}</span>
      </p>
      <h1 id="app-title">{title}</h1>
      <p class="app-hero__subtitle">{subtitle}</p>
      <p class="app-hero__platforms">
        <span class="sr-only">
          {lang === 'vi' ? 'Nền tảng: ' : lang === 'zh' ? '平台：' : 'Platforms: '}
        </span>
        {platforms}
      </p>
    </div>

    <div class="app-hero__actions">
      {app.install && (
        <a class="button button--primary" href="#install">
          <Download size={18} aria-hidden="true" />
          {t(lang, 'app.download')}
        </a>
      )}
      <StoreDownloads stores={app.links.stores} lang={lang} openInNewTab />
      <div class="app-hero__links">
        <a
          class="text-link"
          href={secondary.href}
          target={secondary.external ? '_blank' : undefined}
          rel={secondary.external ? 'noopener' : undefined}
        >
          {app.links.source && <BrandIcon name="github" size={16} />}
          {secondary.label}
        </a>
        <button class="link-button" type="button" data-donate aria-haspopup="dialog">
          <Heart size={16} aria-hidden="true" />
          {t(lang, 'donate.open')}
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .app-hero {
    padding-top: clamp(16px, 3vw, 32px);
  }

  .app-hero__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-bottom: 16px;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .breadcrumb a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
  }

  .breadcrumb a:hover {
    color: var(--ink);
  }

  .breadcrumb [aria-current] {
    color: var(--ink);
    font-weight: 500;
  }

  /* The store's own header art as a wide 2.33:1 band, the App Store header proportion.
     Art made in another proportion is cropped around its centre here and shown whole on
     phones (below). */
  .app-hero__banner {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-sheet);
    background: var(--surface-2);
    aspect-ratio: 3840 / 1646;
  }

  .app-hero__banner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .app-hero__main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 16px 24px;
    margin-top: 24px;
  }

  .app-hero__main :global(.app-hero__icon) {
    width: 96px;
    height: 96px;
    border-radius: var(--r-icon);
    box-shadow: var(--shadow-icon);
  }

  .app-hero__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    font-size: 15px;
    font-weight: 600;
  }

  .app-hero__name span {
    color: var(--muted);
    font-weight: 400;
  }

  h1 {
    max-width: 22ch;
    margin-top: 6px;
    font-size: var(--text-display);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .app-hero__subtitle {
    max-width: 60ch;
    margin-top: 10px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.55;
  }

  .app-hero__platforms {
    margin-top: 10px;
    color: var(--muted);
    font-size: 14px;
  }

  .app-hero__actions {
    --store-downloads-align: center;
    display: grid;
    gap: 10px;
    justify-items: stretch;
    min-width: 240px;
  }

  .app-hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 16px;
    font-size: 14px;
  }

  .app-hero__links .text-link {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 960px) {
    .app-hero__main {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .app-hero__actions {
      --store-downloads-align: flex-start;
      grid-column: 1 / -1;
      min-width: 0;
    }

    .app-hero__links {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
  }

  @media (max-width: 767.98px) {
    .app-hero__bar {
      margin-bottom: 12px;
    }

    .app-hero__banner {
      border-radius: var(--r-card);
      aspect-ratio: var(--art-ratio, 3840 / 1646);
    }

    .app-hero__main {
      gap: 12px 14px;
      margin-top: 16px;
    }

    .app-hero__main :global(.app-hero__icon) {
      width: 64px;
      height: 64px;
    }

    .app-hero__subtitle {
      font-size: 15px;
    }

    h1 {
      max-width: none;
    }

    .app-hero__copy {
      display: contents;
    }

    .app-hero__name {
      align-self: center;
      flex-direction: column;
      gap: 0;
    }

    h1,
    .app-hero__subtitle,
    .app-hero__platforms {
      grid-column: 1 / -1;
      margin-top: 0;
    }
  }
</style>
