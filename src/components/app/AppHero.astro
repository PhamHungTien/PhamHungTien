---
import { Image, Picture, getImage } from 'astro:assets';
import { ChevronRight, Download, Heart, Store } from '@lucide/astro';
import BrandIcon from '../ui/BrandIcon.astro';
import PlanetSphere from '../ui/PlanetSphere.astro';
import type { App, Lang } from '../../data/types';
import { t } from '../../lib/i18n';
import { appPath, homePath, legalPath } from '../../lib/routes';
import { storesOf, platformGroupsOf } from '../../data/platforms';

interface Props {
  app: App;
  lang: Lang;
}

const { app, lang } = Astro.props;
const heroAlt = `${app.name} — ${app.title[lang]}`;
const large = await getImage({
  src: app.heroImage,
  width: Math.min(app.heroImage.width, 2000),
  format: 'webp',
});

// Download buttons come from data: the install section for direct downloads, then every store.
const stores = storesOf(app.links.stores);
const buttons = [
  ...(app.install
    ? [{ href: '#install', label: t(lang, 'app.download'), icon: 'download', external: false }]
    : []),
  ...stores.map((store) => ({
    href: store.url,
    label: store.cta[lang],
    icon: store.store === 'appStore' ? 'store' : 'download',
    external: true,
  })),
];
const secondary = app.links.source
  ? { href: app.links.source, label: t(lang, 'app.source'), external: true }
  : { href: legalPath(app, 'privacy', lang), label: t(lang, 'app.privacy'), external: false };
---

<section class="app-hero container" aria-labelledby="app-title">
  <div class="app-hero__copy">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol role="list">
        <li>
          <a href={homePath(lang)}>{t(lang, 'nav.home')}</a>
        </li>
        <li aria-hidden="true">
          <ChevronRight size={14} />
        </li>
        <li>
          <a href={`${homePath(lang)}#apps`}>{t(lang, 'nav.apps')}</a>
        </li>
        <li aria-hidden="true">
          <ChevronRight size={14} />
        </li>
        <li>
          <span aria-current="page">{app.name}</span>
        </li>
      </ol>
    </nav>

    {(app.slug === 'phtv' || app.slug === 'lunarv') && (
      <nav class="language-links" aria-label={lang === 'vi' ? 'Ngôn ngữ trang' : 'Page language'}>
        <a
          href={appPath(app, 'vi')}
          hreflang="vi"
          aria-current={lang === 'vi' ? 'page' : undefined}
        >
          Tiếng Việt
        </a>
        <a
          href={appPath(app, 'en')}
          hreflang="en"
          aria-current={lang === 'en' ? 'page' : undefined}
        >
          English
        </a>
        {app.slug === 'lunarv' && (
          <a href="/zh/LunarV/" hreflang="zh">
            简体中文
          </a>
        )}
      </nav>
    )}
    <div class="lockup">
      <Image
        src={app.icon}
        alt={`${app.name} ${t(lang, 'app.icon')}`}
        width={64}
        height={64}
        densities={[1, 2]}
        loading="eager"
        style={`view-transition-name: app-${app.slug}`}
      />
      <div>
        <p class="lockup__name">{app.name}</p>
        <p class="lockup__category">{app.category[lang]}</p>
      </div>
    </div>

    <div
      class="app-hero__platforms"
      aria-label={lang === 'vi' ? 'Nền tảng hỗ trợ' : 'Available platforms'}
    >
      {platformGroupsOf(app.platforms).map((group) => (
        <span>{group.label}</span>
      ))}
    </div>
    <h1 id="app-title">{app.title[lang]}</h1>
    <p class="app-hero__subtitle">{app.subtitle[lang]}</p>

    <div class="app-hero__actions">
      {buttons.map((button, index) => (
        <a
          class:list={['button', index === 0 ? 'button--primary' : 'button--secondary']}
          href={button.href}
          target={button.external ? '_blank' : undefined}
          rel={button.external ? 'noopener' : undefined}
        >
          {button.icon === 'store' ? (
            <Store size={18} aria-hidden="true" />
          ) : (
            <Download size={18} aria-hidden="true" />
          )}
          {button.label}
        </a>
      ))}
      <a
        class="button button--secondary"
        href={secondary.href}
        target={secondary.external ? '_blank' : undefined}
        rel={secondary.external ? 'noopener' : undefined}
      >
        {app.links.source && <BrandIcon name="github" />}
        {secondary.label}
      </a>
      <button class="link-button" type="button" data-donate aria-haspopup="dialog">
        <Heart size={16} aria-hidden="true" />
        {t(lang, 'donate.open')}
      </button>
    </div>
  </div>

  <div class="app-hero__stage" data-moon-stage>
    <span class="app-hero__moon" data-moon>
      <PlanetSphere slug={app.slug} />
    </span>
    <button
      type="button"
      class="app-hero__media"
      data-tilt
      data-tilt-strength="3"
      data-spotlight
      data-lightbox-src={large.src}
      data-lightbox-alt={heroAlt}
      aria-label={`${t(lang, 'app.enlarge')}: ${heroAlt}`}
    >
      <Picture
        src={app.heroImage}
        alt={heroAlt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1600].filter((w) => w <= app.heroImage.width)}
        sizes="(max-width: 960px) 92vw, 620px"
        loading="eager"
        fetchpriority="high"
      />
      <span class="app-hero__caption">
        {lang === 'vi'
          ? 'Khám phá giao diện · Nhấn để phóng to'
          : 'A closer look · Click to enlarge'}
      </span>
    </button>
  </div>
</section>

<script>
  import { initAppMoon } from '../../scripts/app-moon';
  initAppMoon();
</script>

<style>
  .app-hero {
    --app-soft: color-mix(in srgb, var(--app, var(--brand)) 14%, var(--surface-2));
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(32px, 6vw, 88px);
    padding-top: clamp(32px, 5vw, 72px);
  }

  /* The page takes on the app's own colour: a soft glow behind the media. */
  .app-hero::before {
    position: absolute;
    z-index: -1;
    inset: -140px -14% -60px 38%;
    background:
      radial-gradient(
        42% 48% at 58% 46%,
        color-mix(in srgb, var(--app, var(--brand)) 24%, transparent),
        transparent 72%
      ),
      radial-gradient(
        26% 30% at 84% 18%,
        color-mix(in srgb, var(--gold) 16%, transparent),
        transparent 70%
      );
    content: '';
    pointer-events: none;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-bottom: 32px;
    color: var(--muted);
    font-size: 14px;
  }

  .breadcrumb a:hover {
    color: var(--ink);
  }

  .breadcrumb [aria-current] {
    color: var(--ink);
    font-weight: 600;
  }

  .language-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: -12px 0 22px;
  }
  .language-links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    color: var(--muted);
    border: 1px solid var(--line);
    font-size: 13px;
    font-weight: 600;
  }
  .language-links a[aria-current='page'] {
    color: var(--ink);
    background: var(--surface-2);
    border-color: var(--line-strong);
  }
  .lockup {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .lockup img {
    width: 64px;
    height: 64px;
    border-radius: var(--r-icon);
    box-shadow: var(--shadow-icon);
  }

  .lockup__name {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }

  .lockup__category {
    color: var(--muted);
    font-size: 15px;
  }

  h1 {
    margin-top: 20px;
    font-size: clamp(34px, 4.4vw, 56px);
    text-wrap: balance;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .app-hero__platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  .app-hero__platforms span {
    padding: 5px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 12px;
    background: var(--surface);
  }
  .app-hero__caption {
    margin-top: 16px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }
  .app-hero__subtitle {
    max-width: 32em;
    margin-top: 18px;
    color: var(--muted);
    font-size: 18px;
  }

  .app-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-top: 32px;
  }

  /* The app's planet circles the screenshot, behind it and in front of it. */
  .app-hero__stage {
    position: relative;
    isolation: isolate;
  }
  .app-hero__moon {
    --sphere-size: clamp(48px, 6vw, 84px);
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 3;
    pointer-events: none;
    transform: translate(28vw, -16vw) translate(-50%, -50%);
    filter: brightness(calc(0.82 + (var(--depth, 1) + 1) * 0.09));
    will-change: transform;
  }
  .app-hero__stage:not([data-moon]) .app-hero__moon {
    display: none;
  }
  .app-hero__media {
    position: relative;
    z-index: 1;
    display: grid;
    width: 100%;
    place-items: center;
    padding: clamp(12px, 2vw, 22px);
    border: 1px solid color-mix(in srgb, var(--app, var(--brand)) 18%, var(--line));
    border-radius: var(--r-media);
    background:
      radial-gradient(120% 90% at 50% 0%, var(--surface) 0%, transparent 70%), var(--app-soft);
    box-shadow:
      var(--shadow-media),
      0 40px 80px -50px color-mix(in srgb, var(--app) 50%, transparent);
    cursor: zoom-in;
    transform: perspective(1400px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: transform 600ms var(--ease);
  }

  .app-hero__media:hover {
    transition-duration: 160ms;
  }

  .app-hero__media :global(picture) {
    display: grid;
    width: 100%;
    place-items: center;
  }

  /* Retain the entire image and round its actual edges. */
  .app-hero__media :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: min(600px, 66vh);
    border-radius: var(--r-image);
    object-fit: contain;
  }

  @media (max-width: 960px) {
    .app-hero::before {
      inset: 45% -10% -40px;
    }
    .app-hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .app-hero__moon {
      --sphere-size: 44px;
    }
    .app-hero__actions .button {
      flex: 1 1 auto;
    }
  }

  /* Entrance: copy settles in line by line and the hero image rises into place. The icon
     is left alone: it already glides in from the app list as a view transition. */
  @media (prefers-reduced-motion: no-preference) {
    h1,
    .app-hero__subtitle,
    .app-hero__actions {
      animation: app-hero-in 860ms var(--ease) both;
    }

    .app-hero__platforms {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 24px;
    }
    .app-hero__platforms span {
      padding: 5px 10px;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--muted);
      font-size: 12px;
      background: var(--surface);
    }
    .app-hero__caption {
      margin-top: 16px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.5;
    }
    .app-hero__subtitle {
      animation-delay: 80ms;
    }

    .app-hero__actions {
      animation-delay: 160ms;
    }

    .app-hero__media {
      animation: app-media-in 1100ms var(--ease) 120ms backwards;
    }

    @keyframes app-hero-in {
      from {
        opacity: 1;
        transform: translateY(20px);
      }
    }

    @keyframes app-media-in {
      from {
        opacity: 0.01;
        transform: translateY(36px) scale(0.97);
      }
    }
  }
</style>
