---
/**
 * Top of every app page: the App Store product page header art, then the app's icon,
 * name, promise and download actions. Art comes from src/assets/apps/<slug>/store.
 */
import { Image } from 'astro:assets';
import { ChevronRight, Download, Heart } from '@lucide/astro';
import BrandIcon from '../ui/BrandIcon.astro';
import StoreDownloads from '../ui/StoreDownloads.astro';
import type { App } from '../../data/types';
import type { Locale } from '../../i18n/locales';
import { getAppCopy } from '../../lib/app-copy';
import { t } from '../../lib/i18n';
import { homePath, legalPath } from '../../lib/routes';
import { platformGroupsOf } from '../../data/platforms';
import { storeMedia } from '../../lib/store-media';

interface Props {
  app: App;
  lang: Locale;
}

const { app, lang } = Astro.props;
const { title, subtitle, category } = getAppCopy(app, lang);
const header = storeMedia(app.slug, lang).header;

const secondary = app.links.source
  ? { href: app.links.source, label: t(lang, 'app.source'), external: true }
  : {
      href: legalPath(app, 'privacy', lang),
      label: t(lang, 'app.privacy'),
      external: false,
    };
const platforms = platformGroupsOf(app.platforms)
  .map((group) => group.label)
  .join(' · ');
---

<section
  class:list={['app-hero', 'container', { 'app-hero--with-art': header }]}
  aria-labelledby="app-title"
>
  <div class="app-hero__bar">
    <nav class="breadcrumb" aria-label={t(lang, 'nav.breadcrumb')}>
      <ol role="list">
        <li>
          <a href={homePath(lang)}>{t(lang, 'nav.home')}</a>
        </li>
        <li aria-hidden="true">
          <ChevronRight size={14} />
        </li>
        <li>
          <a href={`${homePath(lang)}#apps`}>{t(lang, 'nav.apps')}</a>
        </li>
        <li aria-hidden="true">
          <ChevronRight size={14} />
        </li>
        <li>
          <span aria-current="page">{app.name}</span>
        </li>
      </ol>
    </nav>
  </div>

  {header && (
    <div class="app-hero__banner" style={`--art-ratio: ${header.width} / ${header.height}`}>
      <Image
        src={header}
        alt={`${app.name} — ${title}`}
        format="webp"
        width={Math.min(header.width, 2560)}
        widths={[480, 720, 1200, 1800, 2560].filter((w) => w <= header.width)}
        sizes="(min-width: 1300px) 620px, (min-width: 840px) 48vw, 92vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  )}

  <div class="app-hero__main">
    <Image
      class="app-hero__icon"
      src={app.icon}
      alt={`${app.name} ${t(lang, 'app.icon')}`}
      width={96}
      height={96}
      densities={[1, 2]}
      loading="eager"
      style={`view-transition-name: app-${app.slug}`}
    />
    <div class="app-hero__copy">
      <p class="app-hero__name">
        {app.name}
        <span>{category}</span>
      </p>
      <h1 id="app-title">{title}</h1>
      <p class="app-hero__subtitle">{subtitle}</p>
      <p class="app-hero__platforms">
        <span class="sr-only">{t(lang, 'app.platforms')} </span>
        {platforms}
      </p>
    </div>

    <div class="app-hero__actions">
      {app.install && (
        <a class="button button--primary" href="#install">
          <Download size={18} aria-hidden="true" />
          {t(lang, 'app.download')}
        </a>
      )}
      <StoreDownloads stores={app.links.stores} lang={lang} openInNewTab />
      <div class="app-hero__links">
        <a
          class="text-link"
          href={secondary.href}
          target={secondary.external ? '_blank' : undefined}
          rel={secondary.external ? 'noopener' : undefined}
        >
          {app.links.source && <BrandIcon name="github" size={16} />}
          {secondary.label}
        </a>
        <button class="link-button" type="button" data-donate aria-haspopup="dialog">
          <Heart size={16} aria-hidden="true" />
          {t(lang, 'donate.open')}
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .app-hero {
    display: grid;
    gap: clamp(10px, 2vw, 22px);
    padding-top: clamp(12px, 2vw, 24px);
  }

  .app-hero__bar {
    grid-column: 1 / -1;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .breadcrumb a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
  }

  .breadcrumb a:hover {
    color: var(--ink);
  }

  .breadcrumb [aria-current] {
    color: var(--ink);
    font-weight: 500;
  }

  .app-hero__banner {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: clamp(var(--r-card), 3vw, var(--r-sheet));
    background: var(--surface-2);
    aspect-ratio: var(--art-ratio);
  }

  .app-hero__banner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .app-hero__main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: center;
    gap: clamp(8px, 1.2vw, 14px) clamp(12px, 2vw, 20px);
    min-width: 0;
  }

  .app-hero__main :global(.app-hero__icon) {
    width: clamp(56px, 7vw, 80px);
    height: clamp(56px, 7vw, 80px);
    border-radius: var(--r-icon);
    box-shadow: var(--shadow-icon);
  }

  .app-hero__copy {
    display: contents;
  }

  .app-hero__name {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    font-size: 15px;
    font-weight: 600;
  }

  .app-hero__name span {
    color: var(--muted);
    font-weight: 400;
  }

  h1 {
    grid-column: 1 / -1;
    max-width: 26ch;
    font-size: var(--text-display);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .app-hero__subtitle {
    grid-column: 1 / -1;
    max-width: 60ch;
    color: var(--muted);
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.5;
  }

  .app-hero__platforms {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: 14px;
  }

  .app-hero__actions {
    display: grid;
    grid-column: 1 / -1;
    gap: 4px;
    justify-items: start;
    min-width: 0;
  }

  .app-hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
    font-size: 14px;
  }

  .app-hero__links a,
  .app-hero__links button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 6px;
  }

  @media (min-width: 840px) {
    .app-hero--with-art {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      align-items: center;
      column-gap: clamp(24px, 3.2vw, 42px);
    }
  }
</style>
