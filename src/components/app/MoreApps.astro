---
import { Image } from 'astro:assets';
import UtilityAction from '../ui/UtilityAction.astro';
import type { App } from '../../data/types';
import type { Locale } from '../../i18n/locales';
import { getAppCopy } from '../../lib/app-copy';
import { apps } from '../../data/apps';
import { t } from '../../lib/i18n';
import { appPath, homePath } from '../../lib/routes';

interface Props {
  app: App;
  lang: Locale;
}

const { app, lang } = Astro.props;
const others = apps.filter((other) => other.slug !== app.slug);
---

<section class="more container section" aria-labelledby="more-heading">
  <div class="section-head">
    <h2 id="more-heading">{t(lang, 'app.more')}</h2>
    <UtilityAction kind="catalog" href={`${homePath(lang)}#apps`} label={t(lang, 'nav.allApps')} />
  </div>
  <ul class="more__list" role="list">
    {others.map((other) => (
      <li>
        <a class="glass-card" style={`--app: ${other.accent}`} href={appPath(other, lang)}>
          <Image
            src={other.icon}
            alt=""
            width={56}
            height={56}
            densities={[1, 2]}
            loading="lazy"
            style={`view-transition-name: app-${other.slug}`}
          />
          <span>
            <strong>{other.name}</strong>
            <small>{getAppCopy(other, lang).category}</small>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .more__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(8px, 1.5vw, 14px);
  }

  .more__list a {
    display: flex;
    align-items: center;
    height: 100%;
    gap: clamp(8px, 1.4vw, 14px);
    padding: clamp(10px, 1.6vw, 16px);
    border: 1px solid var(--glass-edge);
    border-radius: var(--r-card);
    transition: border-color 160ms ease;
  }

  .more__list a:hover {
    border-color: var(--line-strong);
  }

  .more__list img {
    flex: none;
    width: clamp(34px, 5vw, 52px);
    height: clamp(34px, 5vw, 52px);
    border-radius: var(--r-icon);
  }

  .more__list span {
    display: grid;
    gap: 2px;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  strong {
    font-size: clamp(14px, 1.5vw, 16px);
    font-weight: 600;
  }

  small {
    color: var(--muted);
    font-size: clamp(12px, 1.4vw, 14px);
    line-height: 1.4;
  }

  @media (max-width: 415px) {
    .more__list a {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (min-width: 690px) {
    .more__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
