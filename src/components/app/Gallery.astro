---
import { Picture, getImage } from 'astro:assets';
import type { App, Lang } from '../../data/types';
import { t } from '../../lib/i18n';

interface Props {
  app: App;
  lang: Lang;
}

const { app, lang } = Astro.props;
const images = await Promise.all(
  app.gallery.map(async (image) => {
    const src = image.localizedSrc?.[lang] ?? image.src;
    const large = await getImage({ src, width: Math.min(src.width, 2000), format: 'webp' });
    return { src, alt: image.alt[lang], large: large.src, ratio: src.width / src.height };
  }),
);
---

<section
  class="gallery container section defer-render"
  id="gallery"
  aria-labelledby="gallery-heading"
>
  <div class="section-head">
    <div>
      <span class="section-kicker">{lang === 'vi' ? 'Bên trong ứng dụng' : 'Inside the app'}</span>
      <h2 id="gallery-heading">{t(lang, 'app.screenshots')}</h2>
      <p>
        {lang === 'vi'
          ? 'Vuốt để xem thêm. Chọn ảnh để phóng to.'
          : 'Scroll to explore. Select an image for a closer look.'}
      </p>
    </div>
  </div>
  <ul class="gallery__strip" role="list" data-reveal-stagger>
    {images.map((image) => (
      <li style={`--ratio: ${image.ratio.toFixed(4)}`}>
        <figure>
          <button
            type="button"
            class="gallery__preview"
            data-lightbox-src={image.large}
            data-lightbox-alt={image.alt}
            aria-label={`${t(lang, 'app.enlarge')}: ${image.alt}`}
          >
            <Picture
              src={image.src}
              alt={image.alt}
              formats={['avif', 'webp']}
              widths={[320, 480, 760, 1200].filter((w) => w <= image.src.width)}
              sizes={`(max-width: 560px) ${Math.round(Math.min(90, (400 * image.ratio) / 3.9))}vw, ${Math.round(Math.min(1000, 500 * image.ratio))}px`}
              loading="lazy"
            />
          </button>
          <figcaption>{image.alt}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Each screenshot keeps its own shape: cards share a height and take the width their
     image needs, so landscape iPad shots are not shrunk into portrait boxes. */
  .gallery {
    --shot-h: clamp(340px, 40vw, 500px);
  }

  .gallery__strip {
    display: flex;
    gap: 20px;
    margin-inline: calc(-1 * var(--gutter));
    padding: 4px var(--gutter) 20px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: var(--gutter);
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }

  .gallery__strip li {
    --h: min(var(--shot-h), calc((86vw - 24px) / var(--ratio)));
    flex: none;
    width: calc(var(--h) * var(--ratio) + 24px);
    scroll-snap-align: start;
  }

  .gallery__preview {
    display: grid;
    width: 100%;
    height: calc(var(--h) + 24px);
    place-items: center;
    padding: 12px;
    border: 1px solid color-mix(in srgb, var(--app, var(--brand)) 14%, var(--line));
    border-radius: var(--r-card);
    background: color-mix(in srgb, var(--app, var(--brand)) 8%, var(--surface-2));
    cursor: zoom-in;
    transition:
      transform 420ms var(--spring),
      box-shadow 420ms var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .gallery__preview:hover {
      box-shadow: var(--shadow-media);
      transform: translateY(-4px);
    }
  }

  .gallery__preview:active {
    transform: scale(0.98);
  }

  .gallery__preview :global(picture),
  .gallery__preview :global(img) {
    display: block;
    max-width: 100%;
    max-height: 100%;
  }

  .gallery__preview :global(img) {
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
  }

  figcaption {
    max-width: 44ch;
    margin-top: 12px;
    color: var(--muted);
    font-size: 14px;
  }

  @media (max-width: 560px) {
    .gallery {
      --shot-h: 400px;
    }
  }
</style>
