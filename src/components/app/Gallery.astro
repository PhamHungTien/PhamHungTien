---
import { Picture, getImage } from 'astro:assets';
import type { App, Lang } from '../../data/types';
import { t } from '../../lib/i18n';

interface Props {
  app: App;
  lang: Lang;
}

const { app, lang } = Astro.props;
const images = await Promise.all(
  app.gallery.map(async (image) => {
    const src = image.localizedSrc?.[lang] ?? image.src;
    const large = await getImage({ src, width: Math.min(src.width, 2000), format: 'webp' });
    return { src, alt: image.alt[lang], large: large.src };
  }),
);
---

<section
  class="gallery container section defer-render"
  id="gallery"
  aria-labelledby="gallery-heading"
>
  <div class="section-head">
    <h2 id="gallery-heading">{t(lang, 'app.screenshots')}</h2>
  </div>
  <ul class="gallery__strip" role="list" data-reveal-stagger>
    {images.map((image) => (
      <li>
        <figure>
          <button
            type="button"
            class="gallery__preview"
            data-lightbox-src={image.large}
            data-lightbox-alt={image.alt}
            aria-label={`${t(lang, 'app.enlarge')}: ${image.alt}`}
          >
            <Picture
              src={image.src}
              alt={image.alt}
              formats={['avif', 'webp']}
              widths={[320, 480, 760].filter((w) => w <= image.src.width)}
              sizes="(max-width: 700px) 78vw, 380px"
              loading="lazy"
            />
          </button>
          <figcaption>{image.alt}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
</section>

<style>
  .gallery__strip {
    display: grid;
    grid-auto-columns: minmax(260px, 380px);
    grid-auto-flow: column;
    gap: 20px;
    margin-inline: calc(-1 * var(--gutter));
    padding: 4px var(--gutter) 20px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: var(--gutter);
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }

  .gallery__strip li {
    scroll-snap-align: start;
  }

  .gallery__preview {
    display: grid;
    width: 100%;
    height: clamp(320px, 42vw, 520px);
    place-items: center;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface-2);
    cursor: zoom-in;
  }

  .gallery__preview :global(picture),
  .gallery__preview :global(img) {
    display: block;
    max-height: 100%;
  }

  .gallery__preview :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    object-fit: contain;
    border-radius: 10px;
  }

  figcaption {
    margin-top: 12px;
    color: var(--muted);
    font-size: 14px;
  }

  @media (max-width: 560px) {
    .gallery__preview {
      height: 420px;
    }
  }
</style>
