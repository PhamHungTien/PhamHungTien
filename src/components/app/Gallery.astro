---
import { Picture, getImage } from 'astro:assets';
import type { App, Lang } from '../../data/types';
import { t } from '../../lib/i18n';

interface Props {
  app: App;
  lang: Lang | 'zh';
}

const { app, lang } = Astro.props;
const images = await Promise.all(
  app.gallery.map(async (image, index) => {
    const contentLang = lang === 'zh' ? 'en' : lang;
    const src = image.localizedSrc?.[contentLang] ?? image.src;
    const large = await getImage({ src, width: Math.min(src.width, 2000), format: 'webp' });
    const alt =
      lang === 'zh'
        ? `${index < 3 ? 'iPad' : index < 6 ? 'iPhone' : 'Mac'} 界面 · ${index < 3 ? index + 1 : index < 6 ? index - 2 : 1}`
        : image.alt[contentLang];
    return { src, alt, large: large.src, ratio: src.width / src.height };
  }),
);
---

<section
  class="gallery container section defer-render"
  id="gallery"
  aria-labelledby="gallery-heading"
>
  <div class="section-head">
    <div>
      <span class="section-kicker">
        {lang === 'vi' ? 'Bên trong ứng dụng' : lang === 'zh' ? '探索应用' : 'Inside the app'}
      </span>
      <h2 id="gallery-heading">{t(lang, 'app.screenshots')}</h2>
      <p>
        {lang === 'vi'
          ? 'Chọn ảnh để phóng to.'
          : lang === 'zh'
            ? '选择图片可放大。'
            : 'Select an image for a closer look.'}
      </p>
    </div>
  </div>
  <ul class="gallery__grid" role="list" data-reveal-stagger>
    {images.map((image) => (
      <li class:list={{ 'gallery__item--wide': image.ratio >= 1.15 }}>
        <figure>
          <button
            type="button"
            class="gallery__preview"
            data-lightbox-src={image.large}
            data-lightbox-alt={image.alt}
            aria-label={`${t(lang, 'app.enlarge')}: ${image.alt}`}
          >
            <Picture
              src={image.src}
              alt={image.alt}
              formats={['avif', 'webp']}
              widths={[320, 480, 760, 1200].filter((w) => w <= image.src.width)}
              sizes={
                image.ratio >= 1.15
                  ? '(max-width: 720px) 92vw, 560px'
                  : '(max-width: 720px) 45vw, 280px'
              }
              loading="lazy"
            />
          </button>
          <figcaption>{image.alt}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Landscape shots span two columns; portraits pair naturally on small screens. */
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: start;
    gap: clamp(16px, 2vw, 24px);
  }
  .gallery__grid li {
    min-width: 0;
  }
  .gallery__item--wide {
    grid-column: span 2;
  }
  @media (max-width: 720px) {
    .gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .gallery__preview {
    display: grid;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    place-items: center;
    padding: 12px;
    border: 1px solid color-mix(in srgb, var(--app, var(--brand)) 14%, var(--line));
    border-radius: var(--r-card);
    background: color-mix(in srgb, var(--app, var(--brand)) 8%, var(--surface-2));
    cursor: zoom-in;
    transition:
      transform 420ms var(--spring),
      box-shadow 420ms var(--ease);
  }

  .gallery__item--wide .gallery__preview {
    aspect-ratio: 16 / 10;
  }

  @media (hover: hover) and (pointer: fine) {
    .gallery__preview:hover {
      box-shadow: var(--shadow-media);
      transform: translateY(-4px);
    }
  }

  .gallery__preview:active {
    transform: scale(0.98);
  }

  .gallery__preview :global(picture) {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
  }
  .gallery__preview :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 12px;
  }

  figcaption {
    max-width: 44ch;
    margin-top: 12px;
    color: var(--muted);
    font-size: 14px;
  }
</style>
