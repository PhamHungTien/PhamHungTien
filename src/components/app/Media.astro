---
/** The app's YouTube tutorial; YouTube loads only on click. App Previews live in StoreGallery. */
import { ExternalLink, Video } from '@lucide/astro';
import YouTube from '../ui/YouTube.astro';
import type { App } from '../../data/types';
import type { Locale } from '../../i18n/locales';
import { getAppCopy } from '../../lib/app-copy';
import { t } from '../../lib/i18n';

interface Props {
  app: App;
  lang: Locale;
}

const { app, lang } = Astro.props;
const { tutorial } = getAppCopy(app, lang);
const youtubeId = app.tutorial?.youtubeId;
---

{tutorial && youtubeId && (
  <section
    class="video container section defer-render"
    id="tutorial"
    aria-labelledby="tutorial-heading"
  >
    <div class="section-head">
      <div>
        <h2 id="tutorial-heading">{tutorial.title}</h2>
        <p>{tutorial.description}</p>
      </div>
    </div>
    <div class="video__frame">
      <YouTube id={youtubeId} title={tutorial.title} lang={lang} />
    </div>
    <div class="video__meta">
      {tutorial.credit && (
        <span>
          <Video size={16} aria-hidden="true" />
          {tutorial.credit}
        </span>
      )}
      <a
        class="text-link"
        href={`https://youtu.be/${youtubeId}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t(lang, 'app.tutorial.youtube')}
        <ExternalLink size={14} aria-hidden="true" />
      </a>
    </div>
  </section>
)}

<style>
  .video .section-head {
    margin-bottom: clamp(12px, 1.8vw, 20px);
  }

  .video__frame {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-media);
    background: #000;
    box-shadow: var(--shadow-media);
  }

  .video__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    margin-top: 8px;
    color: var(--muted);
    font-size: 14px;
  }

  .video__meta span,
  .video__meta a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .video__meta a {
    min-height: 44px;
  }

  @media (min-width: 980px) {
    .video {
      display: grid;
      grid-template-columns: minmax(0, 0.46fr) minmax(0, 1fr);
      grid-template-areas: 'heading player' 'meta player';
      grid-template-rows: auto 1fr;
      align-items: start;
      gap: 6px clamp(24px, 3vw, 40px);
    }

    .video .section-head {
      grid-area: heading;
      margin-bottom: 0;
    }

    .video__frame {
      grid-area: player;
    }

    .video__meta {
      grid-area: meta;
      justify-content: flex-start;
    }
  }
</style>
