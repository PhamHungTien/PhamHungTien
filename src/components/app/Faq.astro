---
import { Plus } from '@lucide/astro';
import type { App, Lang } from '../../data/types';
import { t } from '../../lib/i18n';

interface Props {
  app: App;
  lang: Lang;
}

const { app, lang } = Astro.props;
const parts = (text: string) =>
  text
    .split(/(`[^`]+`)/g)
    .map((part) => (part.startsWith('`') ? { code: part.slice(1, -1) } : { text: part }));
---

{app.faq?.length && (
  <section class="faq container section defer-render" id="faq" aria-labelledby="faq-heading">
    <div class="section-head">
      <div>
        <span class="section-kicker">{lang === 'vi' ? 'Thông tin cần biết' : 'Good to know'}</span>
        <h2 id="faq-heading">{t(lang, 'app.faq')}</h2>
      </div>
    </div>
    <div class="faq__list" data-reveal-stagger>
      {app.faq.map((item) => (
        <details name="faq">
          <summary>
            <span>{item.question[lang]}</span>
            <Plus size={20} aria-hidden="true" />
          </summary>
          <p>
            {parts(item.answer[lang]).map((part) =>
              'code' in part ? <code>{part.code}</code> : part.text,
            )}
          </p>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.35fr);
    gap: 48px;
    align-items: start;
  }
  .faq > .section-head {
    margin-bottom: 0;
  }
  @media (max-width: 900px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
  .faq__list {
    max-width: 860px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
    padding-inline: clamp(18px, 3vw, 28px);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  details:last-child {
    border-bottom: 0;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 0;
    font-size: 17px;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(svg) {
    flex-shrink: 0;
    color: var(--muted);
    transition: transform 200ms var(--ease);
  }

  details[open] summary :global(svg) {
    transform: rotate(45deg);
  }

  p {
    max-width: 70ch;
    padding-bottom: 22px;
    color: var(--muted);
  }

  code {
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--ink);
  }
</style>
