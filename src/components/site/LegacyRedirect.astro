---
/** Static-host redirect: preserve incoming search parameters and section anchors. */
import { absolute } from '../../lib/seo';
interface Props {
  to: string;
}
const { to } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={absolute(to)} />
    <title>Page moved — Phạm Hùng Tiến</title>
    <script is:inline define:vars={{ target: to }}>
      location.replace(target + location.search + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0;url=${to}`} />
  </head>
  <body>
    <p>
      This page has moved. <a href={to}>Continue to the page</a>.
    </p>
  </body>
</html>
