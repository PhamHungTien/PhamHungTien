---
/** One shared full-screen image viewer, opened by any element with data-lightbox-src. */
import { X } from '@lucide/astro';
import type { Locale as Lang } from '../../i18n/locales';
import { t } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<dialog class="lightbox dialog--fullscreen" data-lightbox aria-label="">
  <form method="dialog">
    <button class="lightbox__close" aria-label={t(lang, 'app.close')}>
      <X size={24} aria-hidden="true" />
    </button>
  </form>
  <figure>
    <img alt="" decoding="async" data-lightbox-image />
    <figcaption data-lightbox-caption></figcaption>
  </figure>
</dialog>

<script>
  import { enhanceDialog } from '../../scripts/dialog';

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const caption = dialog?.querySelector<HTMLElement>('[data-lightbox-caption]');
  if (dialog && image && caption) {
    const controller = enhanceDialog(dialog);
    document.addEventListener('click', (event) => {
      const trigger = (event.target as Element).closest<HTMLElement>('[data-lightbox-src]');
      if (!trigger) return;
      image.src = trigger.dataset.lightboxSrc ?? '';
      image.alt = trigger.dataset.lightboxAlt ?? '';
      caption.textContent = trigger.dataset.lightboxAlt ?? '';
      dialog.setAttribute('aria-label', trigger.dataset.lightboxAlt ?? '');
      controller.open(trigger);
    });
    dialog.addEventListener('close', () => image.removeAttribute('src'));
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 64px 24px 28px;
    border: 0;
    background: rgb(8 10 15 / 0.94);
    color: #fff;
    cursor: zoom-out;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox__close {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 12px;
    background: rgb(255 255 255 / 0.1);
    color: #fff;
  }

  .lightbox__close:hover {
    background: rgb(255 255 255 / 0.2);
  }

  figure {
    display: grid;
    max-width: 94vw;
    justify-items: center;
    gap: 14px;
  }

  img {
    max-width: 100%;
    max-height: 82dvh;
    width: auto;
    object-fit: contain;
    border-radius: 14px;
  }

  figcaption {
    color: #cbd2dd;
    font-size: 14px;
    text-align: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] figure {
      animation: zoom-in 240ms var(--ease);
    }

    @keyframes zoom-in {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
    }
  }
</style>
