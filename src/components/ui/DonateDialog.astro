---
import { Image } from 'astro:assets';
import { ArrowUpRight, Download, Heart, X } from '@lucide/astro';
import qr from '../../assets/donate-qr.jpg';
import type { Locale as Lang } from '../../i18n/locales';
import { SITE } from '../../data/site';
import { t } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<dialog
  class="donate dialog-sheet glass glass-panel"
  aria-labelledby="donate-title"
  aria-describedby="donate-description"
  data-donate-dialog
  data-lens
>
  <form method="dialog">
    <button class="donate__close dialog-close" aria-label={t(lang, 'app.close')}>
      <X size={20} aria-hidden="true" />
    </button>
  </form>
  <span class="donate__symbol" aria-hidden="true">
    <Heart size={22} />
  </span>
  <h2 id="donate-title">{t(lang, 'donate.title')}</h2>
  <p id="donate-description">{t(lang, 'donate.description')}</p>
  <figure class="donate__qr">
    <Image
      src={qr}
      width={280}
      height={280}
      densities={[1, 2]}
      alt={`VietQR · ${SITE.name}`}
      loading="lazy"
    />
    <figcaption>{t(lang, 'donate.scan')}</figcaption>
  </figure>
  <div class="donate__actions">
    <a class="button button--secondary" href={qr.src} download="pham-hung-tien-vietqr.jpg">
      <Download size={16} aria-hidden="true" />
      {t(lang, 'donate.save')}
    </a>
    <a class="button button--primary" href={SITE.paypal} target="_blank" rel="noopener noreferrer">
      {t(lang, 'donate.paypal')}
      <ArrowUpRight size={18} aria-hidden="true" />
    </a>
  </div>
  <p class="donate__note">{t(lang, 'donate.note')}</p>
</dialog>

<script>
  import { enhanceDialog } from '../../scripts/dialog';

  const dialog = document.querySelector<HTMLDialogElement>('[data-donate-dialog]');
  if (dialog) {
    const controller = enhanceDialog(dialog);
    document.addEventListener('click', (event) => {
      const trigger = (event.target as Element).closest<HTMLElement>('[data-donate]');
      if (!trigger) return;
      event.preventDefault();
      controller.open(trigger);
    });
    if (location.hash === '#donate') controller.open();
  }
</script>

<style>
  .donate {
    container-type: inline-size;
    text-align: center;
  }

  .donate__close {
    position: absolute;
    top: 12px;
    right: 12px;
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    color: var(--muted);
  }

  .donate__close:hover {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    color: var(--ink);
  }

  .donate__symbol {
    display: grid;
    width: 44px;
    height: 44px;
    margin: 0 auto 14px;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--brand) 12%, transparent);
    color: var(--brand);
  }

  h2 {
    font-size: 24px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  p {
    max-width: 32ch;
    margin: 8px auto 0;
    color: var(--muted);
    font-size: 15px;
  }

  .donate__qr {
    width: min(260px, 100%, max(160px, 45dvh));
    margin: clamp(12px, 3dvh, 22px) auto 12px;
  }

  .donate__qr img {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: #fff;
  }

  figcaption {
    margin-top: 12px;
    color: var(--muted);
    font-size: 13px;
  }

  .donate__actions {
    display: grid;
    gap: 8px;
    margin-top: 16px;
  }

  .donate__actions .button {
    min-inline-size: 0;
    padding: 6px 12px;
    overflow-wrap: anywhere;
  }

  .donate__actions .button :global(svg) {
    flex: none;
  }

  @container (width >= 275px) {
    .donate__actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .donate__note {
    margin-top: 16px;
    font-size: 13px;
  }
</style>
