---
/** The brand mark: "T" for Tiến, its crossbar an app tile. Source: src/assets/brand/logo.svg. */
interface Props {
  size?: number;
  class?: string;
}

const { size = 34, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  <rect width="64" height="64" rx="15" fill="#7a1424"></rect>
  <rect x="27.5" y="22" width="9" height="28" rx="4.5" fill="#fff"></rect>
  <rect x="14" y="13" width="36" height="14" rx="7" fill="#f0c04e"></rect>
</svg>
