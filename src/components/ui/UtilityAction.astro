---
import { ArrowRight, FileText, Heart, Mail, ShieldCheck } from '@lucide/astro';
import BrandIcon from './BrandIcon.astro';

type Props = { label: string } & (
  | { kind: 'donate'; href?: never; external?: never }
  | { kind: 'privacy' | 'terms' | 'source' | 'catalog' | 'email'; href: string; external?: boolean }
);

const { kind, label, href, external } = Astro.props;
const Tag = kind === 'donate' ? 'button' : 'a';
const icons = {
  catalog: ArrowRight,
  donate: Heart,
  email: Mail,
  privacy: ShieldCheck,
  terms: FileText,
};
const Icon = kind === 'source' ? null : icons[kind];
---

<Tag
  class="utility-action button button--secondary"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  type={kind === 'donate' ? 'button' : undefined}
  aria-haspopup={kind === 'donate' ? 'dialog' : undefined}
  data-donate={kind === 'donate' ? '' : undefined}
>
  {kind === 'source' && <BrandIcon name="github" size={16} />}
  {Icon && (
    <Icon
      class={kind === 'catalog' ? 'utility-action__arrow' : undefined}
      size={16}
      aria-hidden="true"
    />
  )}
  <span>{label}</span>
</Tag>

<style>
  .utility-action {
    min-block-size: 44px;
    max-inline-size: 100%;
    min-inline-size: 0;
    padding: 6px 14px;
    font-size: 14px;
    overflow-wrap: anywhere;
  }

  .utility-action :global(svg) {
    flex: none;
  }

  .utility-action :global(.utility-action__arrow) {
    order: 1;
  }
</style>
