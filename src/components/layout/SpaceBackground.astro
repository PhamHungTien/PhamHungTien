---
// Deterministic, decorative star layers: no image downloads or canvas render loop.
let seed = 1729;
const random = () => {
  seed = (Math.imul(1664525, seed) + 1013904223) >>> 0;
  return seed / 2 ** 32;
};
const depths = ['distant', 'near'] as const;
const stars = Array.from({ length: 112 }, (_, index) => {
  const near = index % 4 === 0;
  const bright = index % 20 === 0;
  const x = random();
  // A loose diagonal of dust adds depth without a repeating pattern across the sky.
  const y = index % 5 === 1 ? 0.64 - x * 0.25 + (random() + random() - 1) * 0.22 : random();
  const radius = (bright ? 1.2 : near ? 0.7 : 0.32) + random() * (near ? 0.45 : 0.34);
  return {
    depth: near ? 'near' : 'distant',
    bright,
    warm: bright && index % 40 === 0,
    x: Math.round(x * 1600),
    y: Math.round(y * 1000),
    radius: Number(radius.toFixed(2)),
    opacity: near ? (bright ? 0.92 : 0.38 + random() * 0.47).toFixed(2) : undefined,
  };
});
---

<div class="space" aria-hidden="true" data-motion-scene>
  <div class="space__nebula"></div>
  <div class="space__pointer"></div>
  <svg viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" focusable="false">
    {depths.map((depth) => (
      <g class={`space__${depth}`}>
        {stars
          .filter((star) => star.depth === depth)
          .map((star) => (
            <>
              {star.bright && (
                <circle
                  class="space__halo"
                  cx={star.x}
                  cy={star.y}
                  r={(star.radius * 2.4).toFixed(2)}
                />
              )}
              <circle
                class:list={{ 'space__star--bright': star.bright, 'space__star--warm': star.warm }}
                cx={star.x}
                cy={star.y}
                r={star.radius}
                opacity={star.opacity}
              />
            </>
          ))}
      </g>
    ))}
  </svg>
  <div class="space__sky" data-sky></div>
</div>

<script>
  import { initShootingStars } from '../../scripts/shooting-stars';
  initShootingStars();
</script>
<style>
  .space {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background: var(--paper);
  }
  .space__nebula {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 7% 71%, rgb(41 59 109 / 0.35), transparent 49%),
      radial-gradient(ellipse at 65% 13%, rgb(29 47 76 / 0.32), transparent 43%),
      radial-gradient(ellipse at 92% 58%, rgb(72 22 42 / 0.22), transparent 47%);
  }
  .space__pointer {
    --pointer-center: 54%;
    --pointer-shoulder: 24%;
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(280px, 56vw, 660px);
    aspect-ratio: 1;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--logo-background) var(--pointer-center), transparent),
      color-mix(in srgb, var(--logo-background) var(--pointer-shoulder), transparent) 29%,
      transparent 68%
    );
    opacity: 0;
    transform: translate3d(var(--pointer-x, 50vw), var(--pointer-y, 50vh), 0) translate(-50%, -50%);
    transition:
      opacity 340ms ease-out,
      transform 360ms var(--ease);
  }
  .space[data-pointer='active'] .space__pointer {
    opacity: 1;
  }
  :global(html[data-theme='light']) .space__pointer {
    --pointer-center: 10%;
    --pointer-shoulder: 4%;
  }
  svg {
    width: 100%;
    height: 100%;
    fill: #bacbe8;
    opacity: 0.58;
  }
  .space__distant {
    opacity: 0.28;
  }
  .space__near {
    opacity: 0.8;
  }
  .space__halo {
    opacity: 0.08;
  }
  /* Depth parallax: near stars follow the mouse more than far ones. */
  .space__distant,
  .space__near {
    transition: translate 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .space__distant {
    translate: calc(var(--px, 0) * -10px) calc(var(--py, 0) * -7px);
  }
  .space__near {
    translate: calc(var(--px, 0) * -26px) calc(var(--py, 0) * -18px);
  }
  .space__sky {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .space__sky :global(.meteor) {
    position: absolute;
    height: 1.5px;
    border-radius: 999px;
    transform-origin: 0 50%;
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 0.95),
      rgb(255 228 190 / 0.55) 14%,
      rgb(160 190 255 / 0.12) 55%,
      transparent
    );
    filter: drop-shadow(0 0 4px rgb(255 236 210 / 0.7));
    will-change: transform, opacity;
  }
  .space__sky :global(.meteor)::before {
    position: absolute;
    left: -2px;
    top: 50%;
    width: 4px;
    height: 4px;
    translate: 0 -50%;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 6px 2px rgb(255 240 220 / 0.9),
      0 0 16px 4px rgb(255 200 140 / 0.35);
    content: '';
  }
  :global(html[data-theme='light']) .space__sky :global(.meteor) {
    background: linear-gradient(
      90deg,
      rgb(80 90 140 / 0.7),
      rgb(120 130 180 / 0.25) 30%,
      transparent
    );
    filter: none;
  }
  :global(html[data-theme='light']) .space__sky :global(.meteor)::before {
    background: #5a6699;
    box-shadow: 0 0 6px 1px rgb(90 102 153 / 0.5);
  }
  :global(html[data-theme='dark']) svg {
    fill: #dfe7f8;
    opacity: 0.82;
  }
  :global(html[data-theme='dark']) .space__star--warm {
    fill: #f3ddc9;
  }
  :global(html[data-theme='light']) .space__nebula {
    background:
      radial-gradient(ellipse at 12% 28%, rgb(151 166 235 / 0.29), transparent 55%),
      radial-gradient(ellipse at 88% 68%, rgb(214 155 198 / 0.22), transparent 58%),
      radial-gradient(ellipse at 58% 7%, rgb(132 204 221 / 0.18), transparent 48%);
  }
  :global(html[data-theme='light']) svg {
    fill: #697da3;
    opacity: 0.22;
  }
  :global(html[data-theme='light']) .space__halo {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .space[data-hero-visible='true'] .space__star--bright {
      animation: starlight 4.8s ease-in-out;
    }
    .space[data-hero-visible='true'] .space__star--warm {
      animation-delay: 1.4s;
    }
    @keyframes starlight {
      50% {
        opacity: 0.58;
      }
    }
  }
  .space:not([data-running='true']) * {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .space__pointer {
      display: none;
    }
    :is(.space__distant, .space__near) {
      translate: none;
      transition: none;
    }
  }
  :global(html[data-motion='off']) .space__pointer {
    display: none;
  }
  :global(html[data-motion='off']) :is(.space__distant, .space__near) {
    translate: none;
    transition: none;
  }
</style>
