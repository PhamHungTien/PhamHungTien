---
// Deterministic, decorative star layers: no image downloads or canvas render loop.
const stars = Array.from({ length: 110 }, (_, i) => ({
  x: (i * 173 + i * i * 29) % 1600,
  y: (i * 97 + i * i * 13) % 1000,
  radius: i % 11 === 0 ? 1.6 : i % 3 === 0 ? 1 : 0.55,
}));
---

<div class="space" aria-hidden="true" data-motion-scene>
  <div class="space__nebula"></div>
  <svg viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" focusable="false">
    <g class="space__distant">
      {stars
        .filter((_, i) => i % 3 !== 0)
        .map((star) => (
          <circle cx={star.x} cy={star.y} r={star.radius} />
        ))}
    </g>
    <g class="space__near">
      {stars
        .filter((_, i) => i % 3 === 0)
        .map((star) => (
          <circle cx={star.x} cy={star.y} r={star.radius} />
        ))}
    </g>
  </svg>
  <div class="space__sky" data-sky></div>
</div>

<script>
  import { initShootingStars } from '../../scripts/shooting-stars';
  initShootingStars();
</script>
<style>
  .space {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background: var(--paper);
  }
  .space__nebula {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 14% 26%, rgb(58 58 145 / 0.22), transparent 48%),
      radial-gradient(ellipse at 86% 65%, rgb(107 30 88 / 0.17), transparent 48%),
      radial-gradient(ellipse at 57% 5%, rgb(32 83 113 / 0.14), transparent 42%);
  }
  svg {
    width: 100%;
    height: 100%;
    fill: #bacbe8;
    opacity: 0.58;
  }
  .space__distant {
    opacity: 0.48;
  }
  .space__near {
    opacity: 0.8;
  }
  /* Depth parallax: near stars follow the mouse more than far ones. */
  .space__distant,
  .space__near {
    transition: translate 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .space__distant {
    translate: calc(var(--px, 0) * -10px) calc(var(--py, 0) * -7px);
  }
  .space__near {
    translate: calc(var(--px, 0) * -26px) calc(var(--py, 0) * -18px);
  }
  .space__sky {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .space__sky :global(.meteor) {
    position: absolute;
    height: 1.5px;
    border-radius: 999px;
    transform-origin: 0 50%;
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 0.95),
      rgb(255 228 190 / 0.55) 14%,
      rgb(160 190 255 / 0.12) 55%,
      transparent
    );
    filter: drop-shadow(0 0 4px rgb(255 236 210 / 0.7));
    will-change: transform, opacity;
  }
  .space__sky :global(.meteor)::before {
    position: absolute;
    left: -2px;
    top: 50%;
    width: 4px;
    height: 4px;
    translate: 0 -50%;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 6px 2px rgb(255 240 220 / 0.9),
      0 0 16px 4px rgb(255 200 140 / 0.35);
    content: '';
  }
  :global(html[data-theme='light']) .space__sky :global(.meteor) {
    background: linear-gradient(
      90deg,
      rgb(80 90 140 / 0.7),
      rgb(120 130 180 / 0.25) 30%,
      transparent
    );
    filter: none;
  }
  :global(html[data-theme='light']) .space__sky :global(.meteor)::before {
    background: #5a6699;
    box-shadow: 0 0 6px 1px rgb(90 102 153 / 0.5);
  }
  :global(html[data-theme='dark']) .space__nebula {
    display: none;
  }
  :global(html[data-theme='dark']) svg {
    fill: #dce0e8;
  }
  :global(html[data-theme='light']) .space__nebula {
    opacity: 0.22;
  }
  :global(html[data-theme='light']) svg {
    fill: #697da3;
    opacity: 0.22;
  }
  @media (prefers-reduced-motion: no-preference) {
    .space__near {
      animation: starlight 9s ease-in-out infinite alternate;
    }
    .space__distant {
      animation: starlight 15s ease-in-out -6s infinite alternate-reverse;
    }
    @keyframes starlight {
      to {
        opacity: 0.24;
      }
    }
  }
  .space:not([data-running='true']) * {
    animation-play-state: paused;
  }
</style>
