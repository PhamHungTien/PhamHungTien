---
import { Mail } from '@lucide/astro';
import BrandIcon from '../ui/BrandIcon.astro';
import type { Locale as Lang } from '../../i18n/locales';
import { socialProfiles } from '../../data/socials';
import { t } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const [email, ...profiles] = socialProfiles;
---

<section
  class="contact container defer-render glass-card"
  id="contact"
  aria-labelledby="contact-heading"
>
  <div class="text-column">
    <h2 id="contact-heading">{t(lang, 'contact.title')}</h2>
    <p class="text-justify">{t(lang, 'contact.body')}</p>
  </div>
  <div class="contact__links">
    <a class="contact__email" href={email.href}>
      <Mail size={22} aria-hidden="true" />
      <span>{email.handle}</span>
    </a>
    <ul class="contact__profiles" role="list">
      {profiles.map((profile) => (
        <li>
          <a href={profile.href} target="_blank" rel="noopener noreferrer me">
            <BrandIcon name={profile.id} />
            <span>{profile.label}</span>
            <small>{profile.handle}</small>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 4vw, 40px) clamp(24px, 5vw, 96px);
    margin-top: var(--section-gap);
    padding: clamp(16px, 4vw, 48px);
    border: 1px solid var(--glass-edge);
    border-radius: var(--r-card);
  }

  h2 {
    font-size: var(--text-h2);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  p {
    max-width: 28em;
    margin-top: 10px;
    color: var(--muted);
    font-size: 17px;
  }

  .contact__links {
    display: grid;
    min-width: 0;
    align-content: center;
    gap: clamp(14px, 3vw, 24px);
  }

  .contact__email {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    justify-self: start;
    gap: 14px;
    font-size: clamp(16px, 4.4vw, 30px);
    font-weight: 600;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .contact__email:hover {
    text-decoration-color: var(--brand);
  }

  .contact__profiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(8px, 2vw, 12px);
  }

  .contact__profiles a {
    display: grid;
    height: 100%;
    min-height: 56px;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: clamp(8px, 1.5vw, 12px);
    padding: 9px clamp(8px, 2vw, 16px);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-panel);
    transition: border-color 160ms ease;
  }

  .contact__profiles a:hover {
    border-color: var(--ink);
  }

  .contact__profiles span {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .contact__profiles small {
    grid-column: 2;
    color: var(--muted);
    font-size: 13px;
    overflow-wrap: anywhere;
  }

  @media (width < 740px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (width < 360px) {
    .contact__profiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
