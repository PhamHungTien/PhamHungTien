---
import BrandIcon from '../ui/BrandIcon.astro';
import UtilityAction from '../ui/UtilityAction.astro';
import type { Locale as Lang } from '../../i18n/locales';
import { socialProfiles } from '../../data/socials';
import { t } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const [email, ...profiles] = socialProfiles;
---

<section class="contact container" id="contact" aria-labelledby="contact-heading">
  <div class="text-column">
    <h2 id="contact-heading">{t(lang, 'contact.title')}</h2>
    <p class="text-justify">{t(lang, 'contact.body')}</p>
  </div>
  <div class="contact__links">
    <UtilityAction kind="email" href={email.href} label={email.handle} />
    <ul class="contact__profiles" role="list">
      {profiles.map((profile) => (
        <li>
          <a
            class="glass-card glass-link"
            href={profile.href}
            target="_blank"
            rel="noopener noreferrer me"
          >
            <BrandIcon name={profile.id} />
            <span>{profile.label}</span>
            <small>{profile.handle}</small>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 4vw, 40px) clamp(24px, 5vw, 96px);
    margin-top: var(--section-gap);
    padding: clamp(16px, 4vw, 48px);
    border: 1px solid var(--glass-edge);
    border-radius: var(--r-card);
  }

  h2 {
    font-size: var(--text-h2);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  p {
    max-width: 28em;
    margin-top: 10px;
    color: var(--muted);
    font-size: 17px;
  }

  .contact__links {
    display: grid;
    min-width: 0;
    align-content: center;
    justify-items: start;
    gap: clamp(14px, 3vw, 24px);
  }

  .contact__profiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    justify-self: stretch;
    gap: clamp(8px, 2vw, 12px);
  }

  .contact__profiles > li:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .contact__profiles a {
    --glass-lift: 0 2px 12px -8px rgb(0 0 0 / 0.3);
    display: grid;
    height: 100%;
    min-height: 56px;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: clamp(8px, 1.5vw, 12px);
    padding: 9px clamp(8px, 2vw, 16px);
    border-radius: var(--r-panel);
  }

  .contact__profiles span {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .contact__profiles small {
    grid-column: 2;
    color: var(--muted);
    font-size: 13px;
    overflow-wrap: anywhere;
  }

  @media (width < 740px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (width < 360px) {
    .contact__profiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
