---
import { Mail } from '@lucide/astro';
import BrandIcon from '../ui/BrandIcon.astro';
import type { Lang } from '../../data/types';
import { socialProfiles } from '../../data/socials';
import { t } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const [email, ...profiles] = socialProfiles;
---

<section class="contact container defer-render" id="contact" aria-labelledby="contact-heading">
  <div>
    <h2 id="contact-heading">{t(lang, 'contact.title')}</h2>
    <p>{t(lang, 'contact.body')}</p>
  </div>
  <div class="contact__links">
    <a class="contact__email" href={email.href}>
      <Mail size={22} aria-hidden="true" />
      <span>{email.handle}</span>
    </a>
    <ul class="contact__profiles" role="list">
      {profiles.map((profile) => (
        <li>
          <a href={profile.href} target="_blank" rel="noopener noreferrer me">
            <BrandIcon name={profile.id as 'github' | 'linkedin'} />
            <span>{profile.label}</span>
            <small>{profile.handle}</small>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact {
    --contact-bg: #131a27;
    --contact-fg: #f3f5f8;
    --contact-muted: #aab3c3;
    --contact-line: transparent;
    --contact-line-strong: rgb(243 245 248 / 0.24);

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px clamp(32px, 6vw, 96px);
    margin-top: var(--section-gap);
    padding: clamp(28px, 5vw, 64px);
    border: 1px solid var(--contact-line);
    border-radius: 32px;
    background: var(--contact-bg);
    color: var(--contact-fg);
  }

  :root[data-theme='dark'] .contact {
    --contact-bg: var(--surface);
    --contact-fg: var(--ink);
    --contact-muted: var(--muted);
    --contact-line: var(--line);
    --contact-line-strong: var(--line-strong);
  }

  h2 {
    font-size: clamp(30px, 4.2vw, 48px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  p {
    max-width: 28em;
    margin-top: 14px;
    color: var(--contact-muted);
    font-size: 17px;
  }

  .contact__links {
    display: grid;
    min-width: 0;
    align-content: center;
    gap: 24px;
  }

  .contact__email {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    justify-self: start;
    gap: 14px;
    font-size: clamp(19px, 2.6vw, 30px);
    font-weight: 600;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--contact-line-strong);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .contact__email:hover {
    text-decoration-color: var(--gold);
  }

  .contact__profiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .contact__profiles a {
    display: grid;
    min-height: 64px;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 12px;
    padding: 12px 16px;
    border: 1px solid var(--contact-line-strong);
    border-radius: var(--r-control);
    transition: border-color 160ms ease;
  }

  .contact__profiles a:hover {
    border-color: var(--contact-fg);
  }

  .contact__profiles span {
    font-weight: 600;
  }

  .contact__profiles small {
    grid-column: 2;
    overflow: hidden;
    color: var(--contact-muted);
    font-size: 13px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contact :focus-visible {
    outline-color: var(--gold);
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .contact {
      border-radius: 24px;
    }

    .contact__profiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
