---
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import BrandIcon from '../ui/BrandIcon.astro';
import type { Locale as Lang } from '../../i18n/locales';
import { socialProfiles } from '../../data/socials';
import { t } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const [mailbox, domain] = socialProfiles[0].handle.split('@');
---

<section class="container section" id="contact" aria-labelledby="contact-heading">
  <div class="section-head">
    <div>
      <h2 id="contact-heading">{t(lang, 'contact.title')}</h2>
      <p>{t(lang, 'contact.body')}</p>
    </div>
  </div>

  <ul class="contact__links" role="list">
    {socialProfiles.map((profile) => {
      const isEmail = profile.id === 'email';
      return (
        <li>
          <a
            class:list={[
              'contact__action',
              'glass-card',
              'glass-link',
              { 'contact__action--email': isEmail },
            ]}
            href={profile.href}
            target={isEmail ? undefined : '_blank'}
            rel={isEmail ? undefined : 'noopener noreferrer me'}
          >
            <span class="contact__icon">
              {isEmail ? (
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M5 4.5h14a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3v-9a3 3 0 0 1 3-3Zm.66 3.1a1 1 0 0 0-1.2 1.6l6.94 5.2a1 1 0 0 0 1.2 0l6.94-5.2a1 1 0 0 0-1.2-1.6L12 12.35 5.66 7.6Z"
                  />
                </svg>
              ) : (
                <BrandIcon name={profile.id} />
              )}
            </span>
            <span class="contact__copy">
              <strong>{isEmail ? t(lang, 'contact.email') : profile.label}</strong>
              <small>{isEmail ? [`${mailbox}@`, <wbr />, domain] : profile.handle}</small>
            </span>
            <span class="contact__arrow">
              {isEmail ? (
                <ArrowRight size={16} aria-hidden="true" />
              ) : (
                <ArrowUpRight size={16} aria-hidden="true" />
              )}
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .contact__links {
    display: grid;
    grid-auto-rows: 1fr;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(8px, 1.2vw, 14px);
  }

  .contact__action {
    display: grid;
    grid-template-areas: 'icon copy arrow';
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px clamp(8px, 1.2vw, 14px);
    block-size: 100%;
    min-block-size: 72px;
    padding: clamp(10px, 1.3vw, 16px);
    border-radius: var(--r-card);
  }

  .contact__action--email {
    --glass-link-edge: color-mix(in srgb, var(--brand) 24%, var(--glass-edge));
  }

  .contact__icon {
    display: grid;
    grid-area: icon;
    inline-size: 38px;
    block-size: 38px;
    place-items: center;
    border-radius: var(--r-control);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    box-shadow: inset 0 1px 0 var(--glass-rim-low);
  }

  .contact__copy {
    display: grid;
    grid-area: copy;
    align-self: start;
    gap: 3px;
    overflow-wrap: anywhere;
  }

  .contact__copy strong {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.25;
  }

  .contact__copy small {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.35;
  }

  .contact__arrow {
    grid-area: arrow;
    color: var(--muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact__action:hover .contact__arrow {
      color: var(--ink);
    }
  }

  @media (width >= 360px) {
    .contact__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (360px <= width < 620px) {
    .contact__action {
      grid-template-areas: 'icon . arrow' 'copy copy copy';
      align-content: start;
    }

    .contact__icon {
      inline-size: 34px;
      block-size: 34px;
    }
  }

  @media (width >= 900px) {
    .contact__links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
