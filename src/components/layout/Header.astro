---
import { Menu, X, Moon, Sun } from '@lucide/astro';
import Logo from '../ui/Logo.astro';
import type { Locale as Lang } from '../../i18n/locales';
import { t } from '../../lib/i18n';
import { homePath } from '../../lib/routes';

export interface NavItem {
  href: string;
  label: string;
  /** Marks the item that represents the current view (the active tab on app pages). */
  current?: boolean;
  /** Tab id for app pages, so the client script can keep aria-current in sync. */
  tab?: string;
}

interface Props {
  lang: Lang;
  nav: NavItem[];
}

const { lang, nav } = Astro.props;
---

<header class="site-header" data-header>
  <a class="skip-link" href="#main-content">
    {t(lang, 'nav.skip')}
  </a>

  <div class="site-header__bar glass" data-lens>
    <a class="brand" href={homePath(lang)}>
      <Logo class="brand__mark" />
      <span class="sr-only">Phạm Hùng Tiến — {t(lang, 'nav.home')}</span>
    </a>

    <nav class="site-nav" aria-label={t(lang, 'nav.main')}>
      {nav.map((item) => (
        <a href={item.href} data-tab={item.tab} aria-current={item.current ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button
        class="icon-button"
        type="button"
        data-theme-toggle
        data-label-dark={t(lang, 'theme.toDark')}
        data-label-light={t(lang, 'theme.toLight')}
        aria-label={t(lang, 'theme.toDark')}
      >
        <Moon class="theme-icon theme-icon--moon" size={18} aria-hidden="true" />
        <Sun class="theme-icon theme-icon--sun" size={18} aria-hidden="true" />
      </button>
      <button
        class="icon-button menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-menu-toggle
        data-label-open={t(lang, 'nav.openMenu')}
        data-label-close={t(lang, 'nav.closeMenu')}
        aria-label={t(lang, 'nav.openMenu')}
      >
        <Menu class="menu-icon menu-icon--open" size={20} aria-hidden="true" />
        <X class="menu-icon menu-icon--close" size={20} aria-hidden="true" />
      </button>
    </div>
  </div>

  {/* A sibling of the bar, not a child: its own glass then blurs the page, not the bar. */}
  <nav
    class="mobile-nav glass"
    id="mobile-navigation"
    aria-label={t(lang, 'nav.main')}
    data-mobile-nav
    data-lens
    inert
  >
    {nav.map((item) => (
      <a href={item.href} data-tab={item.tab} aria-current={item.current ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script>
  import { initHeader } from '../../scripts/header';
  initHeader();
</script>

<style>
  .site-header {
    position: sticky;
    top: max(12px, env(safe-area-inset-top));
    z-index: 30;
    width: min(1200px, calc(100% - 32px));
    margin: 12px auto 0;
  }
  /* A Liquid Glass capsule: 64px tall, so its radius is 32; the 40px controls sit 12px in,
     so theirs is 20 and the shapes stay concentric. */
  .site-header__bar {
    display: flex;
    height: 64px;
    align-items: center;
    gap: 16px;
    padding: 0 12px 0 14px;
    border-radius: var(--r-pill);
  }
  :global(html[data-home-header]) .site-header {
    position: fixed;
    top: max(12px, env(safe-area-inset-top));
    left: 50%;
    margin-top: 0;
    translate: -50% 0;
    transition: transform 320ms var(--ease);
  }
  /* Slides away rather than fading: a fading parent would flatten the glass mid-way. */
  :global(html[data-home-header='hidden']) .site-header:not(:focus-within) {
    transform: translateY(calc(-100% - 24px - env(safe-area-inset-top)));
    pointer-events: none;
  }

  .skip-link {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 40;
    padding: 10px 18px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-right: auto;
    border-radius: var(--r-pill);
    font-weight: 600;
  }

  .brand :global(.brand__mark) {
    border-radius: var(--r-icon);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .site-nav a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    padding: 0 14px;
    border-radius: var(--r-pill);
    color: var(--muted);
    font-size: 15px;
    transition:
      color 150ms ease-out,
      background-color 150ms ease-out;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--ink);
  }

  .site-nav a:hover {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .site-nav a[aria-current='page'] {
    background: var(--glass-thumb);
    box-shadow:
      inset 0 1px 0 var(--glass-rim),
      0 1px 2px rgb(16 24 40 / 0.08);
    font-weight: 600;
  }

  .header-actions {
    --header-control-size: 40px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* Controls on glass are plain: no glass on glass. */
  .header-actions :global(.icon-button) {
    border-color: transparent;
    background: transparent;
  }

  .header-actions :global(.icon-button:hover) {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }

  /* The new theme's icon spins in during the theme transition. */
  :global(html.theme-switching) [data-theme-toggle] :global(.theme-icon) {
    animation: theme-icon-in 600ms var(--spring);
  }

  @keyframes theme-icon-in {
    from {
      opacity: 0;
      transform: rotate(-120deg) scale(0.4);
    }
  }

  :root[data-theme='dark'] .theme-icon--moon,
  :root:not([data-theme='dark']) .theme-icon--sun {
    display: none;
  }

  .menu-toggle,
  .menu-icon--close,
  .mobile-nav {
    display: none;
  }

  @media (max-width: 960px) {
    .site-nav {
      display: none;
    }

    .menu-toggle {
      display: inline-grid;
    }

    .menu-toggle[aria-expanded='true'] .menu-icon--open {
      display: none;
    }

    .menu-toggle[aria-expanded='true'] .menu-icon--close {
      display: block;
    }

    /* A glass sheet under the bar: radius 28, rows inset 8px, so rows are 20. */
    .mobile-nav {
      --glass-tint: var(--glass-tint-strong);
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      left: 0;
      display: grid;
      gap: 2px;
      max-height: calc(100dvh - 110px - env(safe-area-inset-top));
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 8px;
      border-radius: var(--r-sheet);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
      transform-origin: 50% 0;
      transition:
        opacity 160ms ease-out,
        transform 200ms var(--ease),
        visibility 160ms;
    }

    .mobile-nav.is-open {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    .mobile-nav a {
      position: relative;
      z-index: 3;
      display: flex;
      min-height: 50px;
      align-items: center;
      padding: 0 16px;
      border-radius: calc(var(--r-sheet) - 8px);
      font-size: 17px;
      font-weight: 500;
      transition: background-color 150ms ease-out;
    }

    .mobile-nav a:hover {
      background: color-mix(in srgb, var(--ink) 6%, transparent);
    }

    .mobile-nav a[aria-current='page'] {
      background: var(--glass-thumb);
      color: var(--brand);
      font-weight: 600;
    }
  }
</style>
