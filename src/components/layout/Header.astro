---
import { Menu, X, Moon, Sun } from '@lucide/astro';
import Logo from '../ui/Logo.astro';
import type { Locale as Lang } from '../../i18n/locales';
import { t } from '../../lib/i18n';
import { homePath } from '../../lib/routes';

export interface NavItem {
  href: string;
  label: string;
  /** Marks the item that represents the current view (the active tab on app pages). */
  current?: boolean;
  /** Tab id for app pages, so the client script can keep aria-current in sync. */
  tab?: string;
}

interface Props {
  lang: Lang;
  nav: NavItem[];
}

const { lang, nav } = Astro.props;
---

<header class="site-header" data-header>
  <a class="skip-link" href="#main-content">
    {t(lang, 'nav.skip')}
  </a>

  <a class="brand" href={homePath(lang)}>
    <Logo class="brand__mark" />
    <span class="sr-only">Phạm Hùng Tiến — {t(lang, 'nav.home')}</span>
  </a>

  <nav class="site-nav" aria-label={t(lang, 'nav.main')}>
    {nav.map((item) => (
      <a href={item.href} data-tab={item.tab} aria-current={item.current ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>

  <div class="header-actions">
    <button
      class="icon-button"
      type="button"
      data-theme-toggle
      data-label-dark={t(lang, 'theme.toDark')}
      data-label-light={t(lang, 'theme.toLight')}
      aria-label={t(lang, 'theme.toDark')}
    >
      <Moon class="theme-icon theme-icon--moon" size={18} aria-hidden="true" />
      <Sun class="theme-icon theme-icon--sun" size={18} aria-hidden="true" />
    </button>
    <button
      class="icon-button menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      data-menu-toggle
      data-label-open={t(lang, 'nav.openMenu')}
      data-label-close={t(lang, 'nav.closeMenu')}
      aria-label={t(lang, 'nav.openMenu')}
    >
      <Menu class="menu-icon menu-icon--open" size={20} aria-hidden="true" />
      <X class="menu-icon menu-icon--close" size={20} aria-hidden="true" />
    </button>
  </div>

  <nav
    class="mobile-nav"
    id="mobile-navigation"
    aria-label={t(lang, 'nav.main')}
    data-mobile-nav
    inert
  >
    {nav.map((item) => (
      <a href={item.href} data-tab={item.tab} aria-current={item.current ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script>
  import { initHeader } from '../../scripts/header';
  initHeader();
</script>

<style>
  .site-header {
    --glass-bg: rgb(247 249 252 / 0.9);
    --glass-border: rgb(255 255 255 / 0.85);
    position: sticky;
    top: max(12px, env(safe-area-inset-top));
    z-index: 30;
    display: flex;
    width: min(1200px, calc(100% - 32px));
    height: 64px;
    align-items: center;
    gap: 16px;
    margin: 12px auto 0;
    padding: 0 12px 0 18px;
    border: 1px solid var(--glass-border);
    border-radius: 22px;
    background: var(--glass-bg);
    box-shadow:
      0 12px 36px rgb(16 24 40 / 0.13),
      inset 0 1px rgb(255 255 255 / 0.8);
    -webkit-backdrop-filter: saturate(150%) blur(20px);
    backdrop-filter: saturate(150%) blur(20px);
  }
  :global(html[data-theme='dark']) .site-header {
    --glass-bg: rgb(17 21 32 / 0.86);
    --glass-border: rgb(255 255 255 / 0.16);
    box-shadow:
      0 14px 40px rgb(0 0 0 / 0.4),
      inset 0 1px rgb(255 255 255 / 0.1);
  }
  :global(html[data-home-header]) .site-header {
    position: fixed;
    top: max(12px, env(safe-area-inset-top));
    left: 50%;
    margin-top: 0;
    translate: -50% 0;
    transition:
      transform 300ms var(--ease),
      opacity 250ms ease;
  }
  :global(html[data-home-header='hidden']) .site-header:not(:focus-within) {
    transform: translateY(calc(-100% - 24px - env(safe-area-inset-top)));
    opacity: 0;
    pointer-events: none;
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header {
      background: var(--surface);
    }
  }
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .site-header {
      background: var(--surface);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .skip-link {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 40;
    padding: 10px 16px;
    border-radius: var(--r-control);
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-right: auto;
    font-weight: 600;
  }

  .brand :global(.brand__mark) {
    border-radius: 9px;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .site-nav a {
    padding: 8px 12px;
    border-radius: 14px;
    color: var(--muted);
    font-size: 15px;
    transition: color 160ms ease;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--ink);
  }

  .site-nav a[aria-current='page'] {
    background: color-mix(in srgb, var(--ink) 9%, transparent);
    font-weight: 600;
  }

  .header-actions {
    --header-control-size: 40px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* The new theme's icon spins in during the theme transition. */
  :global(html.theme-switching) [data-theme-toggle] :global(.theme-icon) {
    animation: theme-icon-in 600ms var(--spring);
  }

  @keyframes theme-icon-in {
    from {
      opacity: 0;
      transform: rotate(-120deg) scale(0.4);
    }
  }

  :root[data-theme='dark'] .theme-icon--moon,
  :root:not([data-theme='dark']) .theme-icon--sun {
    display: none;
  }

  .menu-toggle,
  .menu-icon--close,
  .mobile-nav {
    display: none;
  }

  @media (max-width: 960px) {
    .site-nav {
      display: none;
    }

    .menu-toggle {
      display: inline-grid;
    }

    .menu-toggle[aria-expanded='true'] .menu-icon--open {
      display: none;
    }

    .menu-toggle[aria-expanded='true'] .menu-icon--close {
      display: block;
    }

    .mobile-nav {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      left: 0;
      display: grid;
      max-height: calc(100dvh - 110px - env(safe-area-inset-top));
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 8px 14px;
      border: 1px solid var(--glass-border);
      border-radius: 20px;
      background: var(--glass-bg);
      box-shadow: 0 18px 40px rgb(0 0 0 / 0.25);
      -webkit-backdrop-filter: saturate(150%) blur(20px);
      backdrop-filter: saturate(150%) blur(20px);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-6px);
      transition:
        opacity 160ms ease,
        transform 160ms var(--ease),
        visibility 160ms;
    }

    .mobile-nav.is-open {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
      .mobile-nav {
        background: var(--surface);
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
      }
    }
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      .mobile-nav {
        background: var(--surface);
      }
    }
    .mobile-nav a {
      display: flex;
      min-height: 50px;
      align-items: center;
      border-bottom: 1px solid var(--line);
      font-size: 17px;
      font-weight: 500;
    }

    .mobile-nav a:last-child {
      border-bottom: 0;
    }

    .mobile-nav a[aria-current='page'] {
      color: var(--brand);
      font-weight: 600;
    }
  }
</style>
