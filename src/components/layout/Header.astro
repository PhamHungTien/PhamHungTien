---
import { Menu, X, Moon, Sun, Sparkles } from '@lucide/astro';
import Logo from '../ui/Logo.astro';
import type { Locale as Lang } from '../../i18n/locales';
import { t } from '../../lib/i18n';
import { homePath } from '../../lib/routes';

export interface NavItem {
  href: string;
  label: string;
  /** Marks the item that represents the current view (the active tab on app pages). */
  current?: boolean;
  /** Tab id for app pages, so the client script can keep aria-current in sync. */
  tab?: string;
}

interface Props {
  lang: Lang;
  nav: NavItem[];
}

const { lang, nav } = Astro.props;
---

<header class="site-header" data-header>
  <a class="skip-link" href="#main-content">
    {t(lang, 'nav.skip')}
  </a>

  <a class="brand" href={homePath(lang)}>
    <Logo class="brand__mark" />
    <span class="sr-only">Phạm Hùng Tiến — {t(lang, 'nav.home')}</span>
  </a>

  <nav class="site-nav" aria-label={t(lang, 'nav.main')}>
    {nav.map((item) => (
      <a href={item.href} data-tab={item.tab} aria-current={item.current ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>

  <div class="header-actions">
    <button
      class="icon-button"
      type="button"
      data-theme-toggle
      data-label-dark={t(lang, 'theme.toDark')}
      data-label-light={t(lang, 'theme.toLight')}
      aria-label={t(lang, 'theme.toDark')}
    >
      <Moon class="theme-icon theme-icon--moon" size={18} aria-hidden="true" />
      <Sun class="theme-icon theme-icon--sun" size={18} aria-hidden="true" />
    </button>
    <button
      class="icon-button motion-toggle"
      type="button"
      data-motion-toggle
      aria-pressed="true"
      aria-label={
        lang === 'vi'
          ? 'Hiệu ứng chuyển động'
          : lang === 'fr'
            ? 'Animations'
            : lang === 'ja'
              ? 'アニメーション'
              : 'Motion effects'
      }
      title={lang === 'vi' ? 'Bật/tắt hiệu ứng chuyển động' : 'Toggle motion effects'}
    >
      <Sparkles size={18} aria-hidden="true" />
    </button>
    <button
      class="icon-button menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      data-menu-toggle
      data-label-open={t(lang, 'nav.openMenu')}
      data-label-close={t(lang, 'nav.closeMenu')}
      aria-label={t(lang, 'nav.openMenu')}
    >
      <Menu class="menu-icon menu-icon--open" size={20} aria-hidden="true" />
      <X class="menu-icon menu-icon--close" size={20} aria-hidden="true" />
    </button>
  </div>

  <nav
    class="mobile-nav"
    id="mobile-navigation"
    aria-label={t(lang, 'nav.main')}
    data-mobile-nav
    inert
  >
    {nav.map((item) => (
      <a href={item.href} data-tab={item.tab} aria-current={item.current ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script>
  import { initHeader } from '../../scripts/header';
  initHeader();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    height: var(--header-height);
    align-items: center;
    gap: 20px;
    padding: 0 max(var(--gutter), calc((100% - var(--container)) / 2));
    border-bottom: 1px solid var(--line);
    background: var(--header-bg);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
    backdrop-filter: saturate(160%) blur(16px);
  }

  .skip-link {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 40;
    padding: 10px 16px;
    border-radius: var(--r-control);
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-right: auto;
    font-weight: 600;
  }

  .brand :global(.brand__mark) {
    border-radius: 9px;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .site-nav a {
    padding: 8px 12px;
    border-radius: 8px;
    color: var(--muted);
    font-size: 15px;
    transition: color 160ms ease;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--ink);
  }

  .site-nav a[aria-current='page'] {
    background: var(--surface-2);
    font-weight: 600;
  }

  .header-actions {
    --header-control-size: 40px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Scroll: the hairline appears once the page moves, and doubles as a reading-progress
     bar. Pure CSS scroll timelines; browsers without them keep the static border. */
  .site-header::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--brand), var(--gold));
    content: '';
    transform: scaleX(0);
    transform-origin: 0 50%;
    pointer-events: none;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .site-header {
        animation: header-settle linear both;
        animation-timeline: scroll(root);
        animation-range: 0 96px;
      }

      .site-header::after {
        animation: reading-progress linear both;
        animation-timeline: scroll(root);
      }
    }
  }

  @keyframes header-settle {
    from {
      border-bottom-color: transparent;
    }
  }

  @keyframes reading-progress {
    to {
      transform: scaleX(1);
    }
  }

  /* The new theme's icon spins in during the theme transition. */
  :global(html.theme-switching) [data-theme-toggle] :global(.theme-icon) {
    animation: theme-icon-in 600ms var(--spring);
  }

  @keyframes theme-icon-in {
    from {
      opacity: 0;
      transform: rotate(-120deg) scale(0.4);
    }
  }

  :root[data-theme='dark'] .theme-icon--moon,
  :root:not([data-theme='dark']) .theme-icon--sun {
    display: none;
  }

  .menu-toggle,
  .menu-icon--close,
  .mobile-nav {
    display: none;
  }

  @media (max-width: 960px) {
    .site-nav {
      display: none;
    }

    .menu-toggle {
      display: inline-grid;
    }

    .menu-toggle[aria-expanded='true'] .menu-icon--open {
      display: none;
    }

    .menu-toggle[aria-expanded='true'] .menu-icon--close {
      display: block;
    }

    .mobile-nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: grid;
      padding: 8px var(--gutter) 16px;
      border-bottom: 1px solid var(--line);
      background: var(--paper);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-6px);
      transition:
        opacity 160ms ease,
        transform 160ms var(--ease),
        visibility 160ms;
    }

    .mobile-nav.is-open {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    .mobile-nav a {
      display: flex;
      min-height: 50px;
      align-items: center;
      border-bottom: 1px solid var(--line);
      font-size: 17px;
      font-weight: 500;
    }

    .mobile-nav a:last-child {
      border-bottom: 0;
    }

    .mobile-nav a[aria-current='page'] {
      color: var(--brand);
      font-weight: 600;
    }
  }
</style>
