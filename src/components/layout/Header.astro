---
import { Menu, X, Moon, Sun } from '@lucide/astro';
import Logo from '../ui/Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Locale as Lang } from '../../i18n/locales';
import { t } from '../../lib/i18n';
import { homePath, type AlternateRoute } from '../../lib/routes';

export interface NavItem {
  href: string;
  label: string;
  /** Marks the item that represents the current view (the active tab on app pages). */
  current?: boolean;
  /** Tab id for app pages, so the client script can keep aria-current in sync. */
  tab?: string;
}

interface Props {
  lang: Lang;
  nav: NavItem[];
  alternates: AlternateRoute[];
}

const { lang, nav, alternates } = Astro.props;
const followsSections = nav.some((item) => item.href.startsWith('#'));
const followsPages = !followsSections && nav.some((item) => item.current);
---

<header class="site-header" data-header data-wide-nav={nav.length > 4 ? '' : undefined}>
  <div class="site-header__bar">
    <div class="site-header__material glass glass-panel" aria-hidden="true" data-lens></div>
    <a class="brand" href={homePath(lang)}>
      <Logo class="brand__mark" />
      <span class="sr-only">Phạm Hùng Tiến — {t(lang, 'nav.home')}</span>
    </a>

    <nav
      class="site-nav"
      aria-label={t(lang, 'nav.main')}
      data-sliding-thumb={followsSections ? '' : undefined}
      data-page-selection={followsPages ? '' : undefined}
    >
      {nav.map((item) => (
        <a href={item.href} data-tab={item.tab} aria-current={item.current ? 'page' : undefined}>
          {followsPages && item.current && <span class="nav-selection" aria-hidden="true" />}
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <LanguageSwitcher lang={lang} alternates={alternates} />
      <button
        class="icon-button"
        type="button"
        data-theme-toggle
        data-label-dark={t(lang, 'theme.toDark')}
        data-label-light={t(lang, 'theme.toLight')}
        aria-label={t(lang, 'theme.toDark')}
      >
        <Moon class="theme-icon theme-icon--moon" size={18} aria-hidden="true" />
        <Sun class="theme-icon theme-icon--sun" size={18} aria-hidden="true" />
      </button>
      <button
        class="icon-button menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-menu-toggle
        data-label-open={t(lang, 'nav.openMenu')}
        data-label-close={t(lang, 'nav.closeMenu')}
        aria-label={t(lang, 'nav.openMenu')}
      >
        <Menu class="menu-icon menu-icon--open" size={20} aria-hidden="true" />
        <X class="menu-icon menu-icon--close" size={20} aria-hidden="true" />
      </button>
    </div>
  </div>

  <nav
    class="mobile-nav glass"
    id="mobile-navigation"
    aria-label={t(lang, 'nav.main')}
    data-mobile-nav
    data-sliding-thumb={followsSections ? '' : undefined}
    data-page-selection={followsPages ? '' : undefined}
    data-lens
    inert
  >
    {nav.map((item) => (
      <a href={item.href} data-tab={item.tab} aria-current={item.current ? 'page' : undefined}>
        {followsPages && item.current && <span class="nav-selection" aria-hidden="true" />}
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script>
  import { initHeader } from '../../scripts/header';
  initHeader();
</script>

<style>
  .site-header {
    --header-top: max(12px, env(safe-area-inset-top));
    --header-bar-height: 64px;
    --header-menu-gap: 8px;
    --header-menu-height: max(
      0px,
      calc(
        100dvh - var(--header-top) - var(--header-bar-height) - var(--header-menu-gap) -
          max(12px, env(safe-area-inset-bottom))
      )
    );
    position: sticky;
    top: var(--header-top);
    z-index: 30;
    width: min(1200px, calc(100% - 32px));
    margin: 12px auto 0;
  }
  /* A Liquid Glass capsule: 64px tall, so its radius is 32; the 40px controls sit 12px in,
     so theirs is 20 and the shapes stay concentric. */
  .site-header__bar {
    --header-action-inset: 12px;
    position: relative;
    isolation: isolate;
    display: flex;
    height: var(--header-bar-height);
    align-items: center;
    gap: 16px;
    padding: 0 var(--header-action-inset) 0 14px;
    border-radius: var(--r-pill);
  }

  .site-header__bar .site-header__material {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-right: auto;
    border-radius: var(--r-pill);
    font-weight: 600;
  }

  .brand :global(.brand__mark) {
    border-radius: var(--r-icon);
  }

  .site-nav {
    display: var(--desktop-nav-display, flex);
    align-items: center;
    gap: 2px;
  }

  .site-nav a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    padding-inline: clamp(8px, 0.75vw, 11px);
    border-radius: var(--r-pill);
    color: color-mix(in srgb, var(--ink) 30%, var(--muted));
    font-size: 15px;
    white-space: nowrap;
    transition:
      color 150ms ease-out,
      background-color 150ms ease-out;
  }

  .site-nav a:hover,
  .site-nav a:is([aria-current='page'], [aria-current='location']) {
    color: var(--ink);
  }

  .site-nav a:hover {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .site-nav a:is([aria-current='page'], [aria-current='location']) {
    background: var(--glass-thumb);
    box-shadow:
      inset 0 1px 0 var(--glass-rim),
      0 1px 2px rgb(16 24 40 / 0.08);
    font-weight: 600;
  }

  .header-actions {
    --header-control-size: 40px;
    display: flex;
    align-items: center;
    gap: 4px;
    flex: none;
  }

  /* Controls on glass are plain: no glass on glass. */
  .header-actions :global(.icon-button) {
    border-color: transparent;
    background: transparent;
  }

  .header-actions :global(.icon-button:hover) {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }

  /* The new theme's icon spins in during the theme transition. */
  :global(html.theme-switching) [data-theme-toggle] :global(.theme-icon) {
    animation: theme-icon-in 600ms var(--spring);
  }

  @keyframes theme-icon-in {
    from {
      opacity: 0;
      transform: rotate(-120deg) scale(0.4);
    }
  }

  :root[data-theme='dark'] .theme-icon--moon,
  :root:not([data-theme='dark']) .theme-icon--sun {
    display: none;
  }

  .menu-toggle {
    display: var(--menu-toggle-display, none);
  }

  .menu-icon--close {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .menu-icon--open {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .menu-icon--close {
    display: block;
  }

  /* A separate glass sheet sits below the header. */
  .mobile-nav {
    --glass-tint: var(--glass-tint-strong);
    --thumb-radius: calc(var(--r-sheet) - 8px);
    position: absolute;
    top: calc(100% + var(--header-menu-gap));
    right: 0;
    left: 0;
    display: var(--mobile-nav-display, none);
    gap: 2px;
    max-height: var(--header-menu-height);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 8px;
    border-radius: var(--r-sheet);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-6px) scale(0.98);
    transform-origin: 50% 0;
    transition:
      opacity 160ms ease-out,
      transform 200ms var(--ease),
      visibility 160ms;
  }

  .mobile-nav.is-open {
    visibility: visible;
    opacity: 1;
    transform: none;
  }

  .mobile-nav a {
    position: relative;
    z-index: 3;
    display: flex;
    min-height: 44px;
    align-items: center;
    padding: 4px 14px;
    border-radius: calc(var(--r-sheet) - 8px);
    font-size: 16px;
    font-weight: 500;
    overflow-wrap: anywhere;
    transition: background-color 150ms ease-out;
  }

  .mobile-nav a:hover {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .mobile-nav a:is([aria-current='page'], [aria-current='location']) {
    background: var(--glass-thumb);
    color: var(--brand);
    font-weight: 600;
  }

  [data-thumb-active] a:is([aria-current='page'], [aria-current='location']),
  [data-page-selection] a[aria-current='page'] {
    background: transparent;
    box-shadow: none;
  }

  [data-page-selection] a[aria-current='page'] {
    position: relative;
    isolation: isolate;
  }

  .nav-selection {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--glass-thumb);
    box-shadow:
      inset 0 1px 0 var(--glass-rim),
      0 1px 2px rgb(16 24 40 / 0.08);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.theme-switching, [data-motion='off'])) .site-nav[data-page-selection] {
      view-transition-name: site-nav-labels;
    }

    :global(html:not(.theme-switching, [data-motion='off'])) .site-nav .nav-selection {
      view-transition-name: site-nav-selection;
    }
  }

  @media (width < 1200px) {
    .site-header[data-wide-nav] {
      --desktop-nav-display: none;
      --menu-toggle-display: inline-grid;
      --mobile-nav-display: grid;
    }
  }

  @media (width < 720px) {
    .site-header {
      --desktop-nav-display: none;
      --menu-toggle-display: inline-grid;
      --mobile-nav-display: grid;
    }
  }

  @media (width >= 520px) {
    .site-header[data-wide-nav] .mobile-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width <= 600px) {
    .site-header {
      --header-bar-height: 56px;
    }

    .site-header__bar {
      --header-action-inset: 6px;
      gap: 8px;
      padding-inline: 10px var(--header-action-inset);
    }

    .header-actions {
      --header-control-size: 44px;
      gap: 2px;
    }
  }
</style>
