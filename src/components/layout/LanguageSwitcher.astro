---
import { Check, Languages } from '@lucide/astro';
import { LANGUAGE_NAMES, type Locale } from '../../i18n/locales';
import { t } from '../../lib/i18n';
import type { AlternateRoute } from '../../lib/routes';

interface Props {
  lang: Locale;
  alternates: AlternateRoute[];
}

const { lang, alternates } = Astro.props;
const choices = alternates.flatMap(({ lang, path }) =>
  lang === 'x-default' ? [] : [{ lang, path }],
);
---

{choices.length > 1 && (
  <details class="language-switcher" data-language-switcher>
    <summary aria-label={`${t(lang, 'nav.language')}: ${LANGUAGE_NAMES[lang]}`}>
      <Languages size={17} aria-hidden="true" />
      <span aria-hidden="true">{lang.toUpperCase()}</span>
    </summary>
    <nav class="language-menu glass glass-panel" aria-label={t(lang, 'nav.language')} data-lens>
      <ul class="language-menu__choices" role="list">
        {choices.map(({ lang: language, path }) => (
          <li>
            <a
              href={path}
              lang={language}
              hreflang={language}
              aria-current={language === lang ? 'page' : undefined}
            >
              <span>{LANGUAGE_NAMES[language]}</span>
              {language === lang && <Check size={15} aria-hidden="true" />}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
)}

<style>
  .language-switcher {
    color: var(--ink);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    gap: 6px;
    padding-inline: 12px;
    border-radius: var(--r-pill);
    cursor: pointer;
    list-style: none;
    font-size: 14px;
    font-weight: 600;
    transition: background-color 150ms ease-out;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }

  details[open] summary {
    background: var(--glass-thumb);
    box-shadow: inset 0 1px 0 var(--glass-rim);
  }

  .language-menu {
    --menu-inset: 8px;
    position: absolute;
    inset-block-start: calc(100% + var(--header-menu-gap));
    inset-inline-end: var(--header-action-inset);
    z-index: 5;
    inline-size: min(11rem, calc(100% - 2 * var(--header-action-inset)));
    border-radius: var(--r-sheet);
    transform-origin: top right;
  }

  @media (prefers-reduced-motion: no-preference) {
    details[open] .language-menu {
      animation: language-menu-in 180ms var(--ease) both;
    }

    @keyframes language-menu-in {
      from {
        opacity: 0;
        transform: translateY(-4px) scale(0.98);
      }
    }
  }

  .language-menu__choices {
    display: grid;
    gap: 2px;
    max-block-size: var(--header-menu-height);
    padding: var(--menu-inset);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: inherit;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    gap: 8px;
    padding: 4px 12px;
    border-radius: calc(var(--r-sheet) - var(--menu-inset));
    color: var(--ink);
    font-size: 15px;
    overflow-wrap: anywhere;
    transition: background-color 150ms ease-out;
  }

  a :global(svg) {
    flex: none;
  }

  a:hover {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }

  a:focus-visible {
    outline-offset: -2px;
  }

  a[aria-current='page'] {
    background: var(--glass-thumb);
    box-shadow: inset 0 1px 0 var(--glass-rim);
    font-weight: 600;
  }
</style>
