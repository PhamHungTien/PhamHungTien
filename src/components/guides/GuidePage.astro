---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { ChevronRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideList from './GuideList.astro';
import YouTube from '../ui/YouTube.astro';
import Logo from '../ui/Logo.astro';
import StoreDownloads from '../ui/StoreDownloads.astro';
import { appBySlug } from '../../data/apps';
import { storesOf } from '../../data/platforms';
import type { AppSlug } from '../../data/types';
import { SITE } from '../../data/site';
import { guideCopy } from '../../i18n/guide-copy';
import { t } from '../../lib/i18n';
import { getAppCopy } from '../../lib/app-copy';
import { appPath, homePath } from '../../lib/routes';
import { absolute, ogImage, PERSON_ID, WEBSITE_ID } from '../../lib/seo';
import {
  formatDate,
  guideLang,
  getGuides,
  guidesPath,
  guideUrl,
  guideSlug,
  guideAlternates,
  guideOgKey,
  readingMinutes,
  type Guide,
} from '../../lib/guides';

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const data = guide.data;
const lang = guideLang(guide);
const copy = guideCopy[lang];
const app = data.app ? appBySlug.get(data.app as AppSlug) : undefined;
const subtitle = app ? getAppCopy(app, lang).subtitle : undefined;
const stores = app?.links.stores;
const hasStores = storesOf(stores).length > 0;
const path = guideUrl(guide);
const indexPath = guidesPath(lang);
const socialImage = ogImage(guideOgKey(guide));
const toc = headings.filter((h) => h.depth === 2);

// Related: same app first, then the newest others; never the guide itself.
const allGuides = await getGuides();
const alternates = guideAlternates(guideSlug(guide), allGuides);
const others = allGuides.filter((g) => g.data.lang === lang && g.id !== guide.id);
const related = [
  ...others.filter((g) => app && g.data.app === data.app),
  ...others.filter((g) => !app || g.data.app !== data.app),
].slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${absolute(path)}#article`,
      headline: data.title,
      description: data.description,
      inLanguage: lang,
      datePublished: data.published,
      dateModified: data.updated ?? data.published,
      url: absolute(path),
      mainEntityOfPage: absolute(path),
      image: socialImage,
      author: { '@id': PERSON_ID, '@type': 'Person', name: SITE.name, url: SITE.origin },
      publisher: { '@id': PERSON_ID },
      isPartOf: { '@id': WEBSITE_ID },
      ...(app ? { about: { '@id': `${absolute(app.route)}#app` } } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: t(lang, 'nav.home'),
          item: absolute(homePath(lang)),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: t(lang, 'nav.guides'),
          item: absolute(indexPath),
        },
        { '@type': 'ListItem', position: 3, name: data.title, item: absolute(path) },
      ],
    },
  ],
};
---

<BaseLayout
  lang={lang}
  title={`${data.title} | Phạm Hùng Tiến`}
  description={data.description}
  path={path}
  alternates={alternates}
  ogImage={socialImage}
  ogType="article"
  jsonLd={jsonLd}
  ads
  nav={[
    { href: homePath(lang), label: t(lang, 'nav.home') },
    { href: indexPath, label: t(lang, 'nav.guides'), current: true },
    ...(app ? [{ href: appPath(app, lang), label: app.name }] : []),
  ]}
>
  <article class="guide container" data-has-toc={toc.length > 2 ? '' : undefined}>
    <nav class="crumbs" aria-label={copy.breadcrumb}>
      <a href={homePath(lang)}>{t(lang, 'nav.home')}</a>
      <ChevronRight size={14} aria-hidden="true" />
      <a href={indexPath}>{t(lang, 'nav.guides')}</a>
    </nav>

    <header class="guide__head">
      <p class="guide__topic">{data.topic}</p>
      <h1>{data.title}</h1>
      <p class="guide__lead text-justify">{data.description}</p>
      <div class="guide__byline">
        <Logo size={40} />
        <span>
          <a href={homePath(lang)}>{SITE.name}</a>
          <small>
            <time datetime={data.published}>{formatDate(data.published, lang)}</time>
            {data.updated && data.updated !== data.published && (
              <>
                {' '}
                · {copy.updated}{' '}
                <time datetime={data.updated}>{formatDate(data.updated, lang)}</time>
              </>
            )}{' '}
            · {copy.readingTime(readingMinutes(guide))}
          </small>
        </span>
      </div>
    </header>

    {data.youtubeId && (
      <div class="guide__video">
        <YouTube
          id={data.youtubeId}
          title={data.title}
          lang={lang}
          sizes="(max-width: 820px) 92vw, 760px"
          priority
        />
        {lang !== 'vi' && <p class="guide__video-language">{copy.videoInVietnamese}</p>}
      </div>
    )}

    {toc.length > 2 && (
      <nav class="toc" aria-labelledby="toc-heading">
        <h2 id="toc-heading">{copy.onThisPage}</h2>
        <ol>
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`} data-toc-link>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose">
      <Content />
    </div>

    {app && (
      <aside class="app-cta glass glass-panel" aria-label={app.name}>
        <Image src={app.icon} alt="" width={64} height={64} densities={[1, 2]} loading="lazy" />
        <div class="app-cta__copy text-column">
          <strong>{app.name}</strong>
          <span class="text-justify">{subtitle}</span>
        </div>
        <div class="app-cta__links">
          <StoreDownloads stores={stores} lang={lang} />
          <a
            class:list={['button', hasStores ? 'button--secondary' : 'button--primary']}
            href={appPath(app, lang)}
            hreflang={lang}
          >
            {copy.explore(app.name)}
          </a>
        </div>
      </aside>
    )}

    <aside class="author glass-card" aria-label={copy.author}>
      <Logo size={56} />
      <div>
        <strong>{SITE.name}</strong>
        <p>{copy.bio}</p>
        <a href={SITE.youtube} target="_blank" rel="noopener noreferrer">
          YouTube
        </a>
      </div>
    </aside>
  </article>

  <script>
    import { initToc } from '../../scripts/toc';
    initToc();
  </script>
  {related.length > 0 && (
    <GuideList
      guides={related}
      lang={lang}
      title={copy.keepReading}
      allLabel={t(lang, 'guides.all')}
      id="related"
    />
  )}
</BaseLayout>

<style>
  .guide {
    max-width: 780px;
    padding-top: clamp(28px, 4vw, 56px);
    overflow-wrap: anywhere;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
  }

  .crumbs a:hover {
    color: var(--ink);
  }

  .guide__head {
    margin-top: 24px;
  }

  .guide__video-language {
    margin-top: 8px;
    color: var(--muted);
    font-size: 14px;
  }

  .guide__topic {
    color: var(--gold);
    font-size: 15px;
    font-weight: 600;
  }

  :root:not([data-theme='dark']) .guide__topic {
    color: var(--brand);
  }

  h1 {
    margin-top: 10px;
    font-size: clamp(1.875rem, 5vw, 3.25rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  h1:lang(ja),
  h1:lang(zh) {
    line-height: 1.3;
    letter-spacing: normal;
  }

  .guide__lead {
    margin-top: 18px;
    color: var(--muted);
    font-size: clamp(1.0625rem, 3.5vw, 1.25rem);
    line-height: 1.55;
  }

  .guide__byline {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 26px;
    padding-bottom: 26px;
    border-bottom: 1px solid var(--line);
  }

  .guide__byline :global(svg) {
    flex: none;
    border-radius: var(--r-icon);
  }

  .guide__byline span {
    display: grid;
  }

  .guide__byline a {
    font-weight: 600;
  }

  .guide__byline small {
    color: var(--muted);
    font-size: 14px;
  }

  .guide__video {
    overflow: hidden;
    margin-top: 32px;
    border: 1px solid var(--line);
    border-radius: var(--r-media);
    background: #000;
    box-shadow: var(--shadow-media);
  }

  .toc {
    margin-top: 32px;
    padding: 22px 26px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
  }

  .toc h2 {
    font-size: 15px;
    font-weight: 600;
  }

  .toc ol {
    margin-top: 12px;
    padding-left: 1.3em;
    display: grid;
    gap: 6px;
  }

  .toc a {
    display: block;
    padding-block: 3px;
    font-weight: 500;
  }

  .toc a:hover {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .toc a[aria-current='true'] {
    color: var(--brand);
  }

  .prose {
    min-width: 0;
  }

  .prose :global(pre),
  .prose :global(table) {
    max-width: 100%;
    overflow-wrap: normal;
    overscroll-behavior-inline: contain;
  }

  /* Wide screens: the contents move into a sticky column beside the article, so readers
     always see where they are and can jump without scrolling back up. */
  @media (min-width: 1180px) {
    .guide[data-has-toc] {
      display: grid;
      grid-template-columns: minmax(0, 760px) 248px;
      column-gap: 72px;
      max-width: 1080px;
    }

    .guide[data-has-toc] > :global(*) {
      grid-column: 1;
    }

    .guide[data-has-toc] > .toc {
      position: sticky;
      top: calc(var(--header-height) + 24px);
      grid-column: 2;
      grid-row: 1 / span 8;
      align-self: start;
      max-height: calc(100dvh - var(--header-height) - 48px);
      overflow-y: auto;
      overscroll-behavior: contain;
      margin-top: 0;
      padding: 4px 0 4px 20px;
      border: 0;
      border-left: 1px solid var(--line);
      border-radius: 0;
      background: none;
    }

    .guide[data-has-toc] > .toc ol {
      padding-left: 0;
      list-style: none;
      gap: 2px;
    }

    .guide[data-has-toc] > .toc a {
      position: relative;
      display: block;
      padding: 5px 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.4;
    }

    .guide[data-has-toc] > .toc a:hover,
    .guide[data-has-toc] > .toc a[aria-current='true'] {
      color: var(--ink);
      text-decoration: none;
    }

    .guide[data-has-toc] > .toc a[aria-current='true'] {
      font-weight: 600;
    }

    .guide[data-has-toc] > .toc a[aria-current='true']::before {
      position: absolute;
      top: 6px;
      bottom: 6px;
      left: -21px;
      width: 2px;
      border-radius: 2px;
      background: var(--brand);
      content: '';
    }
  }

  .app-cta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 18px;
    margin-top: 56px;
    padding: 22px;
    border: 1px solid var(--glass-edge);
    border-radius: var(--r-card);
  }

  .app-cta img {
    width: 64px;
    height: 64px;
    border-radius: var(--r-icon);
  }

  .app-cta__copy {
    display: grid;
  }

  .app-cta__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    grid-column: 1 / -1;
    min-width: 0;
    gap: 12px;
  }

  .app-cta span {
    color: var(--muted);
  }

  .author {
    display: flex;
    gap: 18px;
    margin-top: 24px;
    padding: 22px;
    border: 1px solid var(--glass-edge);
    border-radius: var(--r-card);
  }

  .author :global(svg) {
    flex: none;
    border-radius: var(--r-icon);
  }

  .author a {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .author p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }

  @media (max-width: 639.98px) {
    .guide__head {
      margin-top: 16px;
    }

    .guide__byline {
      gap: 10px;
      margin-top: 18px;
      padding-bottom: 18px;
    }

    .guide__video,
    .toc {
      margin-top: 22px;
    }

    .toc {
      padding: 14px 16px;
    }

    .toc ol {
      gap: 2px;
      margin-top: 6px;
    }

    .toc a {
      line-height: 1.45;
    }

    .prose :global(pre) {
      padding: 12px;
    }

    .prose :global(table) {
      font-size: 15px;
    }

    .prose :global(th),
    .prose :global(td) {
      padding: 7px 10px;
    }

    .prose :global(th) {
      white-space: normal;
    }

    .app-cta,
    .author {
      gap: 12px;
      padding: 12px;
    }

    .app-cta {
      margin-top: 36px;
    }

    .app-cta img,
    .author :global(svg) {
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 479.98px) {
    .app-cta__links > .button {
      width: 100%;
    }
  }
</style>
