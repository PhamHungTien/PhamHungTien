---
import { Image } from 'astro:assets';
import { appBySlug } from '../../data/apps';
import type { AppSlug } from '../../data/types';
import type { Locale } from '../../i18n/locales';
import { guideCopy } from '../../i18n/guide-copy';
import { formatDate, guideLang, guideUrl, readingMinutes, type Guide } from '../../lib/guides';

interface Props {
  guide: Guide;
  lang?: Locale;
}

const { guide, lang = guideLang(guide) } = Astro.props;
const articleLang = guideLang(guide);
const app = guide.data.app ? appBySlug.get(guide.data.app as AppSlug) : undefined;
---

<a class="guide-card" href={guideUrl(guide)} hreflang={articleLang}>
  <span class="guide-card__top">
    {app ? (
      <Image src={app.icon} alt="" width={28} height={28} densities={[1, 2]} loading="lazy" />
    ) : (
      <span class="guide-card__dot" aria-hidden="true" />
    )}
    <span lang={articleLang}>{guide.data.topic}</span>
  </span>
  <h3 class="guide-card__title" lang={articleLang}>
    {guide.data.title}
  </h3>
  <p lang={articleLang}>{guide.data.description}</p>
  <span class="guide-card__meta">
    <time datetime={guide.data.published}>{formatDate(guide.data.published, lang)}</time> ·
    {guideCopy[lang].readingTime(readingMinutes(guide))}
  </span>
</a>

<style>
  .guide-card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    align-content: start;
    gap: 10px;
    height: 100%;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    transition: border-color 150ms ease-out;
  }

  .guide-card:hover {
    border-color: var(--line-strong);
  }

  .guide-card__top {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
  }

  .guide-card__top img {
    width: 28px;
    height: 28px;
    border-radius: var(--r-icon);
  }

  .guide-card__dot {
    width: 10px;
    height: 10px;
    margin: 9px;
    border-radius: 50%;
    background: var(--gold);
  }

  .guide-card__title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  p {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }

  .guide-card__meta {
    margin-top: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }

  @media (max-width: 767.98px) {
    .guide-card {
      gap: 8px;
      padding: 16px;
    }

    .guide-card__title {
      font-size: 17px;
    }

    p {
      display: -webkit-box;
      overflow: hidden;
      font-size: 14px;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
  }
</style>
