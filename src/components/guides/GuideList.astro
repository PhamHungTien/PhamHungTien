---
/** A grid of guide cards with a section heading; used on the home page, app pages and /huong-dan/. */
import GuideCard from './GuideCard.astro';
import UtilityAction from '../ui/UtilityAction.astro';
import type { Locale } from '../../i18n/locales';
import type { Guide } from '../../lib/guides';
import { guidesPath } from '../../lib/guides';

interface Props {
  guides: Guide[];
  lang?: Locale;
  title: string;
  lead?: string;
  allLabel?: string;
  id?: string;
}

const { guides, title, lead, allLabel, lang = 'en', id = 'guides' } = Astro.props;
---

<section class="guides container section" id={id} aria-labelledby={`${id}-heading`}>
  <div class="section-head">
    <div>
      <h2 id={`${id}-heading`}>{title}</h2>
      {lead && <p>{lead}</p>}
    </div>
    {allLabel && <UtilityAction kind="catalog" href={guidesPath(lang)} label={allLabel} />}
  </div>
  <ul class="guides__grid" role="list">
    {guides.map((guide) => (
      <li>
        <GuideCard guide={guide} lang={lang} />
      </li>
    ))}
  </ul>
</section>

<style>
  .guides__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .guides .section-head {
    overflow-wrap: anywhere;
  }

  @media (max-width: 859.98px) {
    .guides__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }

  @media (max-width: 639.98px) {
    .guides .section-head {
      gap: 8px 16px;
      margin-bottom: 14px;
    }
  }

  @media (max-width: 359.98px) {
    .guides__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
