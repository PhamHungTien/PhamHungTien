---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideList from './GuideList.astro';
import { type GuideLang } from '../../i18n/locales';
import { guideCopy } from '../../i18n/guide-copy';
import { appBySlug } from '../../data/apps';
import { t } from '../../lib/i18n';
import { getGuides, guidesPath, guideUrl, guideIndexAlternates } from '../../lib/guides';
import { homePath } from '../../lib/routes';
import { absolute, ogImage, PERSON_ID, WEBSITE_ID } from '../../lib/seo';

interface Props {
  lang: GuideLang;
}

const { lang } = Astro.props;
const guides = await getGuides(lang);
const path = guidesPath(lang);
const name = t(lang, 'nav.guides');
const { indexDescription: description, indexTitle, descriptions } = guideCopy[lang];
const products = (['padcodeai', 'vtts'] as const).map((slug) => ({
  name: appBySlug.get(slug)!.name,
  slug,
  guides: guides.filter((guide) => guide.data.app === slug),
}));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${absolute(path)}#page`,
  url: absolute(path),
  name,
  description,
  inLanguage: lang,
  isPartOf: { '@id': WEBSITE_ID },
  author: { '@id': PERSON_ID },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: guides.map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: absolute(guideUrl(guide)),
      name: guide.data.title,
    })),
  },
};
---

<BaseLayout
  lang={lang}
  title={`${indexTitle} | Phạm Hùng Tiến`}
  description={description}
  path={path}
  alternates={guideIndexAlternates(lang)}
  ogImage={ogImage(lang === 'vi' ? 'guides' : `guides-${lang}`)}
  jsonLd={jsonLd}
  nav={[
    { href: homePath(lang), label: t(lang, 'nav.home') },
    { href: path, label: name, current: true },
    { href: `${homePath(lang)}#apps`, label: t(lang, 'nav.apps') },
  ]}
>
  {descriptions ? (
    <header class="guide-intro container section">
      <h1>{indexTitle}</h1>
      <p>{description}</p>
    </header>
  ) : (
    <GuideList
      guides={guides}
      lang={lang}
      title={name}
      lead={description}
      headingLevel="h1"
      id="all"
    />
  )}
  {descriptions &&
    products.map((product) => (
      <GuideList
        guides={product.guides}
        lang={lang}
        title={product.name}
        lead={descriptions[product.slug]}
        id={`${product.slug}-guides`}
      />
    ))}
</BaseLayout>

<style>
  .guide-intro h1 {
    font-size: clamp(30px, 5vw, 54px);
    line-height: 1.15;
    font-weight: 600;
  }
  .guide-intro p {
    max-width: 64ch;
    margin-top: 12px;
    color: var(--muted);
  }
</style>
