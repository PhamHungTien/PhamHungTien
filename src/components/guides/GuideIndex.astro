---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideList from './GuideList.astro';
import { type Locale } from '../../i18n/locales';
import { guideCopy } from '../../i18n/guide-copy';
import { apps } from '../../data/apps';
import { t } from '../../lib/i18n';
import { getGuides, guidesPath, guideUrl, guideIndexAlternates } from '../../lib/guides';
import { homePath } from '../../lib/routes';
import { absolute, ogImage, PERSON_ID, WEBSITE_ID } from '../../lib/seo';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const guides = await getGuides(lang);
const path = guidesPath(lang);
const name = t(lang, 'nav.guides');
const { indexDescription: description, indexTitle } = guideCopy[lang];
const products = apps
  .map(({ name, slug }) => ({
    name,
    slug,
    guides: guides.filter((guide) => guide.data.app === slug),
  }))
  .filter((product) => product.guides.length > 0);
const collections = products.filter((product) => product.guides.length > 1);
const individualGuides = products.filter((product) => product.guides.length === 1);
const general = guides.filter((guide) => !apps.some(({ slug }) => slug === guide.data.app));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${absolute(path)}#page`,
  url: absolute(path),
  name,
  description,
  inLanguage: lang,
  isPartOf: { '@id': WEBSITE_ID },
  author: { '@id': PERSON_ID },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: guides.map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: absolute(guideUrl(guide)),
      name: guide.data.title,
    })),
  },
};
---

<BaseLayout
  lang={lang}
  title={`${indexTitle} | Phạm Hùng Tiến`}
  description={description}
  path={path}
  alternates={guideIndexAlternates}
  ogImage={ogImage(lang === 'vi' ? 'guides' : `guides-${lang}`)}
  jsonLd={jsonLd}
  nav={[
    { href: homePath(lang), label: t(lang, 'nav.home') },
    { href: path, label: name, current: true },
    { href: `${homePath(lang)}#apps`, label: t(lang, 'nav.apps') },
  ]}
>
  <div class="guide-index">
    <header class="guide-intro container section" id="all">
      <h1>{indexTitle}</h1>
      <p>{description}</p>
    </header>
    {collections.map((product) => (
      <GuideList
        guides={product.guides}
        lang={lang}
        title={product.name}
        id={`${product.slug}-guides`}
      />
    ))}
    {individualGuides.length > 0 && (
      <div class="guide-index__individual container section">
        {individualGuides.map((product) => (
          <GuideList
            guides={product.guides}
            lang={lang}
            title={product.name}
            id={`${product.slug}-guides`}
          />
        ))}
      </div>
    )}
    {general.length > 0 && (
      <GuideList guides={general} lang={lang} title={name} id="general-guides" />
    )}
  </div>
</BaseLayout>

<style>
  .guide-intro h1 {
    font-size: clamp(1.75rem, 5vw, 3.375rem);
    line-height: 1.15;
    font-weight: 600;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .guide-intro h1:lang(ja),
  .guide-intro h1:lang(zh) {
    line-height: 1.3;
  }

  .guide-intro p {
    max-width: 64ch;
    margin-top: 12px;
    color: var(--muted);
  }

  .guide-index__individual {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(12px, 2.5vw, 20px);
  }

  .guide-index__individual :global(.guides) {
    display: grid;
    width: 100%;
    min-width: 0;
    grid-template-rows: auto 1fr;
    padding-top: 0;
  }

  .guide-index__individual :global(.guides__grid) {
    grid-template-columns: minmax(0, 1fr);
  }

  .guide-index__individual :global(h2) {
    font-size: var(--text-h3);
  }

  @media (width >= 360px) {
    .guide-index__individual {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 1100px) {
    .guide-index__individual {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 639.98px) {
    .guide-index {
      --section-gap: 34px;
    }
  }
</style>
