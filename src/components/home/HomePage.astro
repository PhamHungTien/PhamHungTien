---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import AppDirectory from './AppDirectory.astro';
import Contact from '../layout/Contact.astro';
import GuideList from '../guides/GuideList.astro';
import { getGuides, guidesPath } from '../../lib/guides';
import type { Locale } from '../../i18n/locales';
import { t } from '../../lib/i18n';
import { homeAlternates, homePath } from '../../lib/routes';
import { homeJsonLd, ogImage } from '../../lib/seo';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const guides = (await getGuides(lang)).slice(0, 3);
---

<BaseLayout
  lang={lang}
  title={t(lang, 'meta.home.title')}
  description={t(lang, 'meta.home.description')}
  path={homePath(lang)}
  alternates={homeAlternates}
  ogImage={ogImage('home')}
  jsonLd={homeJsonLd(lang)}
  nav={[
    { href: '#apps', label: t(lang, 'nav.apps') },
    {
      href: guidesPath(lang),
      label: t(lang, 'nav.guides'),
      section: guides.length ? 'guides' : undefined,
    },
    { href: '#contact', label: t(lang, 'nav.contact') },
  ]}
>
  <Hero lang={lang} />
  <AppDirectory lang={lang} />
  {guides.length > 0 && (
    <GuideList
      guides={guides}
      lang={lang}
      title={t(lang, 'guides.title')}
      lead={t(lang, 'guides.lead')}
      allLabel={t(lang, 'guides.all')}
    />
  )}
  <Contact lang={lang} />
</BaseLayout>

<script>
  import { initSectionNavigation } from '../../scripts/section-navigation';
  initSectionNavigation();
</script>
