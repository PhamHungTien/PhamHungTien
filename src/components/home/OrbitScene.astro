---
import { Image } from 'astro:assets';
import { Cpu, Download } from '@lucide/astro';
import Logo from '../ui/Logo.astro';
import StoreDownloads from '../ui/StoreDownloads.astro';
import { apps as catalog } from '../../data/apps';
import { appPath } from '../../lib/routes';
import { getAppCopy } from '../../lib/app-copy';
import { getReleaseLinks } from '../../lib/github';
import { t } from '../../lib/i18n';
import type { Locale } from '../../i18n/locales';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const first = Math.max(
  0,
  catalog.findIndex((app) => app.slug === 'vtts'),
);
const apps = [...catalog.slice(first), ...catalog.slice(0, first)];
const categories = apps.map((app) => getAppCopy(app, lang).category);
const downloads = await Promise.all(
  apps.map(async (app) => {
    if (!app.install) return [];
    const links = await getReleaseLinks(app.install.githubRepo);
    return [
      {
        arch: 'arm64',
        title: t(lang, 'app.install.silicon'),
        url: links.arm64 ?? links.universal ?? links.releaseUrl,
        icon: Download,
      },
      {
        arch: 'intel',
        title: t(lang, 'app.install.intel'),
        url: links.intel ?? links.universal ?? links.releaseUrl,
        icon: Cpu,
      },
    ];
  }),
);

// Lay out the app links around the brand before the engine positions them.
const fallback = apps.map((_, index) => {
  const angle = -Math.PI / 2 + (index * Math.PI * 2) / apps.length;
  return {
    x: (50 + Math.cos(angle) * 40).toFixed(1),
    y: (44 - Math.sin(angle) * 30).toFixed(1),
  };
});
---

<div class="orbit" data-planet-system data-motion-scene>
  <div class="orbit__halo" aria-hidden="true"></div>

  <div class="orbit__core" aria-hidden="true">
    <Logo class="orbit__logo" background={false} />
  </div>

  <nav class="orbit__planets" aria-label={t(lang, 'nav.apps')}>
    {apps.map((app, index) => (
      <a
        class="planet"
        href={appPath(app, lang)}
        aria-label={app.name}
        data-planet
        data-app-slug={app.slug}
        data-name={app.name}
        data-category={categories[index]}
        style={`--fx: ${fallback[index].x}%; --fy: ${fallback[index].y}%;`}
      >
        <span class="planet__orb">
          <Image
            class="planet__body"
            src={app.icon}
            alt=""
            width={96}
            height={96}
            densities={[1, 2]}
            loading="eager"
          />
        </span>
        <span class="planet__label" aria-hidden="true">
          {app.name}
        </span>
      </a>
    ))}
  </nav>

  <div class="orbit__caption" data-orbit-caption>
    <a class="orbit__caption-link" href={appPath(apps[0], lang)} data-caption-link>
      <span class="orbit__caption-name" data-caption-name>
        {apps[0].name}
      </span>
      <span class="orbit__caption-meta" data-caption-meta>
        {categories[0]}
      </span>
    </a>
    <div class="orbit__quick">
      {apps.map((app, index) => (
        <div
          class="orbit__quick-group"
          role="group"
          aria-label={`${t(lang, 'home.downloads')} · ${app.name}`}
          data-downloads-for={app.slug}
          data-install={app.install?.githubRepo}
          inert={index !== 0}
        >
          {downloads[index].map(({ arch, icon: Icon, title, url }) => (
            <a class="orbit__quick-link glass glass-panel" href={url} data-install-arch={arch}>
              <Icon size={14} aria-hidden="true" />
              {title}
            </a>
          ))}
          <StoreDownloads stores={app.links.stores} lang={lang} />
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  import { initInstall } from '../../scripts/install';
  import { initPlanetSystem } from '../../scripts/planet-system';
  initInstall();
  // Start after the first paint: the page is laid out by then, so measuring is cheap and
  // the engine's set-up never lengthens the task that renders the hero.
  requestAnimationFrame(() => setTimeout(initPlanetSystem, 0));
</script>

<style>
  /* The frame takes whatever the screen offers; the engine then picks the camera angle and
     scale that fill it, so the system fits every size and orientation. */
  .orbit {
    --orbit-width: min(100vw - 40px, 2600px);
    --orbit-caption-room: 52px;
    position: relative;
    /* Break out of the page container: the universe is allowed to be wider than text. */
    width: var(--orbit-width);
    margin-left: 50%;
    translate: -50% 0;
    height: clamp(
      272px,
      calc(100svh - var(--header-height) - var(--hero-reserve)),
      calc(var(--orbit-width) * var(--orbit-max-height, 1.05) + var(--orbit-caption-room))
    );
    flex-shrink: 0;
    /* The brand and halo share a fallback center until the layout engine measures the stage. */
    container-type: size;
    isolation: isolate;
    touch-action: pan-y pinch-zoom;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    cursor: grab;
  }
  .orbit[data-dragging='true'] {
    cursor: grabbing;
  }
  .orbit[data-motion='still'] {
    cursor: default;
  }

  /* Soft light pool around the brand planet; it fades as the hero scrolls away. */
  .orbit__halo {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--sun-size, 160px) * 4.2);
    max-width: 100%;
    aspect-ratio: 1.6;
    translate: calc(var(--sun-x, 50cqw) - 50%) calc(var(--sun-y, 44cqh) - 50%);
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(158 46 65 / 0.22),
      rgb(122 20 36 / 0.08) 45%,
      transparent 100%
    );
    opacity: calc(1 - var(--scroll, 0) * 0.8);
    pointer-events: none;
    z-index: 1;
  }
  :global([data-theme='light']) .orbit__halo {
    background: radial-gradient(
      closest-side,
      rgb(122 20 36 / 0.11),
      rgb(122 20 36 / 0.04) 45%,
      transparent 100%
    );
  }

  .orbit__core {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--sun-size, clamp(92px, 20cqw, 220px));
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    translate: calc(var(--sun-x, 50cqw) - 50%) calc(var(--sun-y, 44cqh) - 50%);
    z-index: 10;
    border-radius: 50%;
    overflow: hidden;
    background: radial-gradient(circle at 37% 27%, #9a3548, #7a1424 45%, #570c19 72%, #28050d);
    box-shadow:
      inset 0 1px 2px rgb(255 225 235 / 0.37),
      inset 0 -4px 10px rgb(45 5 14 / 0.45),
      0 14px 38px -16px rgb(57 6 16 / 0.65);
    pointer-events: none;
  }

  .orbit__core::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 29% 18%, rgb(255 235 241 / 0.24), transparent 47%);
  }

  .orbit__core :global(.orbit__logo) {
    display: block;
    width: 76%;
    height: 76%;
    filter: drop-shadow(0 2px 3px rgb(35 1 8 / 0.34));
  }

  /* Planets */
  .orbit__planets {
    display: contents;
  }
  .planet {
    position: absolute;
    left: var(--fx, 50%);
    top: var(--fy, 50%);
    width: var(--planet-unit, clamp(44px, 5.6vw, 62px));
    height: var(--planet-unit, clamp(44px, 5.6vw, 62px));
    min-width: 40px;
    min-height: 40px;
    border-radius: var(--r-icon);
    transform: translate(-50%, -50%);
    z-index: 20;
    touch-action: pan-y pinch-zoom;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  /* Once the engine has measured, every planet is placed by its transform, moving or still. */
  .orbit[data-ready] .planet {
    left: 0;
    top: 0;
  }
  .orbit[data-ready][data-motion='live'] .planet,
  .orbit[data-ready][data-motion='live'] .planet__orb {
    will-change: transform;
  }
  /* With JS, planets wait for the engine so they never jump from the fallback layout. */
  :global(html[data-motion]) .orbit:not([data-ready]) .planet {
    opacity: 0;
  }

  .planet__orb {
    position: absolute;
    inset: 0;
  }
  .planet :global(.planet__body) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--r-icon);
    object-fit: contain;
    pointer-events: none;
  }
  /* Straight, horizontal names: readable at any angle. */
  .planet__label {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, calc(var(--planet-unit, 56px) / 2 + 4px));
    color: var(--ink);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    text-shadow:
      0 1px 2px rgb(0 0 0 / 0.8),
      0 0 10px rgb(0 0 0 / 0.6);
    pointer-events: none;
  }
  :global([data-theme='light']) .planet__label {
    text-shadow:
      0 0 2px var(--paper),
      0 0 10px var(--paper);
  }
  .planet:focus-visible {
    outline: none;
    z-index: 100 !important;
    opacity: 1 !important;
  }
  .planet:focus-visible :global(.planet__body) {
    outline: 2px solid var(--focus);
    outline-offset: 5px;
  }

  /* The app in front: its name and category, centred under it. */
  /* Painted with the page under the orbit; once the engine runs it is placed by transform
     under the app in front. */
  .orbit__caption {
    position: absolute;
    left: 50%;
    bottom: 6px;
    z-index: 60;
    display: grid;
    justify-items: center;
    gap: 6px;
    width: max-content;
    max-inline-size: min(21rem, 100cqw - 36px);
    padding: 2px 4px;
    color: var(--ink);
    text-align: center;
    overflow-wrap: anywhere;
    transform: translateX(-50%);
    text-shadow:
      0 1px 2px rgb(0 0 0 / 0.75),
      0 0 14px rgb(0 0 0 / 0.55);
  }
  :global([data-theme='light']) .orbit__caption {
    text-shadow:
      0 0 2px var(--paper),
      0 0 12px var(--paper);
  }
  .orbit__caption[inert] {
    pointer-events: none;
  }
  .orbit[data-ready] .orbit__caption {
    top: 0;
    bottom: auto;
    left: 0;
  }
  .orbit__caption-name {
    font-size: clamp(16px, 1.5vw, 20px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .orbit__caption-link {
    display: grid;
    gap: 2px;
    border-radius: 8px;
  }
  .orbit__caption-link:hover .orbit__caption-name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .orbit__caption-meta {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.35;
  }
  .orbit__quick {
    display: grid;
    min-inline-size: 0;
  }
  .orbit__quick-group {
    --store-downloads-align: center;
    --store-downloads-gap: 6px;
    --store-badge-height: 40px;
    display: flex;
    grid-area: 1 / 1;
    align-items: stretch;
    justify-content: center;
    gap: 5px;
  }
  .orbit__quick-group[inert] {
    visibility: hidden;
  }
  .orbit__quick-link {
    display: inline-flex;
    min-block-size: 44px;
    min-inline-size: 44px;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 4px 9px;
    border-radius: var(--r-pill);
    color: var(--ink);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    text-shadow: none;
  }
  .orbit__quick-link :global(svg) {
    flex: none;
  }
  .orbit__quick-link:hover {
    --glass-tint: color-mix(in srgb, var(--ink) 10%, var(--glass-tint-strong));
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='off'])) .orbit__core {
      animation: sun-arrival 1100ms cubic-bezier(0.34, 1.4, 0.64, 1) both;
    }
    :global(html:not([data-motion='off'])) .orbit__core::before {
      animation: sun-reflection 9s ease-in-out infinite alternate;
    }
    :global(html:not([data-motion='off'])) .orbit__halo {
      animation: fade-in 1600ms ease 200ms both;
    }
    @keyframes sun-arrival {
      from {
        opacity: 0;
        scale: 0.4;
      }
    }
    @keyframes sun-reflection {
      from {
        transform: translate(-3%, 1%);
        opacity: 0.8;
      }
      to {
        transform: translate(4%, -3%);
        opacity: 1;
      }
    }
    @keyframes fade-in {
      from {
        opacity: 0;
      }
    }
  }

  .orbit:not([data-running='true']) *,
  .orbit:not([data-running='true']) .orbit__core::before {
    animation-play-state: paused;
  }

  @media (max-width: 560px) {
    .orbit {
      --orbit-width: calc(100vw - 12px);
    }
    .orbit__halo {
      width: 90%;
      aspect-ratio: 1.2;
    }
    .planet__label {
      font-size: 12px;
    }
    .orbit__caption-meta {
      font-size: 12px;
    }
  }

  @media (max-width: 320px) {
    .orbit {
      --orbit-caption-room: 100px;
      min-block-size: 360px;
    }
    .orbit__caption {
      max-inline-size: min(13rem, 100cqw - 36px);
    }
  }

  @media (max-height: 520px) and (min-width: 561px) {
    .orbit {
      min-block-size: 322px;
    }
  }
</style>
