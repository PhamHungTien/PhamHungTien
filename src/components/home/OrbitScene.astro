---
import { Image } from 'astro:assets';
import Logo from '../ui/Logo.astro';
import { apps } from '../../data/apps';
import { appPath } from '../../lib/routes';
---

<!-- The scene itself is the app navigation; every tile works with keyboard and touch. -->
<div
  class="orbit"
  data-tilt
  data-tilt-strength="16"
  data-motion-scene
  aria-label="Explore the apps"
>
  <div class="orbit__world">
    <div aria-hidden="true" class="orbit__ring orbit__ring--one"></div>
    <div aria-hidden="true" class="orbit__ring orbit__ring--two"></div>
    <div aria-hidden="true" class="orbit__ring orbit__ring--three"></div>
    <div class="orbit__core" aria-hidden="true">
      <div class="orbit__sphere"></div>
      <div class="orbit__mark">
        <Logo size={108} />
      </div>
    </div>
    {apps.map((app, index) => (
      <a
        href={appPath(app)}
        aria-label={app.name}
        class={`orbit__satellite orbit__satellite--${index}`}
        style={`--float-delay: ${index * -1.3}s; --satellite-color: ${app.accent}`}
      >
        <div class="orbit__float">
          <Image
            src={app.icon}
            alt=""
            width={160}
            height={160}
            densities={[1, 2]}
            loading="eager"
          />
        </div>
        <span class="orbit__app-name">{app.name}</span>
      </a>
    ))}
    <span class="orbit__star orbit__star--one"></span>
    <span class="orbit__star orbit__star--two"></span>
    <span class="orbit__star orbit__star--three"></span>
  </div>
</div>

<style>
  .orbit {
    position: relative;
    width: min(100%, 1000px);
    aspect-ratio: 1.45;
    margin-inline: auto;
    isolation: isolate;
  }
  .orbit__world {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: perspective(950px) rotateX(var(--tilt-x, -6deg)) rotateY(var(--tilt-y, -10deg));
    transition: transform 650ms var(--ease);
  }
  .orbit[data-pointer-active] .orbit__world {
    transition-duration: 160ms;
  }
  .orbit__ring {
    position: absolute;
    inset: 13%;
    border: 1px solid rgb(240 192 78 / 0.7);
    border-radius: 50%;
    transform-style: preserve-3d;
    box-shadow:
      0 0 15px rgb(240 192 78 / 0.08),
      inset 0 0 15px rgb(240 192 78 / 0.08);
  }
  .orbit__ring::before {
    position: absolute;
    top: 50%;
    left: -4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ffdf91;
    box-shadow: 0 0 18px #e7ab52;
    content: '';
  }
  .orbit__ring--one {
    transform: rotateZ(-28deg) rotateX(66deg);
  }
  .orbit__ring--two {
    inset: 18%;
    border-color: rgb(229 160 189 / 0.6);
    transform: rotateZ(50deg) rotateX(60deg);
  }
  .orbit__ring--three {
    inset: 9%;
    border-style: dashed;
    border-color: rgb(255 255 255 / 0.15);
    transform: rotateZ(18deg) rotateY(65deg);
  }
  .orbit__core {
    position: absolute;
    inset: 27% 34%;
    transform-style: preserve-3d;
  }
  .orbit__sphere {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle at 30% 24%,
      #ffe9b0 0%,
      #d9a35e 12%,
      #9e3e4d 35%,
      #4c1c30 62%,
      #180f22 82%
    );
    box-shadow:
      inset -12px -15px 30px rgb(0 0 0 / 0.5),
      inset 3px 3px 8px rgb(255 230 178 / 0.6),
      0 25px 35px -10px #0a0b16;
  }
  .orbit__mark {
    position: absolute;
    inset: 23%;
    display: grid;
    place-items: center;
    transform: translateZ(42px) rotateZ(-8deg);
    filter: drop-shadow(0 12px 12px rgb(0 0 0 / 0.4));
  }
  .orbit__mark :global(svg) {
    width: 100%;
    height: auto;
  }
  .orbit__satellite {
    position: absolute;
    width: 13%;
    transform: translateZ(52px);
  }
  .orbit__float {
    border-radius: 24%;
    box-shadow:
      0 14px 24px -8px #050712,
      0 0 25px color-mix(in srgb, var(--satellite-color) 22%, transparent);
  }
  .orbit__float img {
    width: 100%;
    height: auto;
    border-radius: 24%;
  }
  .orbit__satellite--0 {
    left: 16%;
    top: 17%;
    rotate: -14deg;
    width: 16%;
  }
  .orbit__satellite--1 {
    left: 69%;
    top: 15%;
    rotate: 13deg;
  }
  .orbit__satellite--2 {
    left: 78%;
    top: 45%;
    rotate: 9deg;
    width: 15%;
  }
  .orbit__satellite--3 {
    left: 58%;
    top: 73%;
    rotate: -10deg;
  }
  .orbit__satellite--4 {
    left: 24%;
    top: 73%;
    rotate: 8deg;
    width: 11%;
  }
  .orbit__satellite--5 {
    left: 6%;
    top: 49%;
    rotate: -12deg;
  }
  .orbit__satellite--6 {
    left: 45%;
    top: 8%;
    rotate: 7deg;
    width: 9%;
  }
  .orbit__star {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #f9d991;
    box-shadow: 0 0 12px #f9d991;
  }
  .orbit__star--one {
    left: 38%;
    top: 21%;
  }
  .orbit__star--two {
    left: 83%;
    top: 71%;
  }
  .orbit__star--three {
    left: 14%;
    top: 35%;
  }
  .orbit__signature,
  .orbit__coordinate {
    position: absolute;
    bottom: 20px;
    color: var(--muted);
    font: 9px var(--font-mono);
    letter-spacing: 0.1em;
  }
  .orbit__signature {
    left: 24px;
  }
  .orbit__coordinate {
    right: 24px;
    color: #e6bf76;
  }
  @media (prefers-reduced-motion: no-preference) {
    .orbit__float {
      animation: satellite-float 7s ease-in-out var(--float-delay) infinite;
    }
    .orbit__ring--one {
      animation: orbit-turn 24s linear infinite;
    }
    .orbit__ring--two {
      animation: orbit-cross 30s linear infinite;
    }
    @keyframes satellite-float {
      50% {
        transform: translateY(-12px) rotate(5deg);
      }
    }
    @keyframes orbit-turn {
      to {
        transform: rotateZ(-28deg) rotateX(66deg) rotateZ(360deg);
      }
    }
    @keyframes orbit-cross {
      to {
        transform: rotateZ(50deg) rotateX(60deg) rotateZ(-360deg);
      }
    }
  }
  .orbit:not([data-running='true']) *,
  .orbit:not([data-running='true']) *::before {
    animation-play-state: paused;
  }
  @media (max-width: 400px) {
    .orbit__coordinate {
      display: none;
    }
  }
</style>

<style>
  .orbit__app-name {
    display: block;
    margin-top: 12px;
    color: var(--muted);
    text-align: center;
    font-size: clamp(9px, 1.1vw, 13px);
    font-weight: 600;
    white-space: nowrap;
  }
  .orbit__satellite {
    text-decoration: none;
    border-radius: 24%;
  }
  .orbit__satellite:hover .orbit__app-name {
    color: var(--ink);
  }
  .orbit__satellite:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 10px;
  }
  .orbit__satellite--0 {
    left: 16%;
    top: 15%;
    width: 12%;
  }
  .orbit__satellite--1 {
    left: 69%;
    top: 12%;
    width: 10%;
  }
  .orbit__satellite--2 {
    left: 80%;
    top: 46%;
    width: 12%;
  }
  .orbit__satellite--3 {
    left: 62%;
    top: 74%;
    width: 10%;
  }
  .orbit__satellite--4 {
    left: 27%;
    top: 76%;
    width: 9%;
  }
  .orbit__satellite--5 {
    left: 6%;
    top: 49%;
    width: 10%;
  }
  .orbit__satellite--6 {
    left: 46%;
    top: 4%;
    width: 7%;
  }
  @media (max-width: 560px) {
    .orbit {
      aspect-ratio: 1;
      margin-block: 20px;
    }
    .orbit__core {
      inset: 34%;
    }
    .orbit__app-name {
      font-size: 9px;
      margin-top: 8px;
    }
    .orbit__satellite--6 {
      width: 11%;
      left: 44%;
    }
    .orbit__satellite {
      min-width: 44px;
    }
  }
</style>
