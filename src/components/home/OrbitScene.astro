---
import { Image } from 'astro:assets';
import { apps } from '../../data/apps';
import { appPath } from '../../lib/routes';
---

<!-- The scene itself is the app navigation; every tile works with keyboard and touch. -->
<div
  class="orbit"
  data-tilt
  data-tilt-strength="16"
  data-motion-scene
  aria-label="Explore the apps"
>
  <div class="orbit__world">
    <div aria-hidden="true" class="orbit__ring orbit__ring--one"></div>
    <div aria-hidden="true" class="orbit__ring orbit__ring--two"></div>
    <div aria-hidden="true" class="orbit__ring orbit__ring--three"></div>
    <div class="orbit__core" aria-hidden="true">
      <div class="orbit__sphere"></div>
      <div class="orbit__sheen"></div>
      <div class="orbit__meridian orbit__meridian--one"></div>
      <div class="orbit__meridian orbit__meridian--two"></div>
      <div class="orbit__mark">
        <svg viewBox="0 0 64 64" width="180" height="180" focusable="false">
          <path
            d="M17.5 31h29M32 31v20"
            stroke="#fff"
            stroke-width="11"
            stroke-linecap="round"
            fill="none"
          />
          <path
            d="M32 8.5 47.5 19Q32 22 16.5 19Z"
            fill="#f0c04e"
            stroke="#f0c04e"
            stroke-width="4.5"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    </div>
    {apps.map((app, index) => (
      <a
        href={appPath(app)}
        aria-label={app.name}
        class={`orbit__satellite orbit__satellite--${index}`}
        style={`--float-delay: ${index * -1.3}s; --satellite-color: ${app.accent}`}
      >
        <div class="orbit__float">
          <span class="orbit__tile-edge" aria-hidden="true"></span>
          <Image
            src={app.icon}
            alt=""
            width={160}
            height={160}
            densities={[1, 2]}
            loading="eager"
          />
          <span class="orbit__tile-shine" aria-hidden="true"></span>
        </div>
        <span class="orbit__app-name">{app.name}</span>
      </a>
    ))}
    {Array.from({ length: 12 }, (_, i) => (
      <span
        class="orbit__particle"
        aria-hidden="true"
        style={`--px: ${50 + Math.cos((i * Math.PI) / 6) * 43}%; --py: ${50 + Math.sin((i * Math.PI) / 6) * 39}%; --delay: ${i * -0.7}s; --depth: ${((i % 3) - 1) * 40}px`}
      ></span>
    ))}
    <span class="orbit__star orbit__star--one"></span>
    <span class="orbit__star orbit__star--two"></span>
    <span class="orbit__star orbit__star--three"></span>
  </div>
</div>

<style>
  .orbit {
    position: relative;
    width: min(100%, 1000px);
    aspect-ratio: 1.45;
    margin-inline: auto;
    isolation: isolate;
  }
  .orbit__world {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: perspective(950px) rotateX(var(--tilt-x, -6deg)) rotateY(var(--tilt-y, -10deg));
    transition: transform 650ms var(--ease);
  }
  .orbit[data-pointer-active] .orbit__world {
    transition-duration: 160ms;
  }
  .orbit__ring {
    pointer-events: none;
    position: absolute;
    inset: 13%;
    border: 2px solid color-mix(in srgb, var(--gold) 70%, transparent);
    border-radius: 50%;
    transform-style: preserve-3d;
    box-shadow:
      0 0 15px rgb(240 192 78 / 0.08),
      inset 0 0 15px rgb(240 192 78 / 0.08);
  }
  .orbit__ring::before {
    position: absolute;
    top: 50%;
    left: -4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ffdf91;
    box-shadow: 0 0 18px #e7ab52;
    content: '';
  }
  .orbit__ring--one {
    transform: rotateZ(-28deg) rotateX(66deg);
  }
  .orbit__ring--two {
    inset: 18%;
    border-color: color-mix(in srgb, var(--brand) 40%, transparent);
    transform: rotateZ(50deg) rotateX(60deg);
  }
  .orbit__ring--three {
    inset: 9%;
    border-style: dashed;
    border-color: color-mix(in srgb, var(--muted) 25%, transparent);
    transform: rotateZ(18deg) rotateY(65deg);
  }
  .orbit__core {
    pointer-events: none;
    position: absolute;
    inset: 27% 34%;
    transform-style: preserve-3d;
  }
  .orbit__sphere {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle at 30% 24%,
      #ffecc8 0%,
      #dba677 9%,
      #a64254 28%,
      #741f38 49%,
      #32162b 75%,
      #130f1d 96%
    );
    box-shadow:
      inset -12px -15px 30px rgb(0 0 0 / 0.5),
      inset 3px 3px 8px rgb(255 230 178 / 0.6),
      inset -4px -2px 6px rgb(247 185 126 / 0.45),
      0 38px 45px -22px rgb(10 11 22 / 0.6);
  }
  .orbit__mark {
    position: absolute;
    inset: 20%;
    display: grid;
    place-items: center;
    transform: translateZ(42px) rotateZ(-8deg);
    filter: drop-shadow(0 12px 12px rgb(0 0 0 / 0.4));
  }
  .orbit__mark :global(svg) {
    width: 100%;
    height: auto;
  }
  .orbit__satellite {
    position: absolute;
    width: 13%;
    transform: translateZ(var(--depth, 52px));
    transform-style: preserve-3d;
  }
  .orbit__float {
    position: relative;
    transform-style: preserve-3d;
    border-radius: 24%;
    box-shadow:
      0 14px 24px -8px #050712,
      0 0 25px color-mix(in srgb, var(--satellite-color) 22%, transparent);
  }
  .orbit__float img {
    width: 100%;
    height: auto;
    border-radius: 24%;
    transform: translateZ(9px);
  }
  .orbit__star {
    pointer-events: none;
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #f9d991;
    box-shadow: 0 0 12px #f9d991;
  }
  .orbit__star--one {
    left: 38%;
    top: 21%;
  }
  .orbit__star--two {
    left: 83%;
    top: 71%;
  }
  .orbit__star--three {
    left: 14%;
    top: 35%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .orbit__float {
      animation: satellite-float 7s ease-in-out var(--float-delay) infinite;
    }
    .orbit__ring--one {
      animation: orbit-turn 24s linear infinite;
    }
    .orbit__ring--two {
      animation: orbit-cross 30s linear infinite;
    }
    @keyframes satellite-float {
      50% {
        transform: translateY(-12px) rotate(5deg);
      }
    }
    @keyframes orbit-turn {
      to {
        transform: rotateZ(-28deg) rotateX(66deg) rotateZ(360deg);
      }
    }
    @keyframes orbit-cross {
      to {
        transform: rotateZ(50deg) rotateX(60deg) rotateZ(-360deg);
      }
    }
  }
  .orbit:not([data-running='true']) *,
  .orbit:not([data-running='true']) *::before {
    animation-play-state: paused;
  }

  .orbit__app-name {
    display: block;
    margin-top: 12px;
    color: var(--muted);
    text-align: center;
    font-size: clamp(9px, 1.1vw, 13px);
    font-weight: 600;
    white-space: nowrap;
  }
  .orbit__satellite {
    text-decoration: none;
    border-radius: 24%;
  }
  .orbit__satellite:hover .orbit__app-name {
    color: var(--ink);
  }
  .orbit__satellite:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 10px;
  }
  .orbit__satellite--0 {
    left: 16%;
    top: 15%;
    width: 12%;
  }
  .orbit__satellite--1 {
    left: 69%;
    top: 12%;
    width: 10%;
  }
  .orbit__satellite--2 {
    left: 80%;
    top: 46%;
    width: 12%;
  }
  .orbit__satellite--3 {
    left: 62%;
    top: 74%;
    width: 10%;
  }
  .orbit__satellite--4 {
    left: 27%;
    top: 76%;
    width: 9%;
  }
  .orbit__satellite--5 {
    left: 6%;
    top: 49%;
    width: 10%;
  }
  .orbit__satellite--6 {
    left: 46%;
    top: 4%;
    width: 7%;
  }
  @media (max-width: 560px) {
    .orbit {
      aspect-ratio: 1;
      margin-block: 20px;
    }
    .orbit__core {
      pointer-events: none;
      inset: 34%;
    }
    .orbit__app-name {
      font-size: 9px;
      margin-top: 8px;
    }
    .orbit__satellite--6 {
      width: 11%;
      left: 44%;
    }
    .orbit__satellite {
      min-width: 44px;
    }
  }

  /* The sides sit behind the front artwork in the same 3D space. */
  .orbit__tile-edge {
    position: absolute;
    inset: 1px;
    border-radius: 24%;
    transform: translate3d(3px, 5px, -5px);
    background: linear-gradient(
      135deg,
      #ead9c8,
      color-mix(in srgb, var(--satellite-color) 45%, #151723) 45%,
      #100d19
    );
    box-shadow:
      1px 1px 0 #655967,
      2px 2px 0 #534554,
      3px 3px 0 #403243,
      4px 4px 0 #2e2434;
  }
  .orbit__tile-shine {
    position: absolute;
    inset: 0;
    border-radius: 24%;
    transform: translateZ(10px);
    background: linear-gradient(
      135deg,
      rgb(255 255 255 / 0.38),
      transparent 36%,
      transparent 70%,
      rgb(255 255 255 / 0.14)
    );
    box-shadow: inset 0 1px 1px rgb(255 255 255 / 0.5);
    pointer-events: none;
  }
  .orbit__sheen {
    position: absolute;
    inset: 3%;
    border-radius: 50%;
    background: radial-gradient(ellipse at 30% 20%, rgb(255 245 218 / 0.6), transparent 26%);
    transform: translateZ(3px);
    pointer-events: none;
  }
  .orbit__meridian {
    position: absolute;
    inset: 2%;
    border: 1px solid rgb(255 208 146 / 0.2);
    border-radius: 50%;
    transform: rotateZ(-30deg) rotateY(65deg);
    pointer-events: none;
  }
  .orbit__meridian--two {
    transform: rotateZ(50deg) rotateX(72deg);
  }
  .orbit__particle {
    position: absolute;
    left: var(--px);
    top: var(--py);
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--gold);
    transform: translateZ(var(--depth));
    pointer-events: none;
  }
  .orbit__satellite--0 {
    --depth: 75px;
  }
  .orbit__satellite--1 {
    --depth: 15px;
  }
  .orbit__satellite--2 {
    --depth: 100px;
  }
  .orbit__satellite--4 {
    --depth: 20px;
  }
  .orbit__satellite--6 {
    --depth: -35px;
  }
  .orbit__satellite:hover .orbit__float,
  .orbit__satellite:focus-visible .orbit__float {
    animation-play-state: paused;
  }
  .orbit:focus-within .orbit__float {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: no-preference) {
    .orbit__core {
      pointer-events: none;
      animation: core-breathe 10s ease-in-out infinite;
    }
    .orbit__ring--three {
      animation: orbit-outer 42s linear infinite;
    }
    .orbit__particle {
      animation: particle-drift 6s ease-in-out var(--delay) infinite;
    }
    @keyframes core-breathe {
      50% {
        transform: translateY(-9px) rotateZ(3deg);
      }
    }
    @keyframes orbit-outer {
      to {
        transform: rotateZ(18deg) rotateY(65deg) rotateZ(360deg);
      }
    }
    @keyframes particle-drift {
      50% {
        opacity: 0.25;
        translate: 0 -12px;
      }
    }
  }
  .orbit:not([data-running='true']) * {
    animation-play-state: paused;
  }
  @media (max-width: 560px) {
    .orbit__satellite--0 {
      --depth: 10px;
    }
    .orbit__satellite--2 {
      --depth: 15px;
    }
    .orbit__world {
      perspective: 1200px;
    }
    .orbit__ring {
      pointer-events: none;
      border-width: 1px;
    }
    .orbit__tile-edge {
      box-shadow:
        1px 1px 0 #655967,
        2px 2px 0 #403243;
    }
  }
</style>
