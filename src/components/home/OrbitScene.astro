---
import { getImage } from 'astro:assets';
import { apps } from '../../data/apps';
import { planetAppearance } from '../../data/planet-appearance';
import { appPath } from '../../lib/routes';

const artworkSources = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/planet-artwork/*.png',
  { eager: true },
);

const artwork = await Promise.all(
  apps.map((app) =>
    getImage({
      src: artworkSources[`../../assets/planet-artwork/${app.slug}.png`].default,
      width: 320,
      format: 'webp',
    }),
  ),
);
---

<div class="orbit" data-planet-system data-motion-scene>
  <div class="orbit__arrival">
    <div class="orbit__halo" aria-hidden="true"></div>

    {['back', 'front'].map((side) => (
      <svg
        class={`orbit__belt orbit__belt--${side}`}
        viewBox="0 0 1600 400"
        aria-hidden="true"
        focusable="false"
        preserveAspectRatio="none"
      >
        <defs>
          <linearGradient id={`belt-tone-${side}`} x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" stop-color="#b7804b" stop-opacity="0" />
            <stop offset=".18" stop-color="#c88e59" stop-opacity=".28" />
            <stop offset=".5" stop-color="#f1d3a0" stop-opacity=".48" />
            <stop offset=".82" stop-color="#bc8050" stop-opacity=".28" />
            <stop offset="1" stop-color="#b7804b" stop-opacity="0" />
          </linearGradient>
        </defs>
        <g fill="none" stroke={`url(#belt-tone-${side})`}>
          <ellipse cx="800" cy="200" rx="760" ry="168" stroke-width="35" opacity=".24" />
          <ellipse cx="800" cy="200" rx="695" ry="145" stroke-width="42" opacity=".32" />
          <ellipse cx="800" cy="200" rx="610" ry="119" stroke-width="24" opacity=".38" />
          <ellipse cx="800" cy="200" rx="520" ry="94" stroke-width="15" opacity=".33" />
          <ellipse cx="800" cy="200" rx="760" ry="168" stroke-width="1.5" opacity=".55" />
          <ellipse cx="800" cy="200" rx="655" ry="133" stroke-width="2" opacity=".55" />
          <ellipse cx="800" cy="200" rx="570" ry="107" stroke-width="1.5" opacity=".6" />
        </g>
      </svg>
    ))}
    <div class="orbit__core" aria-hidden="true">
      <div class="orbit__sun">
        <svg viewBox="0 0 64 64" focusable="false">
          <path
            d="M17.5 31h29M32 31v20"
            stroke="#fff"
            stroke-width="11"
            stroke-linecap="round"
            fill="none"
          />
          <path
            d="M32 8.5 47.5 19Q32 22 16.5 19Z"
            fill="#f0c04e"
            stroke="#f0c04e"
            stroke-width="4.5"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    </div>

    <nav class="orbit__planets" aria-label="Explore the app planets">
      {apps.map((app, index) => {
        const appearance = planetAppearance[app.slug];

        return (
          <a
            class={`planet planet--${index}`}
            href={appPath(app)}
            aria-label={`Explore ${app.name}`}
            data-planet
            data-app-slug={app.slug}
            data-track={index}
            data-size={index === 0 ? 1.1 : 1}
            data-track-color={appearance.track}
            style={`--planet-color: ${appearance.base}; --planet-pole: ${appearance.pole}; --planet-glow: ${appearance.glow}; --track-color: ${appearance.track}; --glyph-start: ${appearance.glyphStart}; --glyph-end: ${appearance.glyphEnd}; --artwork-size: ${appearance.artworkSize}%; --art-dx: ${appearance.artOffsetX}%; --art-dy: ${appearance.artOffsetY}%; --planet-k: ${index === 0 ? 1.1 : 1}; --spin-duration: ${9 + index * 2.7}s; --spin-delay: ${index * -2.3}s; --spin-direction: ${index % 2 ? 'reverse' : 'normal'};`}
          >
            <span class="planet__body">
              {['vtts', 'lunarblock'].includes(app.slug) ? (
                <img
                  class="planet__artwork"
                  src={artwork[index].src}
                  alt=""
                  width="160"
                  height="160"
                  loading="eager"
                  decoding="async"
                />
              ) : (
                <span
                  class={`planet__artwork planet__glyph planet__glyph--${app.slug}`}
                  style={`--glyph: url('${artwork[index].src}');`}
                  aria-hidden="true"
                ></span>
              )}
              <span class="planet__light" aria-hidden="true"></span>
              <span class="planet__shade" aria-hidden="true"></span>
            </span>
            <svg class="planet__name" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
              <defs>
                <path id={`planet-name-${app.slug}`} d="M 18 101 A 82 82 0 0 0 182 101" />
              </defs>
              <text>
                <textPath href={`#planet-name-${app.slug}`} startOffset="50%" text-anchor="middle">
                  {app.name}
                </textPath>
              </text>
            </svg>
          </a>
        );
      })}
    </nav>

    <div class="orbit__dust" aria-hidden="true">
      {Array.from({ length: 22 }, (_, i) => (
        <i
          style={`--x: ${6 + ((i * 37) % 88)}%; --y: ${8 + ((i * 23) % 80)}%; --delay: ${i * -0.7}s; --size: ${i % 5 === 0 ? 3 : 2}px;`}
        ></i>
      ))}
    </div>
  </div>
</div>

<script>
  import { initPlanetSystem } from '../../scripts/planet-system';
  initPlanetSystem();
</script>

<style>
  /* The frame takes whatever the screen offers; the engine then picks the camera angle and
     scale that fill it, so the system fits every size and orientation. */
  .orbit {
    --orbit-width: min(100vw - 40px, 2600px);
    position: relative;
    /* Break out of the page container: the universe is allowed to be wider than text. */
    width: var(--orbit-width);
    margin-left: 50%;
    translate: -50% 0;
    height: clamp(
      220px,
      calc(100svh - var(--header-height) - var(--hero-reserve)),
      calc(var(--orbit-width) * var(--orbit-max-height, 1.05))
    );
    flex-shrink: 0;
    isolation: isolate;
    touch-action: pan-y pinch-zoom;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    cursor: grab;
  }
  .orbit[data-dragging='true'] {
    cursor: grabbing;
  }
  .orbit__arrival {
    position: absolute;
    inset: 0;
  }

  /* Soft light pool around the sun; it breathes slowly and fades as the hero scrolls away. */
  .orbit__halo {
    position: absolute;
    left: var(--sun-x, 50%);
    top: var(--sun-y, 48%);
    width: calc(var(--sun-size, 160px) * 4.5);
    max-width: 100%;
    aspect-ratio: 1.6;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(255 214 170 / 0.16),
      rgb(173 70 91 / 0.07) 45%,
      transparent 100%
    );
    opacity: calc(1 - var(--scroll, 0) * 0.8);
    pointer-events: none;
    z-index: 1;
  }
  :global([data-theme='light']) .orbit__halo {
    background: radial-gradient(
      closest-side,
      rgb(240 160 90 / 0.18),
      rgb(173 70 91 / 0.06) 45%,
      transparent 100%
    );
  }

  .orbit__belt {
    position: absolute;
    left: var(--sun-x, 50%);
    top: var(--sun-y, 48%);
    width: 150vw;
    max-width: none;
    height: 37.5vw;
    translate: -50% -50%;
    rotate: -9deg;
    pointer-events: none;
    opacity: 0.8;
  }
  .orbit__belt--back {
    z-index: 6;
    clip-path: inset(0 0 50% 0);
  }
  .orbit__belt--front {
    z-index: 11;
    clip-path: inset(50% 0 0 0);
  }
  :global([data-theme='light']) .orbit__belt {
    opacity: 0.48;
  }
  .orbit__core {
    position: absolute;
    left: var(--sun-x, 50%);
    top: var(--sun-y, 48%);
    width: var(--sun-size, clamp(92px, 20%, 220px));
    aspect-ratio: 1;
    translate: -50% -50%;
    z-index: 10;
    border-radius: 50%;
    pointer-events: auto;
  }
  /* An earth-toned, softly lit planet with a matte mineral surface. */
  .orbit__sun {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    overflow: hidden;
    background: radial-gradient(
      circle at 29% 23%,
      #f4d7a5 0%,
      #d2a367 13%,
      #aa7040 36%,
      #704529 65%,
      #2c1b16 100%
    );
    box-shadow:
      inset 8px 8px 18px rgb(255 224 167 / 0.22),
      inset -18px -18px 30px rgb(24 13 12 / 0.65),
      0 24px 45px -18px rgb(0 0 0 / 0.7);
  }
  .orbit__sun::before {
    position: absolute;
    inset: -25%;
    background: repeating-linear-gradient(
      165deg,
      transparent 0 12%,
      rgb(67 37 25 / 0.2) 14%,
      transparent 22%,
      rgb(243 210 158 / 0.12) 30%,
      transparent 36%
    );
    opacity: 0.65;
    content: '';
  }
  .orbit__sun svg {
    position: absolute;
    z-index: 1;
    inset: 22%;
    width: 56%;
    height: 56%;
    filter: drop-shadow(0 1px 1px rgb(90 14 34 / 0.55))
      drop-shadow(0 3px 10px rgb(110 20 40 / 0.45));
  }

  /* Planets */
  .orbit__planets {
    display: contents;
  }
  .planet {
    --s: 1;
    --depth: 1;
    --light: 315deg;
    position: absolute;
    width: calc(var(--planet-unit, clamp(44px, 5.6vw, 62px)) * var(--planet-k, 1));
    height: calc(var(--planet-unit, clamp(44px, 5.6vw, 62px)) * var(--planet-k, 1));
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    z-index: 20;
    touch-action: pan-y pinch-zoom;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .orbit[data-ready][data-motion='live'] .planet {
    left: 0;
    top: 0;
    will-change: transform, opacity;
  }
  /* With JS, planets wait for the engine so they never jump from the fallback layout. */
  :global(html[data-motion]) .orbit:not([data-ready]) .planet {
    opacity: 0;
  }

  .planet__body {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    overflow: hidden;
    background: radial-gradient(
      circle at 50% 40%,
      color-mix(in srgb, var(--planet-pole) 70%, #fff) 0%,
      var(--planet-color) 50%,
      color-mix(in srgb, var(--planet-color) 58%, #14101b) 100%
    );
    box-shadow: 0 calc(10px * var(--s)) calc(20px * var(--s)) -8px rgb(0 0 0 / 0.6);
    transform: scale(var(--s));
    transition:
      box-shadow 260ms ease,
      scale 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .planet__artwork {
    position: relative;
    z-index: 1;
    width: var(--artwork-size);
    height: var(--artwork-size);
    object-fit: contain;
    pointer-events: none;
    filter: drop-shadow(0 3px 2px rgb(15 7 22 / 0.45));
    translate: var(--art-dx, 0) var(--art-dy, 0);
  }
  .planet__glyph {
    background: linear-gradient(165deg, var(--glyph-start) 12%, var(--glyph-end) 85%);
    mask: var(--glyph) center / contain no-repeat;
    -webkit-mask: var(--glyph) center / contain no-repeat;
  }
  /* Day side faces the sun: the whole light layer rotates with --light. */
  .planet__light {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 6%, rgb(255 244 228 / 0.5), transparent 46%),
      linear-gradient(180deg, transparent 38%, rgb(5 3 12 / 0.32) 100%);
    transform: rotate(var(--light));
    pointer-events: none;
  }
  /* Depth fog: planets on the far side of the sun are a little darker. */
  .planet__shade {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #05030c;
    opacity: calc((1 - var(--depth)) * 0.07);
    pointer-events: none;
  }
  .planet:hover .planet__body,
  .planet:focus-visible .planet__body {
    scale: 1.14;
    box-shadow:
      0 0 28px var(--planet-glow),
      0 14px 24px -8px rgb(0 0 0 / 0.7);
  }
  .planet__name {
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(185% * var(--s));
    max-width: none;
    height: auto;
    translate: -50% -50%;
    overflow: visible;
    pointer-events: none;
    opacity: calc((0.9 + (var(--depth) + 1) * 0.05) * var(--label, 1));
  }
  .planet__name text {
    fill: var(--ink);
    stroke: var(--paper);
    stroke-width: 3px;
    paint-order: stroke fill;
    stroke-linejoin: round;
    font: 600 21px var(--font);
    letter-spacing: 0.01em;
  }
  .planet:hover .planet__name,
  .planet:focus-visible .planet__name {
    opacity: 1;
  }
  .planet:focus-visible {
    outline: none;
  }
  .planet:focus-visible .planet__body {
    outline: 2px solid var(--focus);
    outline-offset: 5px;
  }
  .planet:focus-visible {
    z-index: 100 !important;
    opacity: 1 !important;
  }

  /* Separated and reachable both without JavaScript and with reduced motion. */
  .orbit[data-motion='still'] .planet {
    z-index: 20;
  }
  .orbit[data-motion='still'] .planet__name {
    opacity: 1;
  }
  .orbit[data-motion='still'] {
    cursor: default;
  }
  /* Fallback constellation for browsers without JavaScript. */
  .planet--0 {
    left: 36%;
    top: 26%;
  }
  .planet--1 {
    left: 65%;
    top: 28%;
  }
  .planet--2 {
    left: 78%;
    top: 46%;
  }
  .planet--3 {
    left: 68%;
    top: 68%;
  }
  .planet--4 {
    left: 32%;
    top: 68%;
  }
  .planet--5 {
    left: 18%;
    top: 48%;
  }
  .planet--6 {
    left: 50%;
    top: 12%;
  }

  .orbit__dust {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .orbit__dust i {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 6px var(--gold);
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='off'])) .orbit__core {
      animation: sun-arrival 1100ms cubic-bezier(0.34, 1.4, 0.64, 1) both;
    }
    :global(html:not([data-motion='off'])) .orbit__halo,
    :global(html:not([data-motion='off'])) .orbit__dust {
      animation: fade-in 1600ms ease 200ms both;
    }
    .orbit__sun::before {
      animation: sun-churn 140s linear infinite;
    }
    @keyframes sun-churn {
      to {
        rotate: 360deg;
      }
    }
    .planet__artwork {
      animation: planet-drift var(--spin-duration) ease-in-out var(--spin-delay) infinite
        var(--spin-direction);
    }
    .orbit__dust i {
      animation: dust-twinkle 5s ease-in-out var(--delay) infinite;
    }
    /* A slow sway around the optical centre: alive, but never off-centre. */
    @keyframes planet-drift {
      0%,
      100% {
        rotate: -3deg;
      }
      50% {
        rotate: 3deg;
      }
    }
    @keyframes sun-arrival {
      from {
        opacity: 0;
        scale: 0.4;
      }
    }
    @keyframes fade-in {
      from {
        opacity: 0;
      }
    }
    @keyframes dust-twinkle {
      50% {
        opacity: 0.12;
      }
    }
  }

  .orbit:not([data-running='true']) * {
    animation-play-state: paused;
  }

  @media (max-width: 560px) {
    .orbit {
      --orbit-width: calc(100vw - 12px);
    }
    .orbit__halo {
      width: 90%;
      aspect-ratio: 1.2;
    }
  }
</style>
