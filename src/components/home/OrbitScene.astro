---
import { Image } from 'astro:assets';
import Logo from '../ui/Logo.astro';
import { apps } from '../../data/apps';
---

<!-- Decorative twin of the accessible, linked app dock directly below the hero. -->
<div class="orbit" data-tilt data-tilt-strength="16" data-motion-scene aria-hidden="true">
  <div class="orbit__grid"></div>
  <div class="orbit__halo"></div>
  <div class="orbit__world">
    <div class="orbit__ring orbit__ring--one"></div>
    <div class="orbit__ring orbit__ring--two"></div>
    <div class="orbit__ring orbit__ring--three"></div>
    <div class="orbit__core">
      <div class="orbit__sphere"></div>
      <div class="orbit__mark">
        <Logo size={108} />
      </div>
    </div>
    {apps.map((app, index) => (
      <div
        class={`orbit__satellite orbit__satellite--${index}`}
        style={`--float-delay: ${index * -1.3}s; --satellite-color: ${app.accent}`}
      >
        <div class="orbit__float">
          <Image src={app.icon} alt="" width={64} height={64} densities={[1, 2]} loading="eager" />
        </div>
      </div>
    ))}
    <span class="orbit__star orbit__star--one"></span>
    <span class="orbit__star orbit__star--two"></span>
    <span class="orbit__star orbit__star--three"></span>
  </div>
  <span class="orbit__signature">PHT / CREATIVE UNIVERSE</span>
  <span class="orbit__coordinate">{String(apps.length).padStart(2, '0')} APPS · ONE MAKER</span>
</div>

<style>
  .orbit {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    isolation: isolate;
    border: 1px solid rgb(240 192 78 / 0.25);
    border-radius: 50% 50% 28px 28px;
    background: radial-gradient(ellipse at 50% 42%, #5c283a 0%, #241c2c 42%, #111722 76%);
    box-shadow:
      0 35px 65px -35px rgb(30 12 25 / 0.65),
      inset 0 1px 0 rgb(255 255 255 / 0.15);
    container-type: inline-size;
  }
  .orbit__grid {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: linear-gradient(transparent 25%, #000);
  }
  .orbit__halo {
    position: absolute;
    inset: 15%;
    border: 1px solid rgb(240 192 78 / 0.12);
    border-radius: 50%;
    box-shadow:
      0 0 0 35px rgb(240 192 78 / 0.025),
      0 0 0 70px rgb(240 192 78 / 0.02);
  }
  .orbit__world {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: perspective(950px) rotateX(var(--tilt-x, -6deg)) rotateY(var(--tilt-y, -10deg));
    transition: transform 650ms var(--ease);
  }
  .orbit[data-pointer-active] .orbit__world {
    transition-duration: 160ms;
  }
  .orbit__ring {
    position: absolute;
    inset: 13%;
    border: 1px solid rgb(240 192 78 / 0.7);
    border-radius: 50%;
    transform-style: preserve-3d;
    box-shadow:
      0 0 15px rgb(240 192 78 / 0.08),
      inset 0 0 15px rgb(240 192 78 / 0.08);
  }
  .orbit__ring::before {
    position: absolute;
    top: 50%;
    left: -4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ffdf91;
    box-shadow: 0 0 18px #e7ab52;
    content: '';
  }
  .orbit__ring--one {
    transform: rotateZ(-28deg) rotateX(66deg);
  }
  .orbit__ring--two {
    inset: 18%;
    border-color: rgb(229 160 189 / 0.6);
    transform: rotateZ(50deg) rotateX(60deg);
  }
  .orbit__ring--three {
    inset: 9%;
    border-style: dashed;
    border-color: rgb(255 255 255 / 0.15);
    transform: rotateZ(18deg) rotateY(65deg);
  }
  .orbit__core {
    position: absolute;
    inset: 28%;
    transform-style: preserve-3d;
  }
  .orbit__sphere {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle at 30% 24%,
      #ffe9b0 0%,
      #d9a35e 12%,
      #9e3e4d 35%,
      #4c1c30 62%,
      #180f22 82%
    );
    box-shadow:
      inset -12px -15px 30px rgb(0 0 0 / 0.5),
      inset 3px 3px 8px rgb(255 230 178 / 0.6),
      0 25px 35px -10px #0a0b16;
  }
  .orbit__mark {
    position: absolute;
    inset: 23%;
    display: grid;
    place-items: center;
    transform: translateZ(42px) rotateZ(-8deg);
    filter: drop-shadow(0 12px 12px rgb(0 0 0 / 0.4));
  }
  .orbit__mark :global(svg) {
    width: 100%;
    height: auto;
  }
  .orbit__satellite {
    position: absolute;
    width: 13%;
    transform: translateZ(52px);
  }
  .orbit__float {
    border-radius: 24%;
    box-shadow:
      0 14px 24px -8px #050712,
      0 0 25px color-mix(in srgb, var(--satellite-color) 22%, transparent);
  }
  .orbit__float img {
    width: 100%;
    height: auto;
    border-radius: 24%;
  }
  .orbit__satellite--0 {
    left: 16%;
    top: 17%;
    rotate: -14deg;
    width: 16%;
  }
  .orbit__satellite--1 {
    left: 69%;
    top: 15%;
    rotate: 13deg;
  }
  .orbit__satellite--2 {
    left: 78%;
    top: 45%;
    rotate: 9deg;
    width: 15%;
  }
  .orbit__satellite--3 {
    left: 58%;
    top: 73%;
    rotate: -10deg;
  }
  .orbit__satellite--4 {
    left: 24%;
    top: 73%;
    rotate: 8deg;
    width: 11%;
  }
  .orbit__satellite--5 {
    left: 6%;
    top: 49%;
    rotate: -12deg;
  }
  .orbit__satellite--6 {
    left: 45%;
    top: 8%;
    rotate: 7deg;
    width: 9%;
  }
  .orbit__star {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #f9d991;
    box-shadow: 0 0 12px #f9d991;
  }
  .orbit__star--one {
    left: 38%;
    top: 21%;
  }
  .orbit__star--two {
    left: 83%;
    top: 71%;
  }
  .orbit__star--three {
    left: 14%;
    top: 35%;
  }
  .orbit__signature,
  .orbit__coordinate {
    position: absolute;
    bottom: 20px;
    color: #bea8ad;
    font: 9px var(--font-mono);
    letter-spacing: 0.1em;
  }
  .orbit__signature {
    left: 24px;
  }
  .orbit__coordinate {
    right: 24px;
    color: #e6bf76;
  }
  @media (prefers-reduced-motion: no-preference) {
    .orbit__float {
      animation: satellite-float 7s ease-in-out var(--float-delay) infinite;
    }
    .orbit__ring--one {
      animation: orbit-turn 24s linear infinite;
    }
    .orbit__ring--two {
      animation: orbit-cross 30s linear infinite;
    }
    @keyframes satellite-float {
      50% {
        transform: translateY(-12px) rotate(5deg);
      }
    }
    @keyframes orbit-turn {
      to {
        transform: rotateZ(-28deg) rotateX(66deg) rotateZ(360deg);
      }
    }
    @keyframes orbit-cross {
      to {
        transform: rotateZ(50deg) rotateX(60deg) rotateZ(-360deg);
      }
    }
  }
  .orbit:not([data-running='true']) *,
  .orbit:not([data-running='true']) *::before {
    animation-play-state: paused;
  }
  @media (max-width: 400px) {
    .orbit__coordinate {
      display: none;
    }
  }
</style>
