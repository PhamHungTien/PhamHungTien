---
import { getImage } from 'astro:assets';
import { apps } from '../../data/apps';
import { planetAppearance } from '../../data/planet-appearance';
import { appPath } from '../../lib/routes';
const artworkSources = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/planet-artwork/*.png',
  { eager: true },
);
const artwork = await Promise.all(
  apps.map((app) =>
    getImage({
      src: artworkSources[`../../assets/planet-artwork/${app.slug}.png`].default,
      width: 320,
      format: 'webp',
    }),
  ),
);
const phases = [-135, -70, 10, 65, 140, 195, 265];
---

<div class="orbit" data-planet-system data-motion-scene>
  <div class="orbit__arrival">
    <svg class="orbit__paths" viewBox="0 0 1000 690" aria-hidden="true" data-orbit-paths>
      <ellipse cx="500" cy="345" rx="350" ry="180" />
      <ellipse cx="500" cy="345" rx="400" ry="220" />
      <ellipse cx="500" cy="345" rx="300" ry="140" />
    </svg>
    <div class="orbit__core" aria-hidden="true">
      <div class="orbit__sun">
        <svg viewBox="0 0 64 64" focusable="false">
          <path
            d="M17.5 31h29M32 31v20"
            stroke="#fff"
            stroke-width="11"
            stroke-linecap="round"
            fill="none"
          />
          <path
            d="M32 8.5 47.5 19Q32 22 16.5 19Z"
            fill="#f0c04e"
            stroke="#f0c04e"
            stroke-width="4.5"
            stroke-linejoin="round"
          />
        </svg>
      </div>
      <div class="orbit__corona"></div>
    </div>
    <nav class="orbit__planets" aria-label="Explore the app planets">
      {apps.map((app, index) => (
        <a
          class={`planet planet--${index}`}
          href={appPath(app)}
          aria-label={`Explore ${app.name}`}
          data-planet
          data-phase={phases[index]}
          data-track={index % 3}
          data-period={38 + index * 5}
          style={`--planet-color: ${planetAppearance[app.slug].base}; --planet-pole: ${planetAppearance[app.slug].pole}; --glyph-start: ${planetAppearance[app.slug].glyphStart}; --glyph-end: ${planetAppearance[app.slug].glyphEnd}; --artwork-size: ${planetAppearance[app.slug].artworkSize}%; --planet-size: ${index === 0 ? 10.8 : 10}%;`}
        >
          <span class="planet__body">
            {['vtts', 'lunarblock'].includes(app.slug) ? (
              <img
                class="planet__artwork"
                src={artwork[index].src}
                alt=""
                width="160"
                height="160"
                loading="eager"
              />
            ) : (
              <span
                class={`planet__artwork planet__glyph planet__glyph--${app.slug}`}
                style={`--glyph: url('${artwork[index].src}');`}
                aria-hidden="true"
              ></span>
            )}
            <span class="planet__atmosphere" aria-hidden="true"></span>
            <span class="planet__light" aria-hidden="true"></span>
          </span>
          <span class="planet__name">{app.name}</span>
        </a>
      ))}
    </nav>
    <div class="orbit__dust" aria-hidden="true">
      {Array.from({ length: 18 }, (_, i) => (
        <i
          style={`--x: ${8 + ((i * 37) % 84)}%; --y: ${12 + ((i * 23) % 72)}%; --delay: ${i * -0.7}s;`}
        ></i>
      ))}
    </div>
    <p class="orbit__hint">
      Seven apps. One little universe. <span class="orbit__swipe-hint">Swipe to orbit.</span>
    </p>
  </div>
</div>

<script>
  import { initPlanetSystem } from '../../scripts/planet-system';
  initPlanetSystem();
</script>

<style>
  .orbit {
    position: relative;
    width: min(
      100%,
      1080px,
      calc((100svh - var(--header-height) - var(--hero-reserve)) * var(--orbit-ratio))
    );
    aspect-ratio: var(--orbit-ratio);
    flex-shrink: 0;
    margin-inline: auto;
    isolation: isolate;
    touch-action: pan-y pinch-zoom;
    user-select: none;
  }
  .orbit__swipe-hint {
    display: none;
  }
  @media (pointer: coarse) {
    .orbit__swipe-hint {
      display: inline;
    }
  }
  .orbit__arrival {
    position: absolute;
    inset: 0;
  }
  .orbit__paths {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .orbit__paths :global(path),
  .orbit__paths ellipse {
    fill: none;
    stroke: color-mix(in srgb, var(--gold) 38%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .orbit__paths :global(path:nth-child(2)) {
    stroke: color-mix(in srgb, var(--brand) 25%, transparent);
  }
  .orbit__paths :global(path:nth-child(3)) {
    stroke-dasharray: 2 7;
    stroke: color-mix(in srgb, var(--muted) 30%, transparent);
  }
  .orbit__core {
    position: absolute;
    left: 50%;
    top: 47%;
    width: 26%;
    aspect-ratio: 1;
    translate: -50% -50%;
    z-index: 10;
    border-radius: 50%;
  }
  .orbit__sun {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle at 28% 22%,
      #ffeaca,
      #dca47b 9%,
      #ad465b 28%,
      #751f3a 48%,
      #33162c 74%,
      #130f1d 98%
    );
    box-shadow:
      inset 3px 3px 8px rgb(255 232 190 / 0.65),
      inset -6px -4px 14px #110a1b,
      0 35px 40px -25px rgb(20 10 24 / 0.7);
  }
  .orbit__sun svg {
    position: absolute;
    inset: 22%;
    width: 56%;
    height: 56%;
    transform: rotate(-5deg);
    filter: drop-shadow(0 7px 3px rgb(37 10 27 / 0.4));
  }
  .orbit__corona {
    position: absolute;
    inset: -5%;
    border: 1px solid color-mix(in srgb, var(--gold) 24%, transparent);
    border-radius: 50%;
    box-shadow: 0 0 32px color-mix(in srgb, var(--gold) 8%, transparent);
  }
  /* display:contents keeps planets and sun in a single depth-sorting context. */
  .orbit__planets {
    display: contents;
  }
  .planet {
    position: absolute;
    left: 50%;
    top: 47%;
    width: var(--planet-size);
    min-width: 44px;
    aspect-ratio: 1;
    margin: 0;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    z-index: 12;
    touch-action: pan-y pinch-zoom;
  }
  .planet__body {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: radial-gradient(
      circle at 30% 25%,
      color-mix(in srgb, var(--planet-pole) 60%, #fff) 0%,
      color-mix(in srgb, var(--planet-pole) 85%, #fff) 16%,
      var(--planet-color) 48%,
      color-mix(in srgb, var(--planet-color) 28%, #06040a) 95%
    );
    box-shadow:
      inset -9px -10px 18px rgb(0 0 0 / 0.65),
      inset 2px 2px 5px rgb(255 255 255 / 0.5),
      0 16px 20px -12px rgb(0 0 0 / 0.6);
  }
  .planet__artwork {
    width: var(--artwork-size);
    height: var(--artwork-size);
    object-fit: contain;
    pointer-events: none;
    filter: drop-shadow(2px 5px 2px rgb(15 7 22 / 0.5));
    transform: rotate(-5deg);
  }
  .planet__glyph {
    background: linear-gradient(165deg, var(--glyph-start) 12%, var(--glyph-end) 85%);
    mask: var(--glyph) center / contain no-repeat;
  }
  .planet__light {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 28% 18%, rgb(255 255 255 / 0.3), transparent 25%),
      linear-gradient(140deg, transparent 55%, rgb(6 7 19 / 0.4));
    pointer-events: none;
  }
  .planet__atmosphere {
    position: absolute;
    inset: -3%;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--planet-color) 55%, #fff);
    opacity: 0.5;
    pointer-events: none;
  }
  .planet__name {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    translate: -50% 0;
    color: var(--muted);
    font-size: clamp(10px, 1.1vw, 13px);
    font-weight: 600;
    white-space: nowrap;
    padding: 2px 6px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
  }
  .planet:hover .planet__name,
  .planet:focus-visible .planet__name {
    color: var(--ink);
  }
  .planet:hover .planet__atmosphere,
  .planet:focus-visible .planet__atmosphere {
    opacity: 1;
    border-width: 2px;
  }
  .planet:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 8px;
    z-index: 1000 !important;
  }
  /* No-JS and reduced-motion visitors receive a composed, fully linked constellation. */
  .planet--0 {
    left: 20%;
    top: 22%;
  }
  .planet--1 {
    left: 72%;
    top: 19%;
  }
  .planet--2 {
    left: 85%;
    top: 53%;
  }
  .planet--3 {
    left: 65%;
    top: 77%;
  }
  .planet--4 {
    left: 30%;
    top: 77%;
  }
  .planet--5 {
    left: 12%;
    top: 51%;
  }
  .planet--6 {
    left: 46%;
    top: 10%;
  }
  .orbit__dust {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .orbit__dust i {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: var(--gold);
    opacity: 0.6;
  }
  .orbit__hint {
    position: absolute;
    bottom: 0;
    width: 100%;
    text-align: center;
    color: var(--muted);
    font: 11px var(--font-mono);
    letter-spacing: 0.08em;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='off'])) .orbit__arrival {
      animation: universe-arrival 1400ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .orbit__corona {
      animation: corona-breathe 6s ease-in-out infinite;
    }
    .orbit__dust i {
      animation: dust-twinkle 5s ease-in-out var(--delay) infinite;
    }
    @keyframes universe-arrival {
      from {
        opacity: 0.2;
        transform: scale(0.78) rotate(-9deg);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes corona-breathe {
      50% {
        transform: scale(1.05);
        opacity: 0.4;
      }
    }
    @keyframes dust-twinkle {
      50% {
        opacity: 0.15;
      }
    }
  }
  .orbit:not([data-running='true']) * {
    animation-play-state: paused;
  }
  @media (max-width: 560px) {
    .orbit__core {
      width: 28%;
    }
    .planet {
      width: 12%;
    }
    .planet__name {
      font-size: 9px;
      top: calc(100% + 7px);
    }
    .orbit__hint {
      font-size: 9px;
    }
  }
  @media (max-height: 500px) and (min-width: 480px) {
    .orbit__hint {
      display: none;
    }
    .planet__name {
      font-size: 9px;
      top: calc(100% + 5px);
    }
  }
</style>
