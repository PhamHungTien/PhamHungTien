---
import { Image } from 'astro:assets';
import { ArrowDown } from '@lucide/astro';
import BrandIcon from '../ui/BrandIcon.astro';
import OrbitScene from './OrbitScene.astro';
import type { Locale as Lang } from '../../i18n/locales';
import { apps } from '../../data/apps';
import { SITE } from '../../data/site';
import { t } from '../../lib/i18n';
import { appPath } from '../../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero__intro">
    <div class="hero__copy">
      <p class="hero__eyebrow">
        <span></span> PHẠM HÙNG TIẾN <span class="hero__eyebrow-divider">/</span>{' '}
        {lang === 'vi'
          ? 'NHÀ PHÁT TRIỂN ĐỘC LẬP'
          : lang === 'fr'
            ? 'DÉVELOPPEUR INDÉPENDANT'
            : lang === 'ja'
              ? '個人開発者'
              : 'INDEPENDENT DEVELOPER'}
      </p>
      <h1 id="hero-title">{t(lang, 'home.headline')}</h1>
      <p class="hero__lead">{t(lang, 'home.lead')}</p>
      <div class="hero__actions">
        <a class="button button--primary" href="#apps">
          {t(lang, 'home.cta')}
          <ArrowDown size={18} aria-hidden="true" />
        </a>
        <a
          class="button button--secondary"
          href={SITE.github}
          target="_blank"
          rel="noopener noreferrer me"
        >
          <BrandIcon name="github" />
          GitHub
        </a>
        <a
          class="button button--secondary"
          href={SITE.youtube}
          target="_blank"
          rel="noopener noreferrer me"
        >
          <BrandIcon name="youtube" />
          YouTube
        </a>
      </div>
    </div>
    <OrbitScene />
  </div>

  <!-- Every real app remains directly accessible by keyboard and touch. -->
  <ul class="dock" role="list" aria-label={t(lang, 'home.dock')}>
    {apps.map((app, index) => (
      <li style={`--i: ${index}`}>
        <a href={appPath(app, lang)}>
          <Image src={app.icon} alt="" width={88} height={88} densities={[1, 2]} loading="eager" />
          <span>{app.name}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(40px, 6vw, 80px);
  }

  .hero__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }
  .hero__copy {
    position: relative;
    z-index: 1;
  }
  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    margin-bottom: 24px;
    color: var(--muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.09em;
  }
  .hero__eyebrow > span:first-child {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--brand) 10%, transparent);
  }
  .hero__eyebrow-divider {
    color: var(--line-strong);
  }
  @media (max-width: 900px) {
    .hero__intro {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__intro > :global(.orbit) {
      width: min(480px, 90%);
      margin-inline: auto;
    }
  }

  /* A soft maroon-and-gold glow behind the headline. Gradients only (no blur filter),
     drifting on the compositor, so it costs nothing on the main thread. */
  .hero::before {
    position: absolute;
    z-index: -1;
    inset: -160px -12% auto;
    height: 760px;
    background:
      radial-gradient(
        38% 46% at 22% 38%,
        color-mix(in srgb, var(--brand) 16%, transparent),
        transparent 70%
      ),
      radial-gradient(
        30% 40% at 70% 28%,
        color-mix(in srgb, var(--gold) 20%, transparent),
        transparent 70%
      ),
      radial-gradient(
        34% 38% at 52% 70%,
        color-mix(in srgb, var(--brand) 8%, transparent),
        transparent 72%
      );
    content: '';
    pointer-events: none;
  }

  h1 {
    padding-block: 0.06em;
    max-width: 16ch;
    font-size: clamp(40px, 5.2vw, 70px);
    font-weight: 700;
    line-height: 1.12;
    text-wrap: balance;
    letter-spacing: -0.045em;
  }

  .hero__lead {
    max-width: 34em;
    margin-top: 20px;
    color: var(--muted);
    font-size: clamp(18px, 1.9vw, 21px);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: 36px;
  }

  .dock {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: clamp(8px, 2vw, 28px);
    margin-top: clamp(40px, 6vw, 72px);
    padding: clamp(20px, 3vw, 32px) clamp(16px, 3vw, 40px) clamp(16px, 2vw, 24px);
    border: 1px solid var(--line);
    border-radius: 32px;
    background: var(--surface);
    box-shadow: var(--shadow-media);
  }

  .dock a {
    display: grid;
    justify-items: center;
    gap: 12px;
    border-radius: 16px;
    text-align: center;
  }

  .dock img {
    width: 100%;
    max-width: 88px;
    aspect-ratio: 1;
    border-radius: var(--r-icon);
    box-shadow: var(--shadow-icon);
    transition: transform 220ms var(--ease);
  }

  .dock span {
    max-width: 100%;
    overflow: hidden;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Dock magnification: the hovered icon rises and grows, its neighbours follow. */
  @media (hover: hover) and (pointer: fine) {
    .dock img {
      transition: transform 420ms var(--spring);
    }

    .dock li:hover img {
      transform: translateY(-12px) scale(1.14);
    }

    .dock li:has(+ li:hover) img,
    .dock li:hover + li img {
      transform: translateY(-5px) scale(1.06);
    }
  }

  .dock a:active img {
    transform: scale(0.94);
  }

  .dock a:hover span {
    color: var(--ink);
  }

  .hero__actions .button--primary :global(svg) {
    transition: transform 300ms var(--spring);
  }

  .hero__actions .button--primary:hover :global(svg) {
    transform: translateY(3px);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Entrance: headline, lead and actions settle in one after another. The headline
       starts nearly (not fully) transparent so it still counts as painted for LCP. */
    h1,
    .hero__lead,
    .hero__actions {
      animation: hero-in 900ms var(--ease) both;
    }

    .hero__lead {
      animation-delay: 90ms;
    }

    .hero__actions {
      animation-delay: 180ms;
    }

    @keyframes hero-in {
      from {
        opacity: 1;
        transform: translateY(22px);
      }
    }

    .dock li {
      animation: dock-rise 760ms var(--spring) both;
      animation-delay: calc(260ms + var(--i) * 60ms);
    }

    @keyframes dock-rise {
      from {
        opacity: 0;
        transform: translateY(26px) scale(0.92);
      }
    }
  }

  @media (max-width: 720px) {
    .dock {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      row-gap: 20px;
      border-radius: 24px;
    }

    .dock span {
      font-size: 12px;
      white-space: normal;
      text-wrap: balance;
    }
  }

  @media (max-width: 560px) {
    .hero__actions .button {
      flex: 1 1 auto;
    }
  }
</style>
