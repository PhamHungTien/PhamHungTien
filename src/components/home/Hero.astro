---
import { ArrowDown } from '@lucide/astro';
import BrandIcon from '../ui/BrandIcon.astro';
import OrbitScene from './OrbitScene.astro';
import type { Locale as Lang } from '../../i18n/locales';
import { SITE } from '../../data/site';
import { t } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="hero container" aria-labelledby="hero-title">
  <h1 id="hero-title" class="sr-only">
    Phạm Hùng Tiến — independent apps for Apple devices
  </h1>
  <OrbitScene />
  <div class="hero__actions">
    <a class="button button--primary" href="#apps">
      {t(lang, 'home.cta')}
      <ArrowDown size={18} aria-hidden="true" />
    </a>
    <a class="hero__social" href={SITE.github} target="_blank" rel="noopener noreferrer me">
      <BrandIcon name="github" /> GitHub
    </a>
    <a class="hero__social" href={SITE.youtube} target="_blank" rel="noopener noreferrer me">
      <BrandIcon name="youtube" /> YouTube
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(16px, 3vh, 40px);
  }
  .hero__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 20px 28px;
    margin-top: 12px;
  }
  .hero__social {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
  }
  .hero__social:hover {
    color: var(--ink);
  }
  .hero__actions .button--primary :global(svg) {
    transition: transform 300ms var(--ease);
  }
  .hero__actions .button--primary:hover :global(svg) {
    transform: translateY(3px);
  }
  @media (max-width: 560px) {
    .hero__actions {
      gap: 12px 24px;
    }
    .hero__actions .button {
      flex-basis: 100%;
      max-width: 280px;
      margin-inline: 20%;
    }
  }
</style>
