---
import { Image } from 'astro:assets';
import { ArrowDown } from '@lucide/astro';
import BrandIcon from '../ui/BrandIcon.astro';
import type { Lang } from '../../data/types';
import { apps } from '../../data/apps';
import { SITE } from '../../data/site';
import { t } from '../../lib/i18n';
import { appPath } from '../../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="hero container" aria-labelledby="hero-title">
  <h1 id="hero-title">{t(lang, 'home.role')}</h1>
  <p class="hero__lead">{t(lang, 'home.lead')}</p>
  <div class="hero__actions">
    <a class="button button--primary" href="#apps">
      {t(lang, 'home.cta')}
      <ArrowDown size={18} aria-hidden="true" />
    </a>
    <a
      class="button button--secondary"
      href={SITE.github}
      target="_blank"
      rel="noopener noreferrer me"
    >
      <BrandIcon name="github" />
      GitHub
    </a>
  </div>

  <!-- The one expressive element on the page: every real app icon, shelved and linked. -->
  <ul class="dock" role="list" aria-label={t(lang, 'home.dock')}>
    {apps.map((app, index) => (
      <li style={`--i: ${index}`}>
        <a href={appPath(app, lang)}>
          <Image src={app.icon} alt="" width={88} height={88} densities={[1, 2]} loading="eager" />
          <span>{app.name}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero {
    padding-top: clamp(56px, 10vw, 128px);
  }

  h1 {
    padding-block: 0.06em;
    max-width: 16ch;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 700;
    line-height: 1.12;
    text-wrap: balance;
    letter-spacing: -0.045em;
  }

  .hero__lead {
    max-width: 34em;
    margin-top: 20px;
    color: var(--muted);
    font-size: clamp(18px, 1.9vw, 21px);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: 36px;
  }

  .dock {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: clamp(8px, 2vw, 28px);
    margin-top: clamp(56px, 8vw, 96px);
    padding: clamp(20px, 3vw, 32px) clamp(16px, 3vw, 40px) clamp(16px, 2vw, 24px);
    border: 1px solid var(--line);
    border-radius: 32px;
    background: var(--surface);
    box-shadow: var(--shadow-media);
  }

  .dock a {
    display: grid;
    justify-items: center;
    gap: 12px;
    border-radius: 16px;
    text-align: center;
  }

  .dock img {
    width: 100%;
    max-width: 88px;
    aspect-ratio: 1;
    border-radius: var(--r-icon);
    box-shadow: var(--shadow-icon);
    transition: transform 220ms var(--ease);
  }

  .dock span {
    max-width: 100%;
    overflow: hidden;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dock a:hover img {
    transform: translateY(-6px);
  }

  .dock a:hover span {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .dock li {
      animation: dock-rise 620ms var(--ease) both;
      animation-delay: calc(120ms + var(--i) * 55ms);
    }

    @keyframes dock-rise {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
    }
  }

  @media (max-width: 720px) {
    .dock {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      row-gap: 20px;
      border-radius: 24px;
    }

    .dock span {
      font-size: 12px;
      white-space: normal;
      text-wrap: balance;
    }
  }

  @media (max-width: 560px) {
    .hero__actions .button {
      flex: 1 1 auto;
    }
  }
</style>
