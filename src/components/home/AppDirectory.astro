---
import { getAppCopy } from '../../lib/app-copy';
import { Image } from 'astro:assets';
import { Search } from '@lucide/astro';
import type { Locale as Lang } from '../../i18n/locales';
import { apps } from '../../data/apps';
import { t } from '../../lib/i18n';
import { appPath } from '../../lib/routes';
import { PLATFORM_GROUPS, platformGroupsOf, storesOf } from '../../data/platforms';
import { storeMedia } from '../../lib/store-media';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// Only platforms that at least one app supports get a filter button.
const groups = PLATFORM_GROUPS.filter((group) =>
  apps.some((app) => platformGroupsOf(app.platforms).includes(group)),
);
// Rows of three on wide screens and two below: the last card of an uneven row spans it.
const lastOf = (index: number) => {
  const remaining = apps.length - index;
  return {
    'data-wide': apps.length % 3 === 1 && remaining === 1 ? '' : undefined,
    'data-half': apps.length % 3 === 2 && remaining <= 2 ? '' : undefined,
    'data-odd': apps.length % 2 === 1 && remaining === 1 ? '' : undefined,
  };
};
---

<section class="apps container section" id="apps" aria-labelledby="apps-heading" data-app-directory>
  <div class="section-head">
    <div>
      <h2 id="apps-heading">{t(lang, 'home.apps.title')}</h2>
      <p>{t(lang, 'home.apps.lead')}</p>
    </div>
    <div class="apps__tools" data-app-tools data-pending>
      <div class="segmented" role="group" aria-label={t(lang, 'home.apps.filter')} data-lens>
        <button type="button" aria-pressed="true" data-platform="">
          {t(lang, 'home.apps.all')}
        </button>
        {groups.map((group) => (
          <button type="button" aria-pressed="false" data-platform={group.id}>
            {group.label}
          </button>
        ))}
      </div>
      <label class="search-field glass">
        <Search size={17} aria-hidden="true" />
        <span class="sr-only">{t(lang, 'home.apps.search')}</span>
        <input
          type="search"
          placeholder={t(lang, 'home.apps.search')}
          autocomplete="off"
          data-app-search
          aria-controls="app-results"
        />
      </label>
    </div>
  </div>

  <div class="apps__summary">
    <p
      class="apps__count"
      role="status"
      data-app-count
      data-one={t(lang, 'home.apps.count.one')}
      data-other={t(lang, 'home.apps.count.other')}
    >
      {apps.length} {t(lang, 'home.apps.count.other')}
    </p>

    <button class="text-link apps__reset" type="button" hidden data-app-reset>
      {t(lang, 'home.apps.clear')}
    </button>
  </div>

  <ul id="app-results" class="app-list" role="list">
    {apps.map((app, index) => {
      const art = storeMedia(app.slug, lang).search;
      const { category, description } = getAppCopy(app, lang);
      return (
        <li
          data-app
          data-platforms={platformGroupsOf(app.platforms)
            .map((group) => group.id)
            .join(' ')}
          data-search={`${app.name} ${category} ${description}`.toLowerCase()}
          {...lastOf(index)}
        >
          <a class="app-card glass-card" href={appPath(app, lang)} style={`--app: ${app.accent}`}>
            <div class="app-card__art">
              {art && (
                <Image
                  src={art}
                  alt=""
                  format="webp"
                  width={Math.min(art.width, 1200)}
                  widths={[480, 800, 1200].filter((w) => w <= art.width)}
                  sizes="(max-width: 767px) 46vw, (max-width: 1099px) 46vw, 384px"
                  loading={index < 3 ? 'eager' : 'lazy'}
                />
              )}
            </div>
            <div class="app-card__body text-column">
              <div class="app-card__title">
                <Image
                  class="app-card__icon"
                  src={app.icon}
                  alt=""
                  width={48}
                  height={48}
                  densities={[1, 2]}
                  loading="lazy"
                  style={`view-transition-name: app-${app.slug}`}
                />
                <div>
                  <h3>{app.name}</h3>
                  <p class="app-card__category">{category}</p>
                </div>
              </div>
              <p class="app-card__desc text-justify">{description}</p>
              <p class="app-card__meta">
                <span>
                  {platformGroupsOf(app.platforms)
                    .map((group) => group.label)
                    .join(' · ')}
                </span>
                <span class="app-card__distribution">
                  <span aria-hidden="true"> — </span>
                  {app.links.source
                    ? t(lang, 'home.apps.openSource')
                    : storesOf(app.links.stores)
                        .map((store) => store.name)
                        .join(', ')}
                </span>
              </p>
            </div>
          </a>
        </li>
      );
    })}
  </ul>

  <div class="empty-state" hidden data-app-empty>
    <p>{t(lang, 'home.apps.empty')}</p>
    <button class="button button--secondary" type="button" data-app-clear>
      {t(lang, 'home.apps.clear')}
    </button>
  </div>
</section>

<script>
  import { initAppDirectory } from '../../scripts/app-directory';
  initAppDirectory();
</script>

<style>
  .apps > .section-head {
    align-items: start;
    flex-direction: column;
    gap: clamp(16px, 3vw, 28px);
  }

  .apps__tools {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 16rem);
    align-items: center;
    gap: 12px;
    width: 100%;
    padding-block: clamp(12px, 2vw, 20px);
    border-block: 1px solid var(--line);
  }

  .apps__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
    min-height: 44px;
  }

  .apps__count {
    color: var(--muted);
    font-size: 14px;
  }

  .apps__reset {
    min-height: 44px;
    background: transparent;
    border: 0;
  }

  /* Space is kept while the script loads, so revealing the tools never moves the list. */
  .apps__tools[data-pending] {
    visibility: hidden;
  }

  .segmented {
    width: fit-content;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .segmented::-webkit-scrollbar {
    display: none;
  }

  .segmented button {
    flex: 1 0 auto;
    min-height: 44px;
    padding-inline: clamp(12px, 2vw, 16px);
  }

  /* Fade only the edge with additional options. Keep the rest of the label legible. */
  .segmented[data-more]::after {
    display: none;
  }

  .segmented[data-more='end'] {
    mask-image: linear-gradient(90deg, #000 calc(100% - 18px), transparent);
  }

  .segmented[data-more='start'] {
    mask-image: linear-gradient(90deg, transparent, #000 18px);
  }

  .segmented[data-more='both'] {
    mask-image: linear-gradient(90deg, transparent, #000 18px, #000 calc(100% - 18px), transparent);
  }

  /* With JS, one thumb slides between options instead of each button lighting up. */
  /* The thumb is a brighter glass capsule, inset 4px so it is concentric with the track. */
  .segmented.has-thumb::before {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: var(--thumb-w, 0);
    border-radius: var(--r-pill);
    background: var(--glass-thumb);
    box-shadow:
      inset 0 1px 0 var(--glass-rim),
      0 1px 2px rgb(16 24 40 / 0.08),
      0 4px 12px -4px rgb(16 24 40 / 0.18);
    content: '';
    transform: translateX(var(--thumb-x, 0));
  }

  .segmented.has-thumb.is-ready::before {
    transition:
      transform 480ms var(--spring),
      width 480ms var(--spring);
  }

  .segmented.has-thumb button {
    position: relative;
    transition: color 200ms ease;
  }

  .segmented.has-thumb button[aria-pressed='true'] {
    background: transparent;
    box-shadow: none;
  }

  .search-field {
    display: flex;
    min-width: 0;
    min-height: 48px;
    align-items: center;
    gap: 10px;
    padding: 0 18px;
    border-radius: var(--r-pill);
    color: var(--muted);
  }

  .search-field:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .search-field input {
    width: 100%;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-size: 16px; /* Prevents iOS focus zoom. */
    outline: none;
  }

  /* Three cards a row on wide screens, two below. Each shows the store's search art. */
  .app-list {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 20px;
  }

  .app-list li {
    grid-column: span 2;
    min-width: 0;
  }

  .app-list li[data-half] {
    grid-column: span 3;
  }

  .app-list li[data-wide] {
    grid-column: 1 / -1;
  }

  .app-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--glass-edge);
    border-radius: var(--r-card);
    transition: border-color 150ms ease-out;
  }

  .app-card:hover {
    border-color: var(--line-strong);
  }

  .app-card__art {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: color-mix(in srgb, var(--app) 18%, var(--surface-2));
  }

  .app-card__art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 200ms ease-out;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .app-card:hover .app-card__art :global(img) {
      transform: scale(1.02);
    }
  }

  .app-card__body {
    display: grid;
    align-content: start;
    gap: 10px;
    flex: 1;
    min-width: 0;
    padding: 16px 18px 18px;
  }

  .app-card__title {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .app-card__title > div {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .app-card :global(.app-card__icon) {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: var(--r-icon);
    box-shadow: var(--shadow-icon);
  }

  h3 {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .app-card__category {
    margin-top: 2px;
    color: var(--muted);
    font-size: 14px;
  }

  .app-card__desc {
    display: -webkit-box;
    overflow: hidden;
    color: color-mix(in srgb, var(--ink) 80%, var(--muted));
    font-size: 15px;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .app-card__meta {
    color: var(--muted);
    font-size: 13px;
  }

  /* A card alone on the last row lies down: art beside the text. */
  @media (min-width: 1100px) {
    li[data-wide] .app-card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    li[data-wide] .app-card__art {
      height: 100%;
    }

    li[data-wide] .app-card__body {
      align-content: center;
      padding: 24px 28px;
    }

    li[data-wide] .app-card__desc {
      -webkit-line-clamp: 5;
    }
  }

  .empty-state {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding: 40px 0;
    color: var(--muted);
  }

  /* Filtering animates as a same-document view transition (see scripts/app-directory.ts):
     rows that stay glide to their new place, others fade. */
  :global(::view-transition-group(.app-row-vt)) {
    animation-duration: 300ms;
    animation-timing-function: ease-out;
  }

  @media (max-width: 1099.98px) {
    .app-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .app-list li,
    .app-list li[data-half],
    .app-list li[data-wide] {
      grid-column: auto;
    }

    .app-list li[data-odd] {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 768px) and (max-width: 1099.98px) {
    li[data-odd] .app-card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    li[data-odd] .app-card__body {
      align-content: center;
      padding: 24px;
    }
  }

  /* Phones: two compact cards a row, so most of the collection fits on one screen. */
  @media (max-width: 767.98px) {
    .apps__tools {
      grid-template-columns: minmax(0, 1fr);
    }

    .segmented {
      width: 100%;
    }

    .app-list {
      gap: 12px;
    }

    .app-card__body {
      gap: 6px;
      padding: 10px 12px 12px;
    }

    .app-card__title {
      gap: 8px;
    }

    .app-card :global(.app-card__icon) {
      width: 32px;
      height: 32px;
    }

    h3 {
      font-size: 16px;
    }

    .app-card__category {
      font-size: 13px;
      line-height: 1.35;
    }

    .app-card__desc,
    .app-card__distribution {
      display: none;
    }

    .app-card__meta {
      font-size: 12px;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    li[data-odd] .app-card {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: center;
    }

    li[data-odd] .app-card__desc {
      display: -webkit-box;
      font-size: 14px;
      -webkit-line-clamp: 2;
    }
  }

  @media (max-width: 359.98px) {
    .app-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .app-card {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: center;
    }

    li[data-odd] .app-card__desc {
      display: none;
    }
  }
</style>
