---
import { Image } from 'astro:assets';
import { ChevronRight, Search } from '@lucide/astro';
import type { Lang } from '../../data/types';
import { apps } from '../../data/apps';
import { t } from '../../lib/i18n';
import { appPath } from '../../lib/routes';
import { PLATFORM_GROUPS, platformGroupsOf, storesOf } from '../../data/platforms';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// Only platforms that at least one app supports get a filter button.
const groups = PLATFORM_GROUPS.filter((group) =>
  apps.some((app) => platformGroupsOf(app.platforms).includes(group)),
);
---

<section class="apps container section" id="apps" aria-labelledby="apps-heading" data-app-directory>
  <div class="section-head">
    <div>
      <h2 id="apps-heading">{t(lang, 'home.apps.title')}</h2>
      <p>{t(lang, 'home.apps.lead')}</p>
    </div>
    <div class="apps__tools">
      <div class="segmented" role="group" aria-label={t(lang, 'home.apps.filter')}>
        <button type="button" aria-pressed="true" data-platform="">
          {t(lang, 'home.apps.all')}
        </button>
        {groups.map((group) => (
          <button type="button" aria-pressed="false" data-platform={group.id}>
            {group.label}
          </button>
        ))}
      </div>
      <label class="search-field">
        <Search size={17} aria-hidden="true" />
        <span class="sr-only">{t(lang, 'home.apps.search')}</span>
        <input
          type="search"
          placeholder={t(lang, 'home.apps.search')}
          autocomplete="off"
          data-app-search
        />
      </label>
    </div>
  </div>

  <p
    class="sr-only"
    role="status"
    data-app-count
    data-one={t(lang, 'home.apps.count.one')}
    data-other={t(lang, 'home.apps.count.other')}
  >
    {apps.length} {t(lang, 'home.apps.count.other')}
  </p>

  <ul class="app-list" role="list" data-reveal-stagger>
    {apps.map((app) => (
      <li
        data-app
        data-platforms={platformGroupsOf(app.platforms)
          .map((group) => group.id)
          .join(' ')}
        data-search={`${app.name} ${app.category[lang]} ${app.description[lang]}`.toLowerCase()}
      >
        <a class="app-row" href={appPath(app, lang)}>
          <Image
            class="app-row__icon"
            src={app.icon}
            alt=""
            width={72}
            height={72}
            densities={[1, 2]}
            loading="lazy"
            style={`view-transition-name: app-${app.slug}`}
          />
          <div class="app-row__copy">
            <div class="app-row__title">
              <h3>{app.name}</h3>
              <span class="app-row__badge">
                {app.links.source
                  ? t(lang, 'home.apps.openSource')
                  : storesOf(app.links.stores)
                      .map((store) => store.name)
                      .join(' · ')}
              </span>
            </div>
            <span class="app-row__category">{app.category[lang]}</span>
            <span class="app-row__desc">{app.description[lang]}</span>
            <span class="app-row__platforms">
              {platformGroupsOf(app.platforms)
                .map((group) => group.label)
                .join(' · ')}
            </span>
          </div>
          <ChevronRight class="app-row__chevron" size={20} aria-hidden="true" />
        </a>
      </li>
    ))}
  </ul>

  <div class="empty-state" hidden data-app-empty>
    <p>{t(lang, 'home.apps.empty')}</p>
    <button class="button button--secondary" type="button" data-app-clear>
      {t(lang, 'home.apps.clear')}
    </button>
  </div>
</section>

<script>
  import { initAppDirectory } from '../../scripts/app-directory';
  initAppDirectory();
</script>

<style>
  .apps__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .segmented {
    position: relative;
    display: inline-flex;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: var(--r-control);
    background: var(--surface);
  }

  .segmented button {
    min-height: 36px;
    padding: 0 14px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    font-size: 14px;
  }

  .segmented button:hover {
    color: var(--ink);
  }

  .segmented button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
  }

  /* With JS, one thumb slides between options instead of each button lighting up. */
  .segmented.has-thumb::before {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: var(--thumb-w, 0);
    border-radius: 8px;
    background: var(--ink);
    content: '';
    transform: translateX(var(--thumb-x, 0));
  }

  .segmented.has-thumb.is-ready::before {
    transition:
      transform 480ms var(--spring),
      width 480ms var(--spring);
  }

  .segmented.has-thumb button {
    position: relative;
    transition: color 200ms ease;
  }

  .segmented.has-thumb button[aria-pressed='true'] {
    background: transparent;
  }

  .search-field {
    display: flex;
    min-height: 46px;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-control);
    background: var(--surface);
    color: var(--muted);
  }

  .search-field:focus-within {
    border-color: var(--focus);
    outline: 2px solid color-mix(in srgb, var(--focus) 25%, transparent);
  }

  .search-field input {
    width: 180px;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-size: 15px;
    outline: none;
  }

  .app-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 32px;
    border-top: 1px solid var(--line);
  }

  .app-list li {
    border-bottom: 1px solid var(--line);
  }

  .app-row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) 20px;
    align-items: start;
    gap: 20px;
    margin-inline: -16px;
    padding: 24px 16px;
    border-radius: var(--r-card);
    transition: background-color 160ms ease;
  }

  .app-row:hover {
    background: var(--surface);
  }

  .app-row:active {
    background: var(--surface-2);
  }

  .app-row__icon {
    width: 72px;
    height: 72px;
    border-radius: var(--r-icon);
    box-shadow: var(--shadow-icon);
    transition: transform 420ms var(--spring);
  }

  .app-row:hover .app-row__icon {
    transform: translateY(-3px) scale(1.05) rotate(-2deg);
  }

  .app-row__copy {
    display: grid;
    gap: 4px;
  }

  .app-row__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
  }

  h3 {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .app-row__badge {
    padding: 2px 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .app-row__category {
    font-size: 15px;
    font-weight: 600;
  }

  .app-row__desc {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }

  .app-row__platforms {
    margin-top: 6px;
    color: var(--muted);
    font-size: 13px;
  }

  .app-row :global(.app-row__chevron) {
    align-self: center;
    color: var(--line-strong);
    transition:
      color 160ms ease,
      transform 160ms var(--ease);
  }

  .app-row:hover :global(.app-row__chevron) {
    color: var(--ink);
    transform: translateX(3px);
  }

  .empty-state {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding: 40px 0;
    color: var(--muted);
  }

  /* Filtering animates as a same-document view transition (see scripts/app-directory.ts):
     rows that stay glide to their new place, others fade. */
  :global(::view-transition-group(.app-row-vt)) {
    animation-duration: 420ms;
    animation-timing-function: var(--ease);
  }

  @media (max-width: 900px) {
    .app-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .apps__tools,
    .search-field {
      width: 100%;
    }

    .segmented {
      width: 100%;
      overflow-x: auto;
    }

    .segmented button {
      flex: 1 0 auto;
    }

    .search-field input {
      width: 100%;
      font-size: 16px; /* prevents iOS focus zoom */
    }

    .app-row {
      grid-template-columns: 56px minmax(0, 1fr);
      gap: 16px;
      margin-inline: 0;
      padding: 20px 0;
    }

    .app-row__icon {
      width: 56px;
      height: 56px;
    }

    .app-row :global(.app-row__chevron) {
      display: none;
    }
  }
</style>
