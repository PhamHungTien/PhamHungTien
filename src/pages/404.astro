---
/**
 * GitHub Pages serves this file for every unknown path. Before showing the error it
 * fixes the common mistakes that used to break links: wrong letter case (/vtts/),
 * missing trailing slash, legacy /products/ prefix and privacy/terms without .html.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { apps, appSegment } from '../data/apps';
import { t } from '../lib/i18n';
import { appPath, homeAlternates, homePath, legalPath } from '../lib/routes';
import { LOCALES } from '../i18n/locales';
import { ogImage } from '../lib/seo';

const lang = 'en';
const localizedError = Object.fromEntries(
  LOCALES.map((locale) => [
    locale,
    {
      home: homePath(locale),
      title: t(locale, 'notFound.title'),
      body: t(locale, 'notFound.body'),
      returnHome: t(locale, 'notFound.home'),
      redirecting: t(locale, 'notFound.redirecting'),
    },
  ]),
);
const legacyAppPaths = Object.fromEntries(
  apps.map((app) => [
    appSegment(app).toLowerCase(),
    Object.fromEntries(
      (['default', ...LOCALES] as const).map((language) => {
        const locale = language === 'default' ? undefined : language;
        return [
          language,
          {
            landing: appPath(app, locale),
            privacy: legalPath(app, 'privacy', locale),
            terms: legalPath(app, 'terms', locale),
          },
        ];
      }),
    ),
  ]),
);
legacyAppPaths.aipadnotes = legacyAppPaths.padnotesai;
---

<BaseLayout
  lang={lang}
  title={`${t(lang, 'meta.notFound.title')} — Phạm Hùng Tiến`}
  description={t(lang, 'notFound.body')}
  path="/404.html"
  ogImage={ogImage('home')}
  nav={[{ href: '/#apps', label: t(lang, 'nav.apps') }]}
  languageLinks={homeAlternates}
  noindex
  compactFooter
>
  <section class="not-found container">
    <p class="not-found__code" aria-hidden="true">
      404
    </p>
    <h1>{t(lang, 'notFound.title')}</h1>
    <p class="not-found__redirect">{t(lang, 'notFound.redirecting')}</p>
    <p class="not-found__body">{t(lang, 'notFound.body')}</p>
    <a class="button button--primary" href="/">
      {t(lang, 'notFound.home')}
    </a>
    <ul role="list">
      {apps.map((app) => (
        <li>
          <a href={appPath(app, lang)} data-app={appSegment(app).toLowerCase()}>
            <Image src={app.icon} alt="" width={40} height={40} densities={[1, 2]} />
            {app.name}
          </a>
        </li>
      ))}
    </ul>
  </section>
  <script
    is:inline
    data-app-paths={JSON.stringify(legacyAppPaths)}
    data-errors={JSON.stringify(localizedError)}
  >
    (() => {
      const apps = JSON.parse(document.currentScript?.dataset.appPaths ?? '{}');
      const { pathname, search, hash } = location;
      const parts = pathname.split('/').filter(Boolean);
      let language = 'default';
      const prefix = parts[0]?.toLowerCase();
      const errors = JSON.parse(document.currentScript?.dataset.errors ?? '{}');
      if (prefix === 'fr' || Object.hasOwn(errors, prefix)) parts.shift();
      if (Object.hasOwn(errors, prefix)) {
        language = prefix;
        const copy = errors[prefix];
        const section = document.querySelector('.not-found');
        section.lang = prefix;
        section.querySelector('h1').textContent = copy.title;
        section.querySelector('.not-found__body').textContent = copy.body;
        section.querySelector('.not-found__redirect').textContent = copy.redirecting;
        const home = section.querySelector('.button');
        home.textContent = copy.returnHome;
        home.href = copy.home;
        for (const link of section.querySelectorAll('[data-app]')) {
          link.href = apps[link.dataset.app][language].landing;
        }
      }
      if (parts[0]?.toLowerCase() === 'products') parts.shift();
      const slug = parts[0]?.toLowerCase();
      if (!slug || !Object.hasOwn(apps, slug) || parts.length > 2) return;
      const page = parts[1]?.toLowerCase().replace(/\.html$/, '') ?? 'landing';
      if (
        !['landing', 'privacy', 'terms'].includes(page) ||
        (parts.length === 2 && page === 'landing')
      )
        return;
      const target = apps[slug][language][page];
      if (target !== pathname) {
        document.documentElement.dataset.redirecting = '';
        location.replace(target + search + hash);
      }
    })();
  </script>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    gap: 16px;
    max-width: 760px;
    padding-top: clamp(48px, 9vw, 120px);
  }

  .not-found__code {
    color: var(--brand);
    font-size: 15px;
    font-weight: 600;
  }

  h1 {
    font-size: clamp(36px, 6vw, 64px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .not-found__body {
    max-width: 36em;
    color: var(--muted);
    font-size: 18px;
  }

  .not-found__redirect {
    display: none;
    color: var(--muted);
  }

  :global(html[data-redirecting]) .not-found__redirect {
    display: block;
  }

  :global(html[data-redirecting]) .not-found__body,
  :global(html[data-redirecting]) .not-found ul,
  :global(html[data-redirecting]) .not-found .button {
    display: none;
  }

  ul {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 10px;
    margin-top: 24px;
  }

  ul a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
    background: var(--surface);
    font-weight: 600;
  }

  ul a:hover {
    border-color: var(--line-strong);
  }

  ul :global(img) {
    width: 40px;
    height: 40px;
    border-radius: var(--r-icon);
  }
</style>
