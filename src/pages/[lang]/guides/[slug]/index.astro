---
import GuidePage from '../../../../components/guides/GuidePage.astro';
import { getGuides, guideLang, guideSlug, type Guide } from '../../../../lib/guides';

export async function getStaticPaths() {
  const guides = (await Promise.all([getGuides('ja'), getGuides('es')])).flat();
  return guides.map((guide) => ({
    params: { lang: guideLang(guide), slug: guideSlug(guide) },
    props: { guide },
  }));
}

const { guide } = Astro.props as { guide: Guide };
---

<GuidePage guide={guide} />
