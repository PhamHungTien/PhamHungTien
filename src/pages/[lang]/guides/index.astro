---
import GuideIndex from '../../../components/guides/GuideIndex.astro';
import { PREFIXED_LOCALES } from '../../../i18n/locales';

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
---

<GuideIndex lang={lang} />
