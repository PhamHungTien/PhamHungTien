---
import type { GetStaticPaths } from 'astro';
import AppPage from '../../../components/app/AppPage.astro';
import LegacyRedirect from '../../../components/site/LegacyRedirect.astro';
import { apps, appSegment, defaultLangOf } from '../../../data/apps';
import { LOCALES } from '../../../i18n/locales';

export const getStaticPaths = (() =>
  apps.flatMap((app) =>
    LOCALES.map((lang) => ({ params: { lang, app: appSegment(app) }, props: { app, lang } })),
  )) satisfies GetStaticPaths;

const { app, lang } = Astro.props;
---

{lang === defaultLangOf(app) ? (
  <LegacyRedirect to={app.route} />
) : (
  <AppPage app={app} lang={lang} />
)}
