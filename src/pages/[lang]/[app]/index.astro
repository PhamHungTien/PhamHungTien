---
import type { GetStaticPaths } from 'astro';
import LegacyRedirect from '../../../components/site/LegacyRedirect.astro';
import { apps, appSegment, defaultLangOf } from '../../../data/apps';
import { otherLang } from '../../../lib/i18n';

/** Each app in its second language, under a language prefix (e.g. /vi/vTTS/, /en/PHTV/). */
export const getStaticPaths = (() =>
  apps.map((app) => {
    const lang = otherLang(defaultLangOf(app));
    return { params: { lang, app: appSegment(app) }, props: { app, lang } };
  })) satisfies GetStaticPaths;

const { app } = Astro.props;
---

<LegacyRedirect to={app.route} />
