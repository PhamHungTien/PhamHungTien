---
import GuidePage from '../../../components/guides/GuidePage.astro';
import { getGuides, guideSlug, guideUrl, type Guide } from '../../../lib/guides';

export async function getStaticPaths() {
  const localized = await Promise.all([getGuides('en'), getGuides('vi')]);
  return localized
    .flat()
    .filter((guide) => guideUrl(guide).startsWith('/guides/'))
    .map((guide) => ({ params: { slug: guideSlug(guide) }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
---

<GuidePage guide={guide} />
