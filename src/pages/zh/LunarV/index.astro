---
import { Image } from 'astro:assets';
import { Mail } from '@lucide/astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Contact from '../../../components/layout/Contact.astro';
import Lightbox from '../../../components/ui/Lightbox.astro';
import AppHero from '../../../components/app/AppHero.astro';
import StoreGallery from '../../../components/app/StoreGallery.astro';
import AppBoard from '../../../components/community/AppBoard';
import { apps, appBySlug } from '../../../data/apps';
import { appAlternates, appPath } from '../../../lib/routes';
import { platformList } from '../../../data/platforms';
import { SITE } from '../../../data/site';
import { absolute, ogImage } from '../../../lib/seo';

const app = appBySlug.get('lunarv')!;
const features = [
  ['今日一览', '农历日期、日月年干支、节气、生肖与月相，以及每日评分和下一个吉时。'],
  [
    '择吉日',
    '在未来 30、60 或 90 天内为婚嫁、开业、入宅、出行挑选吉日，自动避开三娘日、月忌日与相冲日子。',
  ],
  ['公历农历月历', '公历与农历并排显示，标注节日与笔记；快速转换日期，中国农历支持 1901–2100 年。'],
  ['家庭纪念日', '按农历或公历保存生日、忌日等纪念日，可每年、每月或每周重复，并提前提醒。'],
  ['小组件与菜单栏', '主屏幕、锁定屏幕与桌面小组件；Mac 菜单栏显示农历；Siri 快捷指令与世界时钟。'],
  [
    '设备端计算与 iCloud 同步',
    '农历运算在设备上完成，无需 LunarV 账户。iCloud 可同步笔记和家庭纪念日。Premium 为一次性购买。',
  ],
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  description: '在 Apple 设备上查看农历、公历、节气和重要日子的提醒。',
  applicationCategory: app.appCategory,
  operatingSystem: platformList(app.platforms).join(', '),
  url: absolute('/zh/LunarV/'),
  inLanguage: 'zh-CN',
  image: ogImage('lunarv'),
  author: { '@id': `${SITE.origin}/#person` },
};
---

<BaseLayout
  lang="zh"
  title="LunarV — 农历与日期提醒 | Phạm Hùng Tiến"
  description="使用 LunarV 在 iPhone、iPad、Mac 和 Apple Vision Pro 上查看农历、公历、干支、节气及重要日子的提醒。"
  path="/zh/LunarV/"
  alternates={appAlternates(app)}
  ogImage={ogImage('lunarv')}
  jsonLd={jsonLd}
  accent={app.accent}
  nav={[
    { href: '#overview', label: '概览', tab: 'overview', current: true },
    { href: '#features', label: '功能' },
    { href: '#gallery', label: '屏幕截图' },
    { href: '#community', label: '讨论', tab: 'community' },
    { href: '/#apps', label: '所有应用' },
  ]}
>
  <div id="overview" data-tab-panel="overview">
    <AppHero
      app={app}
      lang="zh"
      copy={{
        title: '清晰准确的农历日历。',
        subtitle:
          '查看农历与吉时、挑选吉日，记住家人的重要日子。支持 iPhone、iPad、Mac 与 Apple Vision Pro。',
        category: '农历与日历',
        storeCta: '在 App Store 下载',
        privacy: '/zh/LunarV/privacy.html',
      }}
    />
    <StoreGallery app={app} lang="zh" />
    <section id="features" class="container section" aria-labelledby="zh-features">
      <div class="section-head">
        <div>
          <span class="section-kicker">为日常生活设计</span>
          <h2 id="zh-features">功能</h2>
        </div>
      </div>
      <ul class="zh-feature-grid" role="list">
        {features.map(([title, description]) => (
          <li>
            <h3>{title}</h3>
            <p>{description}</p>
          </li>
        ))}
      </ul>
      <p class="zh-support">
        <Mail size={18} />
        需要帮助？<a href={`mailto:${SITE.email}?subject=LunarV`}>发送邮件</a> ·{' '}
        <a href="/zh/LunarV/privacy.html">隐私政策</a> ·{' '}
        <a href="/zh/LunarV/terms.html">使用条款</a>
      </p>
    </section>
    <section class="container section">
      <div class="section-head">
        <div>
          <span class="section-kicker">了解更多</span>
          <h2>农历指南</h2>
          <p>以下文章以英语撰写。</p>
        </div>
      </div>
      <a class="text-link" href="/guides/am-lich-viet-nam-cach-tinh-can-chi-tiet-khi/" lang="en">
        The Vietnamese lunar calendar: leap months, zodiac cycles and solar terms →
      </a>
    </section>
  </div>
  <div class="container section" id="community" data-tab-panel="community" hidden>
    <AppBoard client:visible app="lunarv" name="LunarV" lang="zh" />
  </div>
  <section class="container section" aria-labelledby="zh-more">
    <div class="section-head">
      <h2 id="zh-more">更多应用</h2>
      <a class="text-link" href="/#apps">
        所有应用
      </a>
    </div>
    <ul class="zh-more" role="list">
      {apps
        .filter((other) => other.slug !== 'lunarv')
        .map((other) => (
          <li>
            <a href={appPath(other, 'en')}>
              <Image src={other.icon} width={48} height={48} alt="" loading="lazy" />
              <strong>{other.name}</strong>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
    </ul>
  </section>
  <Contact lang="zh" />
  <Lightbox lang="zh" />
</BaseLayout>
<script>
  import { initAppTabs } from '../../../scripts/app-tabs';
  initAppTabs();
</script>
<style>
  .zh-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .zh-feature-grid li {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
  }
  .zh-feature-grid h3 {
    font-size: 19px;
  }
  .zh-feature-grid p {
    color: var(--muted);
    margin-top: 10px;
  }
  .zh-support {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    color: var(--muted);
  }
  .zh-support a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .zh-more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 12px;
  }
  .zh-more a {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 72px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
  }
  .zh-more img {
    width: 48px;
    height: 48px;
    border-radius: var(--r-icon);
  }
  .zh-more span {
    margin-left: auto;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .zh-feature-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .zh-feature-grid li {
      padding: 20px;
    }
  }
</style>
