---
import { Image, Picture, getImage } from 'astro:assets';
import { Download, Mail, ChevronRight } from '@lucide/astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Contact from '../../../components/layout/Contact.astro';
import Lightbox from '../../../components/ui/Lightbox.astro';
import Gallery from '../../../components/app/Gallery.astro';
import AppBoard from '../../../components/community/AppBoard';
import { apps, appBySlug } from '../../../data/apps';
import { appPath } from '../../../lib/routes';
import { platformList } from '../../../data/platforms';
import { SITE } from '../../../data/site';
import { absolute, ogImage } from '../../../lib/seo';

const app = appBySlug.get('lunarv')!;
const hero = await getImage({
  src: app.heroImage,
  width: Math.min(app.heroImage.width, 2000),
  format: 'webp',
});
const features = [
  ['农历与公历', '查看农历、公历、干支和节气，快速转换日期。'],
  ['家庭纪念日', '按农历或公历记录忌日、生日和重要日子。'],
  ['桌面小组件', '在主屏幕上查看日期信息，并在 Apple 设备上同步。'],
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  description: '在 Apple 设备上查看农历、公历、节气和重要日子的提醒。',
  applicationCategory: app.appCategory,
  operatingSystem: platformList(app.platforms).join(', '),
  url: absolute('/zh/LunarV/'),
  inLanguage: 'zh-CN',
  image: ogImage('lunarv'),
  author: { '@id': `${SITE.origin}/#person` },
};
---

<BaseLayout
  lang="zh"
  title="LunarV — 农历与日期提醒 | Phạm Hùng Tiến"
  description="使用 LunarV 在 iPhone、iPad、Mac 和 Apple Vision Pro 上查看农历、公历、干支、节气及重要日子的提醒。"
  path="/zh/LunarV/"
  alternates={[
    { lang: 'vi', path: '/LunarV/' },
    { lang: 'en', path: '/en/LunarV/' },
    { lang: 'zh', path: '/zh/LunarV/' },
  ]}
  ogImage={ogImage('lunarv')}
  jsonLd={jsonLd}
  accent={app.accent}
  nav={[
    { href: '#overview', label: '概览', tab: 'overview', current: true },
    { href: '#features', label: '功能' },
    { href: '#gallery', label: '屏幕截图' },
    { href: '#community', label: '讨论', tab: 'community' },
    { href: '/#apps', label: '所有应用' },
  ]}
>
  <div id="overview" data-tab-panel="overview">
    <section class="zh-hero container" aria-labelledby="app-title">
      <div>
        <nav class="zh-breadcrumb" aria-label="面包屑导航">
          <a href="/">首页</a>
          <ChevronRight size={14} />
          <a href="/#apps">应用</a>
          <ChevronRight size={14} />
          <span>LunarV</span>
        </nav>
        <nav class="zh-languages" aria-label="页面语言">
          <a href="/LunarV/" hreflang="vi">
            Tiếng Việt
          </a>
          <a href="/en/LunarV/" hreflang="en">
            English
          </a>
          <a href="/zh/LunarV/" hreflang="zh" aria-current="page">
            简体中文
          </a>
        </nav>
        <div class="zh-lockup">
          <Image src={app.icon} width={64} height={64} alt="" />
          <div>
            <strong>LunarV</strong>
            <p>农历与日历</p>
          </div>
        </div>
        <p class="zh-platforms">iOS & iPadOS · macOS · visionOS</p>
        <h1 id="app-title">在 Apple 设备上查看农历。</h1>
        <p class="zh-lead">
          农历日期、家庭纪念日、小组件和提醒，清晰呈现在 iPhone、iPad、Mac 和 Apple Vision Pro 上。
        </p>
        <div class="zh-actions">
          <a
            class="button button--primary"
            href={app.links.stores!.appStore}
            target="_blank"
            rel="noopener"
          >
            <Download size={18} />在 App Store 下载
          </a>
          <a class="button button--secondary" href="/zh/LunarV/privacy.html">
            隐私政策
          </a>
          <button class="link-button" type="button" data-donate aria-haspopup="dialog">
            支持
          </button>
        </div>
      </div>
      <button
        class="zh-media"
        type="button"
        data-lightbox-src={hero.src}
        data-lightbox-alt="LunarV iPad 界面"
        aria-label="放大 LunarV iPad 界面"
      >
        <Picture
          src={app.heroImage}
          alt="LunarV iPad 界面"
          formats={['avif', 'webp']}
          widths={[480, 800, 1200].filter((w) => w <= app.heroImage.width)}
          sizes="(max-width: 960px) 92vw, 620px"
          loading="eager"
        />
      </button>
    </section>
    <section id="features" class="container section" aria-labelledby="zh-features">
      <div class="section-head">
        <div>
          <span class="section-kicker">为日常生活设计</span>
          <h2 id="zh-features">功能</h2>
        </div>
      </div>
      <ul class="zh-feature-grid" role="list" data-reveal-stagger>
        {features.map(([title, description]) => (
          <li>
            <h3>{title}</h3>
            <p>{description}</p>
          </li>
        ))}
      </ul>
      <p class="zh-support">
        <Mail size={18} />
        需要帮助？<a href={`mailto:${SITE.email}?subject=LunarV`}>发送邮件</a> ·{' '}
        <a href="/zh/LunarV/privacy.html">隐私政策</a> ·{' '}
        <a href="/zh/LunarV/terms.html">使用条款</a>
      </p>
    </section>
    <Gallery app={app} lang="zh" />
    <section class="container section">
      <div class="section-head">
        <div>
          <span class="section-kicker">了解更多</span>
          <h2>农历指南</h2>
          <p>以下文章以英语撰写。</p>
        </div>
      </div>
      <a class="text-link" href="/guides/am-lich-viet-nam-cach-tinh-can-chi-tiet-khi/" lang="en">
        The Vietnamese lunar calendar: leap months, zodiac cycles and solar terms →
      </a>
    </section>
  </div>
  <div class="container section" id="community" data-tab-panel="community" hidden>
    <AppBoard client:visible app="lunarv" name="LunarV" lang="zh" />
  </div>
  <section class="container section" aria-labelledby="zh-more">
    <div class="section-head">
      <h2 id="zh-more">更多应用</h2>
      <a class="text-link" href="/#apps">
        所有应用
      </a>
    </div>
    <ul class="zh-more" role="list">
      {apps
        .filter((other) => other.slug !== 'lunarv')
        .map((other) => (
          <li>
            <a href={appPath(other, 'en')}>
              <Image src={other.icon} width={48} height={48} alt="" loading="lazy" />
              <strong>{other.name}</strong>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
    </ul>
  </section>
  <Contact lang="zh" />
  <Lightbox lang="zh" />
</BaseLayout>
<script>
  import { initAppTabs } from '../../../scripts/app-tabs';
  initAppTabs();
</script>
<style>
  .zh-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
    padding-top: clamp(32px, 5vw, 72px);
  }
  .zh-breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 24px;
  }
  .zh-languages {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 22px;
  }
  .zh-languages a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
  }
  .zh-languages a[aria-current='page'] {
    background: var(--surface-2);
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .zh-lockup {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .zh-lockup img {
    width: 64px;
    height: 64px;
    border-radius: var(--r-icon);
    box-shadow: var(--shadow-icon);
  }
  .zh-lockup strong {
    font-size: 18px;
  }
  .zh-lockup p {
    color: var(--muted);
  }
  .zh-platforms {
    color: var(--muted);
    font-size: 13px;
    margin-top: 24px;
  }
  h1 {
    font-size: clamp(34px, 4.4vw, 56px);
    line-height: 1.2;
    margin-top: 20px;
  }
  .zh-lead {
    color: var(--muted);
    font-size: 18px;
    margin-top: 18px;
  }
  .zh-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: 32px;
  }
  .zh-media {
    display: grid;
    place-items: center;
    width: 100%;
    padding: clamp(12px, 2vw, 22px);
    border: 1px solid var(--line);
    border-radius: var(--r-media);
    background: var(--surface-2);
    cursor: zoom-in;
    box-shadow: var(--shadow-media);
  }
  .zh-media :global(img) {
    width: 100%;
    height: auto;
    max-height: 66vh;
    object-fit: contain;
    border-radius: 16px;
  }
  .zh-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .zh-feature-grid li {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
  }
  .zh-feature-grid h3 {
    font-size: 19px;
  }
  .zh-feature-grid p {
    color: var(--muted);
    margin-top: 10px;
  }
  .zh-support {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    color: var(--muted);
  }
  .zh-support a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .zh-more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 12px;
  }
  .zh-more a {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 72px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
  }
  .zh-more img {
    width: 48px;
    height: 48px;
    border-radius: var(--r-icon);
  }
  .zh-more span {
    margin-left: auto;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .zh-hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 720px) {
    .zh-feature-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .zh-actions .button {
      flex: 1 1 auto;
    }
  }
</style>
