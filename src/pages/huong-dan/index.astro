---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideList from '../../components/guides/GuideList.astro';
import { getGuides, GUIDES_PATH, guidePath } from '../../lib/guides';
import { homePath } from '../../lib/routes';
import { absolute, ogImage, PERSON_ID, WEBSITE_ID } from '../../lib/seo';

const guides = await getGuides();
const description =
  'Hướng dẫn gõ tiếng Việt trên Mac, bảng gõ Telex và VNI, sửa lỗi bộ gõ, bảng mã tiếng Việt và cách dùng PHTV, vTTS từng bước.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${absolute(GUIDES_PATH)}#page`,
  url: absolute(GUIDES_PATH),
  name: 'Hướng dẫn',
  description,
  inLanguage: 'vi',
  isPartOf: { '@id': WEBSITE_ID },
  author: { '@id': PERSON_ID },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: guides.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absolute(guidePath(g.id)),
      name: g.data.title,
    })),
  },
};
---

<BaseLayout
  lang="vi"
  title="Hướng dẫn gõ tiếng Việt trên Mac và dùng ứng dụng | Phạm Hùng Tiến"
  description={description}
  path={GUIDES_PATH}
  ogImage={ogImage('guides')}
  jsonLd={jsonLd}
  ads
  nav={[
    { href: homePath('vi'), label: 'Trang chủ' },
    { href: GUIDES_PATH, label: 'Hướng dẫn', current: true },
    { href: `${homePath('vi')}#apps`, label: 'Ứng dụng' },
  ]}
>
  <GuideList
    guides={guides}
    title="Hướng dẫn"
    lead="Hướng dẫn chi tiết, viết và kiểm tra trên ứng dụng thật: gõ tiếng Việt trên Mac, Telex và VNI, bảng mã, nghe sách bằng giọng Việt, âm lịch và quản lý NAS an toàn."
    headingLevel="h1"
    id="all"
  />
</BaseLayout>
