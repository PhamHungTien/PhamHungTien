---
import GuidePage from '../../../components/guides/GuidePage.astro';
import LegacyRedirect from '../../../components/site/LegacyRedirect.astro';
import { getGuides, guideSlug, guideUrl, type Guide } from '../../../lib/guides';

export async function getStaticPaths() {
  return (await getGuides('vi')).map((guide) => ({
    params: { slug: guideSlug(guide) },
    props: { guide },
  }));
}

const { guide } = Astro.props as { guide: Guide };
const path = guideUrl(guide);
---

{path.startsWith('/huong-dan/') ? <GuidePage guide={guide} /> : <LegacyRedirect to={path} />}
