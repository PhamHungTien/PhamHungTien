---
import LegacyRedirect from '../../../components/site/LegacyRedirect.astro';
import { getGuides, type Guide } from '../../../lib/guides';

export async function getStaticPaths() {
  return (await getGuides()).map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
---

<LegacyRedirect to={`/guides/${guide.id}/`} />
