{
  "name": "@phamhungtien/phtv-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr entry-server.tsx && node ../scripts/prerender-phtv.mjs && node ../scripts/security-html.mjs dist",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-phtv \"node firestore.rules.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^0.562.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
