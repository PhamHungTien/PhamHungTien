{
  "name": "phamhungtien-site",
  "version": "2.0.0",
  "private": true,
  "description": "Phạm Hùng Tiến — one Astro site for the portfolio, every app page and their legal documents",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "site": "./scripts/build-site.sh",
    "verify": "node scripts/verify.mjs",
    "verify:site": "./scripts/verify-site.sh",
    "verify:social": "node scripts/verify-social.mjs",
    "og": "node scripts/generate-og.mjs",
    "sync:appstore": "node scripts/sync-appstore.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-phtv \"node firebase/firestore.rules.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@lucide/astro": "^1.57.0",
    "astro": "^7.3.8",
    "firebase": "^12.19.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "keywords": [
    "portfolio",
    "phtv",
    "vietnamese-input",
    "macos",
    "react",
    "typescript",
    "astro"
  ],
  "author": "Pham Hung Tien",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/PhamHungTien/PhamHungTien"
  },
  "homepage": "https://phamhungtien.com",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.33.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3"
  }
}
